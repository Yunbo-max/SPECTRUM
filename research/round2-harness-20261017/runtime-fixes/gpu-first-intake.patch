+    def remote(self, torch, *, smoke=False, requirements=None,
+               csv='GPU-0, NVIDIA RTX 4090, 24000, 20000, 550.1\n'):
+        with patch.dict(sys.modules, {'torch': torch}), \
+                patch('signal.alarm'), patch('os.chdir'), \
