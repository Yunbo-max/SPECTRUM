+def _run(project, options, deadline, cleanup):
+    remaining = deadline - time.monotonic() - cleanup
+    if remaining <= 0:
+        raise ContractError('C/D verification deadline exhausted before scorer dispatch')
+    options = {**options, 'native_timeout_seconds': remaining}
+    with tempfile.TemporaryDirectory(prefix='research-cd-verifier-cache-') as cache:
+        env = {**os.environ, 'PYTHONPYCACHEPREFIX': cache, 'PYTHONDONTWRITEBYTECODE': '1'}
+        process = subprocess.Popen([sys.executable, '-I', '-B', '-X', 'pycache_prefix=' + cache,
+            '-c', _CHECK, str(Path(project['skill_root']) / 'scripts'),
+            json.dumps([project, options], allow_nan=False)], stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE, text=True, env=env, start_new_session=True)
+        try:
+            stdout, stderr = process.communicate(timeout=max(.001, deadline-time.monotonic()-cleanup))
+        except (subprocess.TimeoutExpired, KeyboardInterrupt):
+            if process.poll() is None:
+                try: process.send_signal(signal.SIGTERM)
+                except ProcessLookupError: pass
+            try:
+                process.communicate(timeout=max(.001, min(cleanup, deadline-time.monotonic())))
+            except subprocess.TimeoutExpired:
+                if process.poll() is None:
+                    try: os.killpg(process.pid, signal.SIGKILL)
+                    except ProcessLookupError: pass
+                process.communicate()
+            raise ContractError('C/D scorer interrupted; retained attempts require reconciliation')
+    if process.returncode != 0:
+        raise ContractError('canonical C/D scoring denied: ' + stderr[-3000:])
+    if len(stdout.encode('utf-8')) > MAX_METADATA_BYTES:
+        raise ContractError('C/D verification report exceeds bound')
+    return _object(stdout)
