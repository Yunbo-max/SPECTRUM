{"task_id": "Mbpp/876", "original_task_id": 876, "entry_point": "lcm", "prompt": "Write a python function to find lcm of two positive integers.\n\nImplement this Python function. Return only the complete implementation.\ndef lcm(x, y):\n    pass", "original_prompt": "Write a python function to find lcm of two positive integers.", "prompt_protocol": "mbpp-function-interface-v1", "interface_source": "reference-ast-signature-only", "reference": "def lcm(x, y):\r\n   if x > y:\r\n       z = x\r\n   else:\r\n       z = y\r\n   while(True):\r\n       if((z % x == 0) and (z % y == 0)):\r\n           lcm = z\r\n           break\r\n       z += 1\r\n   return lcm", "tests": "assert lcm(4,6) == 12\nassert lcm(15,17) == 255\nassert lcm(2,6) == 6", "source": "google-research-datasets/mbpp", "split": "validation", "original_split": "train", "dataset_config": "full", "revision": "4bb6404fdc6cacfda99d4ac4205087b89d32030c", "split_seed": 42, "dataset_fingerprint": null}
