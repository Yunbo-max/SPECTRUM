+class PhaseWaitingTests(flow_base.CDFlowTests):
+
+    def install(self):
+        self.config['sequence']['execution_mode'] = 'phase_autonomy'
+        self.prior['state'].update(stage='planner', planner_task_id='harness.planner.fixture')
+        self.prior['state'].update(reviewer_task_id=None, resume_refs=[], pause_ref=None)
+        with self.controller._transaction() as db:
+            db.execute('UPDATE research_programs SET contract=?,state=? WHERE project_id=?',
+                       (json.dumps(self.config), json.dumps(self.prior['state']), 'p'))
+        return self.program.status('p')
+
+    def test_repeated_same_rejection_parks_without_advancing_or_accepting(self):
+        prior = self.install()
+        first = seq._retry(self.program, prior, self.project, ContractError('unchanged interface'))
+        before = copy.deepcopy(first['program']['state'])
+        second = seq._retry(self.program, first['program'], self.project, ContractError('unchanged interface'))
+        self.assertEqual(second['status'], 'waiting_dependency')
+        after = second['program']['state']
+        self.assertEqual(after['stage'], 'phase_wait')
+        for key in ('sequence', 'consumed_runs', 'coverage_ref', 'accepted_decision_ref', 'round'):
+            self.assertEqual(after[key], before[key])
+        for _ in range(3):
+            outcome = self.program.tick('p', owner='fixture', dispatch=lambda *a: self.fail('must not dispatch'))
+            self.assertEqual(outcome['status'], 'waiting_dependency')
+        instruction = save_artifact(self.root, 'repair-resume.json', {'owner': 'repair installed'})
+        resumed = self.program.resume('p', instruction)
+        self.assertEqual(resumed['state']['stage'], 'decide')
+        self.assertEqual(resumed['state']['sequence'], before['sequence'])
+
+    def test_operational_checkpoint_waits_for_actual_dependency_change(self):
+        prior = self.install()
+        dependency = save_artifact(self.root, 'runtime-dependency.json', {'ready': False})
+        checkpoint = save_artifact(self.root, 'checkpoint.json', {'finding': 'prepare failed; science pending'})
+        response = {'kind': 'research-phase-checkpoint', 'schema_version': 1, 'goal_id': 'goal',
+                    'sequence': seq.binding(prior['state']), 'summary': 'Waiting for runtime repair',
+                    'checkpoint_ref': checkpoint, 'dependency_refs': [dependency]}
+        response_ref = save_artifact(self.root, 'checkpoint-response.json', response)
+        from research_autopilot import phase_wait
+        item = {'task_id': 'harness.planner.fixture', 'attempt': {'run_id': 'actual-fixture'},
+                'response_ref': response_ref}
+        before = copy.deepcopy(prior['state'])
+        result = phase_wait.accept(self.program, prior, self.project, response, item)
+        self.assertEqual(result['status'], 'waiting_dependency')
+        for _ in range(3):
+            result = self.program.tick('p', owner='fixture', dispatch=lambda *a: self.fail('must not dispatch'))
+            self.assertEqual(result['status'], 'waiting_dependency')
+        (self.root / dependency['path']).write_text('{"ready":true}\n')
+        result = self.program.tick('p', owner='fixture', dispatch=lambda *a: self.fail('wake is not dispatch'))
+        self.assertEqual(result['status'], 'phase_dependency_changed')
+        for key in ('sequence', 'consumed_runs', 'coverage_ref', 'accepted_decision_ref', 'round'):
+            self.assertEqual(result['program']['state'][key], before[key])
+        self.assertEqual(result['program']['state']['stage'], 'decide')
+
