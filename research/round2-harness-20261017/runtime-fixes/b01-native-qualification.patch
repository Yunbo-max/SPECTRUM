+"""B01 opt-in uses real pins and SQLite without launching an agent or native job."""
+import copy
+import json
+import tempfile
+import unittest
+from pathlib import Path
+
+from research_autopilot.artifacts import canonical_json, digest_tree
+from research_autopilot.controller import Controller
+from research_autopilot.models import ContractError
+from research_autopilot.program import ResearchProgram, save_artifact, read_json
+from research_autopilot import skill_sequence as sequence
+from test_controller import project, task
+
+
+class B01QualificationTests(unittest.TestCase):
+    def setUp(self):
+        tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(tmp.cleanup)
+        self.root = Path(tmp.name)
+        self.skill = Path(__file__).resolve().parents[2] / 'skills/research-autopilot'
+        self.controller = Controller(self.root / 'controller.sqlite')
+        self.controller.register_project(project(self.root, workflow_class='scientific_method',
+            adapters=['codex', 'native'], skill_root=str(self.skill), skill_digest=digest_tree(self.skill),
+            limits={'max_workers': 1, 'max_cost': 100, 'max_seconds': 1000}))
+        self.project = self.controller.get_project('p')
+        self.program = ResearchProgram(self.controller)
+        self.target = save_artifact(self.root, 'target.json', {
+            'host': 'authorized-gpu', 'root': '/project', 'skill_root': '/skill', 'python': '/python'})
+        self.instruction = save_artifact(self.root, 'user.json', {'instruction': 'Qualify the B01 evaluator on the authorized GPU.'})
+        marker = json.loads((self.skill / 'assets/harness-policy.json').read_text())
+        self.contract = {'schema_version': 2, 'project_id': 'p', 'goal_id': 'goal',
+            'sequence': {'mode': 'repeat', 'scopes': ['research']},
+            'native_target_ref': self.target,
+            'policy': {'edition': marker['edition'], 'version': marker['version'],
+                'source_revision': 'a' * 40, 'skill_digest': self.project['skill_digest']}}
+        catalog, catalog_ref = sequence._catalog(self.project)
+        index = next(i for i, item in enumerate(catalog['steps']) if item['id'] == 'B01')
+        self.step = catalog['steps'][index]
+        history = save_artifact(self.root, 'history.json', {'retained': True})
+        self.state = {'phase': 'active', 'stage': 'decide', 'goal_id': 'goal', 'round': 37,
+            'staged_tasks': [], 'execution_task_ids': [], 'coverage_ref': history,
+            'accepted_decision_ref': history, 'consumed_runs': ['retained-run'],
+            'sequence': {'catalog_sha256': catalog_ref['sha256'], 'cycle': 1, 'index': index,
+                'step_id': 'B01', 'attempt': 3, 'accepted': [history] * index,
+                'cycle_receipts': [], 'result_ref': None, 'inspect_task_ids': [],
+                'inspection_refs': [], 'repair_basis': []}}
+        self.authorization = {'kind': 'research-b01-qualification-authorization', 'schema_version': 1,
+            'project_id': 'p', 'goal_id': 'goal', 'step_id': 'B01', 'native_purpose': 'qualification',
+            'instruction_ref': self.instruction, 'native_target_ref': self.target,
+            'max_tasks': 2, 'max_task_seconds': 100}
+        self.auth_ref = save_artifact(self.root, 'qualification.json', self.authorization)
+        with self.controller._transaction() as db:
+            db.execute('INSERT INTO research_programs VALUES(?,?,?,?)',
+                ('p', canonical_json(self.contract), canonical_json(self.state), 7))
+            db.execute('INSERT INTO research_program_events VALUES(?,?,?,?,?)',
+                ('p', 7, 'retained', canonical_json(self.state), 1))
+
+    def adopt(self):
+        return self.program.authorize_b01_qualification('p', self.auth_ref, expected_revision=7)
+
+    def native(self, **parameters):
+        return task('qualify', action='native_harness', adapter='native', parameters={
+            'native_purpose': 'qualification', 'research_scope': 'diagnostic',
+            'qualification_authorization_ref': self.auth_ref, **parameters})
+
+    def test_adoption_retains_history_catalog_and_limits(self):
+        before_budget = self.controller.status('p')['budget']
+        adopted = self.adopt()
+        self.assertEqual(adopted['revision'], 8)
+        expected = copy.deepcopy(self.contract)
+        expected['sequence']['qualification_authorization_ref'] = self.auth_ref
+        self.assertEqual(adopted['contract'], expected)
+        state = copy.deepcopy(adopted['state'])
+        receipt = read_json(self.root, state.pop('qualification_adoption_ref'))
+        self.assertEqual(state, self.state)
+        self.assertEqual(receipt['previous_contract'], self.contract)
+        self.assertEqual(receipt['previous_state'], self.state)
+        self.assertEqual(self.controller.status('p')['budget'], before_budget)
+        with self.controller._connect() as db:
+            self.assertEqual([r['revision'] for r in db.execute('SELECT revision FROM research_program_events ORDER BY revision')], [7, 8])
+
+    def test_default_off_and_only_b01_gets_qualification(self):
+        self.assertNotIn('native_harness', sequence._allowed_actions(self.program, self.project, self.state, self.step, self.contract))
+        config = self.adopt()['contract']
+        self.assertIn('native_harness', sequence._allowed_actions(self.program, self.project, self.state, self.step, config))
+        self.assertNotIn('candidate_code', sequence._allowed_actions(self.program, self.project, self.state, self.step, config))
+        self.assertNotIn('experiment_design', sequence._allowed_actions(self.program, self.project, self.state, self.step, config))
+        other = {**self.step, 'id': 'S01'}
+        self.assertNotIn('native_harness', sequence._allowed_actions(self.program, self.project, self.state, other, config))
+
+    def test_adoption_rejects_stale_paused_and_inflight_programs(self):
+        with self.assertRaises(ContractError):
+            self.program.authorize_b01_qualification('p', self.auth_ref, expected_revision=6)
+        for change in ({'phase': 'paused'}, {'phase': 'blocked'}, {'stage': 'planner'},
+                       {'staged_tasks': [self.native()]}, {'execution_task_ids': ['unknown']}):
+            with self.subTest(change=change):
+                state = {**self.state, **change}
+                with self.controller._transaction() as db:
+                    db.execute('UPDATE research_programs SET state=?', (canonical_json(state),))
+                with self.assertRaises(ContractError):
+                    self.adopt()
+        with self.controller._transaction() as db:
+            db.execute('UPDATE research_programs SET state=?', (canonical_json(self.state),))
+        self.controller.register_task('p', task('pending', action='source_read', adapter='codex'))
+        for status in ('pending', 'running', 'reconcile_required', 'unknown'):
+            with self.subTest(status=status):
+                with self.controller._transaction() as db:
+                    db.execute('UPDATE tasks SET state=?', (status,))
+                with self.assertRaises(ContractError):
+                    self.adopt()
+
+    def test_batch_allowance_does_not_become_a_lifetime_cap(self):
+        config = self.adopt()['contract']
+        for number in range(3):
+            existing = self.native()
+            existing['task_id'] = 'old-' + str(number)
+            self.controller.register_task('p', existing)
+            self.controller.cancel_pending('p', existing['task_id'], reason='retained cancelled qualification')
+        sequence._qualification_tasks(self.program, self.project, config, self.step, [self.native()])
+
+    def test_failed_optin_does_not_modify_contract_or_history(self):
+        before = self.program.status('p')
+        with self.assertRaises(ContractError):
+            self.program.authorize_b01_qualification('p', None, expected_revision=7)
+        self.assertEqual(self.program.status('p'), before)
+        malformed = copy.deepcopy(self.contract)
+        malformed['sequence']['qualification_authorization_ref'] = None
+        with self.assertRaises(ContractError):
+            sequence._qualification_authorization(self.project, malformed)
+        invalid = {**self.authorization, 'max_tasks': True}
+        reference = save_artifact(self.root, 'invalid.json', invalid)
