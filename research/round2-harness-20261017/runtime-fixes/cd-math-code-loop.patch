+"""Runtime adapters for pinned Work Harness C/D scientific development checks."""
+from .models import ContractError, validate_task
+
+PROFILE = 'work-harness-cd-v1'
+
+
+def is_cd_task(task):
+    return task.get('parameters', {}).get('sequence_binding', {}).get('flow_profile') == PROFILE
+
+
+def _call(project, task, body, options=None):
+    from .admission import _run_canonical
+    import json
+    source = '''
+import json,sys
+from pathlib import Path
+sys.path.insert(0,sys.argv[1])
+import research_cd as CD
+p,t,o=json.loads(sys.argv[2])
+''' + body
+    return json.loads(_run_canonical(project, task, source, options=options))
+
+
+def decision_refs(project, reference, goal_id, previous_ref=None, receipt_refs=None):
+    return _call(project, {}, "print(json.dumps(CD.decision_refs(p['root'],o['reference'],o['goal_id'],o['previous_ref'],o['receipt_refs'])))",
+                 {'reference': reference, 'goal_id': goal_id, 'previous_ref': previous_ref,
+                  'receipt_refs': receipt_refs or []})
+
+
+def validate_decision_binding(project, task, *, accepted_ref, goal_id):
+    # Controller validates exact sequence_binding against durable state first.
+    if accepted_ref is None or task['parameters'].get('reasoning_ref') != accepted_ref:
+        raise ContractError('C/D task must bind accepted decision')
+    _call(project, task, "CD.binding(p,t)\nd=CD.document(p['root'],o['reference'])\nCD.need(d.get('goal_id')==o['goal_id'] and t['parameters'].get('goal_id')==o['goal_id'],'C/D goal mismatch')\nCD.need(d.get('kind')=='research-cd-decision' and d.get('schema_version')==1,'C/D decision schema required')\nprint('true')",
+          {'reference': accepted_ref, 'goal_id': goal_id})
+
+
+def prepare_task(project, task, *, accepted_ref, goal_id):
+    prepared = validate_task(task)
+    refs = _call(project, prepared,
+                 "print(json.dumps(CD.check_task(p,t,accepted_ref=o['accepted_ref'],goal_id=o['goal_id'],expand=True)))",
+                 {'accepted_ref': accepted_ref, 'goal_id': goal_id})
+    for ref in refs:
+        if ref not in prepared['inputs'] + prepared['instructions']:
+            prepared['inputs'].append(ref)
+    return validate_task(prepared)
+
+
+def check_task(project, task):
+    q = task['parameters']
+    _call(project, task,
+          "CD.check_task(p,t,accepted_ref=o['accepted_ref'],goal_id=o['goal_id'])\nprint('true')",
+          {'accepted_ref': q.get('reasoning_ref'), 'goal_id': q.get('goal_id')})
+    return True
+
+
+def require_feedback(project, task, receipts):
+    q = task['parameters']
+    decision_refs(project, q['reasoning_ref'], q['goal_id'],
+                  receipt_refs=[r['receipt_ref'] for r in receipts])
+    return True
