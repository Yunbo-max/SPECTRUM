+def execute_cd_verification(project, packet):
+    """Replay actual pinned scorers on the fixed remote target under its lease.
+
+    The trusted closure worker supplies this packet and remaining timeout; the
+    origin still must validate its actual verifier controller attempt and review
+    scientific interpretation. Scoring qualification never certifies the idea.
+    """
+    validate_packet(packet)
+    if digest_tree(project['skill_root']) != project['skill_digest']:
+        raise ContractError('C/D scorer requires exact adopted Skill source')
+    deadline = time.monotonic() + packet['timeout_seconds']
+    observed = {}
+    target = _read(project['root'], packet['native_target_ref'], observed)
+    if (not target.get('host') or target.get('root') != project['root']
+            or target.get('skill_root') != project['skill_root']):
+        raise ContractError('C/D scorer must execute on its explicit SSH target')
+    gate = _read(project['root'], packet['cd_gate_ref'], observed)
+    if (gate.get('kind') not in {'research-cd-problem', 'research-cd-scaleup'}
+            or gate.get('schema_version') != 1 or gate.get('goal_id') != packet['goal_id']
+            or gate.get('scored_runs') != packet['scored_runs']):
+        raise ContractError('C/D verification differs from exact gate scored-run bindings')
+    for name in ('proposal_ref', 'coverage_ref'):
+        value = _read(project['root'], packet[name], observed)
+        if value.get('goal_id') != packet['goal_id']:
+            raise ContractError('C/D verification proposal/coverage goal mismatch')
+    for row in packet['scored_runs']:
+        for reference in row.values():
+            _read(project['root'], reference, observed)
+    report = _run(project, {'scored_runs': packet['scored_runs'], 'gate_kind': gate['kind']}, deadline,
+                  min(3., packet['timeout_seconds'] / 10.))
+    if (type(report.get('ready')) is not bool or report.get('native_replay_executed') is not True
+            or report.get('native_replay_count', 0) <= 0
+            or [{k: row[k] for k in ('protocol_ref','manifest_ref')} for row in report['scored_runs']] != packet['scored_runs']):
+        raise ContractError('C/D verification lacks actual matching scorer execution')
+    for reference in report['verified_refs']:
+        validate_ref(reference); verify_ref(project['root'], reference)
+        observed[(reference['path'], reference['sha256'])] = reference
+    for reference in observed.values(): verify_ref(project['root'], reference)
+    if digest_tree(project['skill_root']) != project['skill_digest']:
+        raise ContractError('C/D Skill source changed during actual scoring')
+    return {**report, 'goal_id': packet['goal_id'], 'proposal_ref': packet['proposal_ref'],
+            'cd_gate_ref': packet['cd_gate_ref'], 'verified_refs': list(observed.values()),
+            'scope': 'Native scores and baseline/control qualification; independent scientific review remains required.'}
