+import unittest
+from unittest.mock import Mock, patch
+from research_autopilot.program_cli import ProgramDispatcher
+
+class ReceiptPreflightTests(unittest.TestCase):
+    def test_legacy_bad_task_is_retired_without_agent_launch(self):
+        controller, program = Mock(), Mock()
+        task = {'task_id':'child', 'action':'source_read', 'adapter':'codex-local',
+                'parameters':{}, 'outputs':['report.md','evidence.json']}
+        controller.get_task.return_value={'task':task,'state':'pending'}
+        controller.cancel_pending.return_value={'state':'cancelled'}
+        dispatcher=ProgramDispatcher(controller,program,'project','owner')
+        configured=({'adapters':['codex-local']},{},
+                    {'codex-local':{'kind':'command','argv':['unused']}})
+        with patch.object(dispatcher,'_configured',return_value=configured), \
+             patch('research_autopilot.program_cli.CommandWorker') as worker:
+            result=dispatcher('execution','codex-local','child')
+        self.assertEqual(result['state'],'cancelled')
+        worker.assert_not_called()
+        controller.cancel_pending.assert_called_once()
+        self.assertIn('command_response_path',controller.cancel_pending.call_args.kwargs['reason'])
+
+class ReceiptContractTests(unittest.TestCase):
+    def test_receipt_selection(self):
+        from research_autopilot.command_contract import command_response_path
+        from research_autopilot.models import ContractError
+        for outputs, params, expected in [
+            (['response.json'], {}, 'response.json'),
+            (['report.md','evidence.json','receipt.json'], {'command_response_path':'receipt.json'}, 'receipt.json'),
+            (['report.md','evidence.json'], {}, None),
+            (['report.md'], {'command_response_path':'missing.json'}, None),
+            (['figure.png'], {}, None),
+            (['report.md'], {'command_response_path':[]}, None),
+        ]:
+            with self.subTest(outputs=outputs,params=params):
+                task={'outputs':outputs,'parameters':params}
+                if expected is None:
+                    with self.assertRaises(ContractError):command_response_path(task)
+                else:self.assertEqual(command_response_path(task),expected)
+
+    def test_proposal_rejects_before_materializing(self):
+        from research_autopilot.program import ResearchProgram
+        from research_autopilot.models import ContractError
+        program=ResearchProgram.__new__(ResearchProgram);program.controller=Mock()
+        prior={'state':{'goal_id':'goal','consumed_runs':[],'coverage_ref':None},
+               'contract':{'agent_config_ref':{'path':'agents.json','sha256':'0'*64}}}
+        project={'root':'/unused','project_id':'project'}
+        task={'adapter':'codex-local','action':'source_read','outputs':['a.md','b.json'],'parameters':{}}
+        proposal={'kind':'research-loop-proposal','schema_version':1,'goal_id':'goal',
+                  'status':'continue','summary':'source read','decision_ref':None,'coverage_ref':None,
+                  'tasks':[task],'cancel_pending_task_ids':[],'consumed_run_ids':[],'wait_seconds':0}
+        with patch.object(program,'_decision',return_value=[]), \
+             patch('research_autopilot.program.validate_coverage',return_value={'manifest':{'goal_id':'goal'}}), \
+             patch('research_autopilot.program.validate_task',side_effect=lambda x:x), \
+             patch('research_autopilot.program.read_json',return_value={'adapters':{'codex-local':{'kind':'command'}}}):
+            with self.assertRaisesRegex(ContractError,'command_response_path'):
+                program._proposal(prior,project,proposal,[])
+        program.controller.register_task.assert_not_called()
+
+class RealControllerRecoveryTests(unittest.TestCase):
+    def test_cancel_preserves_contract_and_does_not_claim_run(self):
+        import tempfile
+        from pathlib import Path
+        import research_autopilot.controller as api
+        from test_controller import setup_controller, task
+        with tempfile.TemporaryDirectory() as tmp:
+            c=setup_controller(api,Path(tmp))
+            original=task('bad',adapter='codex',outputs=['report.md','data.json'])
+            c.register_task('p',original)
+            before=c.get_task('p','bad')['task']
+            d=ProgramDispatcher(c,Mock(),'p','owner')
+            with patch.object(d,'_configured',return_value=(c.get_project('p'),{},
+                    {'codex':{'kind':'command','argv':['unused']}})):
+                result=d('execution','codex','bad')
+            self.assertEqual(result['state'],'cancelled')
+            self.assertIsNone(result['attempt'])
+            self.assertEqual(result['task'],before)
+            self.assertEqual(c.status('p')['budget']['spent_seconds'],0)
+
+    def test_running_attempt_cannot_be_retired(self):
+        import tempfile
+        from pathlib import Path
+        import research_autopilot.controller as api
+        from research_autopilot.models import ContractError
+        from test_controller import setup_controller, task
+        with tempfile.TemporaryDirectory() as tmp:
+            c=setup_controller(api,Path(tmp));c.register_task('p',task('live'))
+            claim=c.claim('p','owner',adapter='codex')
+            self.assertIsNotNone(claim)
+            with self.assertRaises(ContractError):c.cancel_pending('p','live',reason='invalid receipt')
+            self.assertEqual(c.get_task('p','live')['state'],'running')
+
+if __name__=='__main__':unittest.main()
