@@ -0,0 +1,67 @@
+"""Nonterminal phase checkpoints: wait for a change, never certify science."""
+from .artifacts import contract_hash, pin_file, verify_ref
+from .models import ContractError, fields, json_data, text
+from .phase_autonomy import enabled
+
+
+KIND = 'research-phase-checkpoint'
+
+
+def policy(prior):
+    return contract_hash(prior['contract']['policy'])
+
+
+def park(program, prior, *, checkpoint_ref, dependency_refs, summary, response_ref=None, run_id=None):
+    state = prior['state']
+    state.update(stage='phase_wait', staged_tasks=[], not_before=0, reason=summary,
+                 phase_checkpoint={'checkpoint_ref': checkpoint_ref,
+                     'dependency_refs': json_data(dependency_refs), 'policy_digest': policy(prior),
+                     'response_ref': response_ref, 'planner_task_id': state.get('planner_task_id'),
+                     'run_id': run_id, 'scientific_acceptance': False})
+    return {'status': 'waiting_dependency',
+            'program': program._update(prior, state, 'phase_waiting_dependency')}
+
+
+def accept(program, prior, project, response, item):
+    from .skill_sequence import binding
+    fields(response, {'kind', 'schema_version', 'goal_id', 'sequence', 'summary',
+                      'checkpoint_ref', 'dependency_refs'})
+    if (not enabled(prior['contract']) or response['kind'] != KIND
+            or type(response['schema_version']) is not int or response['schema_version'] != 1
+            or response['goal_id'] != prior['state']['goal_id']
+            or response['sequence'] != binding(prior['state'])
+            or item['task_id'] != prior['state']['planner_task_id']):
+        raise ContractError('checkpoint must belong to the current phase worker')
+    text(response['summary'], 'checkpoint summary')
+    verify_ref(project['root'], response['checkpoint_ref'])
+    refs = response['dependency_refs']
+    if not isinstance(refs, list):
+        raise ContractError('checkpoint dependencies must be file references')
+    for ref in refs:
+        verify_ref(project['root'], ref)
+    return park(program, prior, checkpoint_ref=response['checkpoint_ref'],
+                dependency_refs=refs, summary=response['summary'],
+                response_ref=item['response_ref'], run_id=item['attempt']['run_id'])
+
+
+def wake(state):
+    # Keep the checkpoint in the next worker handoff and the durable history.
+    state.update(stage='decide', staged_tasks=[], not_before=0,
+                 reason='dependency changed; restore the same phase checkpoint')
+    state.pop('phase_rejection_signature', None)
+
+
+def observe(program, prior, project):
+    record = prior['state']['phase_checkpoint']
+    changed = policy(prior) != record['policy_digest']
+    for ref in record['dependency_refs']:
+        try:
+            changed = changed or pin_file(project['root'], ref['path']) != ref
+        except (OSError, ValueError, ContractError):
+            # Missing/unreadable dependency is not a successful repair.
+            pass
+    if not changed:
+        return {'status': 'waiting_dependency', 'program': prior}
+    wake(prior['state'])
+    return {'status': 'phase_dependency_changed',
+            'program': program._update(prior, prior['state'], 'phase_dependency_changed')}
