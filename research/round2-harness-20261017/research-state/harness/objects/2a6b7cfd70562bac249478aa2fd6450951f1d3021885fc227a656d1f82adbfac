{"task_id": "Mbpp/837", "original_task_id": 837, "entry_point": "cube_Sum", "prompt": "Write a python function to find the cube sum of first n odd natural numbers.\n\nImplement this Python function. Return only the complete implementation.\ndef cube_Sum(n):\n    pass", "original_prompt": "Write a python function to find the cube sum of first n odd natural numbers.", "prompt_protocol": "mbpp-function-interface-v1", "interface_source": "reference-ast-signature-only", "reference": "def cube_Sum(n): \r\n    sum = 0   \r\n    for i in range(0,n) : \r\n        sum += (2*i+1)*(2*i+1)*(2*i+1) \r\n    return sum", "tests": "assert cube_Sum(2) == 28\nassert cube_Sum(3) == 153\nassert cube_Sum(4) == 496", "source": "google-research-datasets/mbpp", "split": "train", "original_split": "train", "dataset_config": "full", "revision": "4bb6404fdc6cacfda99d4ac4205087b89d32030c", "split_seed": 42, "dataset_fingerprint": null}
