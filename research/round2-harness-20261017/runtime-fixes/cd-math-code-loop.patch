+        raise ContractError('scientific gate requires actual native manifests for scorer replay')
+    for row in scored:
+        fields(row, {'protocol_ref', 'manifest_ref'})
+        _refs(project, list(row.values()), 'scored run binding')
+    if step_id == 'M05' and not any(row['protocol_ref'] == value['protocol_ref'] for row in scored):
+        raise ContractError('scaleup scoring must include the selected method protocol')
+    from .admission import _run_canonical
+    _run_canonical(project, {}, '''
