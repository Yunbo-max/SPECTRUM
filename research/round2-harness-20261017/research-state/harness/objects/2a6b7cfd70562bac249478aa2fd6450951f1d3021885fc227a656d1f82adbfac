{"task_id": "Mbpp/411", "original_task_id": 411, "entry_point": "snake_to_camel", "prompt": "Write a function to convert the given snake case string to camel case string by using regex.\n\nImplement this Python function. Return only the complete implementation.\ndef snake_to_camel(word):\n    pass", "original_prompt": "Write a function to convert the given snake case string to camel case string by using regex.", "prompt_protocol": "mbpp-function-interface-v1", "interface_source": "reference-ast-signature-only", "reference": "import re\r\ndef snake_to_camel(word):\r\n  return ''.join(x.capitalize() or '_' for x in word.split('_'))", "tests": "assert snake_to_camel('android_tv') == 'AndroidTv'\nassert snake_to_camel('google_pixel') == 'GooglePixel'\nassert snake_to_camel('apple_watch') == 'AppleWatch'", "source": "google-research-datasets/mbpp", "split": "eval", "original_split": "test", "dataset_config": "full", "revision": "4bb6404fdc6cacfda99d4ac4205087b89d32030c", "split_seed": 42, "dataset_fingerprint": null}
