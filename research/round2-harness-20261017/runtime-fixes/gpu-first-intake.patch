+        self.assertEqual(calls, [])
+
+    def test_bare_torch_uuid_matches_actual_nvidia_and_allocation_identity(self):
+        bare = '3350bcde-dd30-eb6c-2d75-1d6f7515fdb2'
+        canonical = 'GPU-' + bare
