+def device(index=0, native=True, free=20000):
+    return {'index': index, 'uuid': 'GPU-' + str(index), 'name': 'not-used-for-admission',
+            'free_vram_mib': free, 'precision': {'fp32': True, 'fp16': True,
+            'bf16': native, 'bf16_default_may_emulate': True},
+            'smoke': {p: {'status': 'not_requested'} for p in ('fp32', 'fp16', 'bf16')}}
+
+
+def observation(devices=None):
+    devices = [device()] if devices is None else devices
+    return {'python': {'matches_requested': True, 'executable': TARGET['python'], 'prefix': '/project/.venv'},
+            'errors': [], 'torch': {'status': 'observed', 'cuda_available': bool(devices),
+                                   'visible_device_count': len(devices), 'devices': devices}}
+
+
+class FakeTensor:
+    def __init__(self, correct=True):
+        self.correct = correct
+
+    def __matmul__(self, other):
+        return self
+
+    def __eq__(self, value):
+        return SimpleNamespace(all=lambda: SimpleNamespace(item=lambda: self.correct and value == 32))
+
+    def all(self):
+        return self
+
+    def item(self):
+        return True
+
+
+def fake_torch(capability=(8, 9), native=True, *, legacy=False, smoke_error=False,
+               wrong_result=False, count=1, device_uuids=None):
+    calls = []
+    bf16_calls, context_calls, memory_calls = [], [], []
+
+    def bf16(**kwargs):
+        bf16_calls.append(kwargs)
+        if kwargs and legacy:
+            raise TypeError('old API')
+        return native if kwargs else True
+
+    def context(index):
+        context_calls.append(index)
+        return nullcontext()
+
+    def memory(index):
+        memory_calls.append(index)
+        return 20000 * 1024 * 1024, 24000 * 1024 * 1024
+
+    def ones(shape, **kwargs):
+        calls.append((shape, kwargs))
+        if smoke_error:
+            raise RuntimeError('private detail must not reach report')
+        return FakeTensor(correct=not wrong_result)
+
+    cuda = SimpleNamespace(
+        is_available=lambda: True, device_count=lambda: count,
+        device=context,
+        get_device_properties=lambda index: SimpleNamespace(
+            name='T4' if capability[0] == 7 else 'RTX 4090',
+            uuid=device_uuids[index] if device_uuids is not None else 'GPU-' + str(index),
+            total_memory=24000 * 1024 * 1024),
+        get_device_capability=lambda index: capability,
+        mem_get_info=memory, bf16_calls=bf16_calls, context_calls=context_calls,
+        memory_calls=memory_calls, is_bf16_supported=bf16,
+        synchronize=lambda index: None, empty_cache=lambda: None)
+    return SimpleNamespace(cuda=cuda, version=SimpleNamespace(cuda='12.4'),
+                           __version__='2.5.0', float32='float32', float16='float16',
+                           bfloat16='bfloat16', ones=ones, isfinite=lambda tensor: tensor), calls
+
+
+class GPUPreflightTests(unittest.TestCase):
+    def report(self, project=None, requirements=None, **kwargs):
+        payload = observation() if project is None else project
+        calls = []
+
+        def runner(argv):
+            calls.append(argv)
+            return json.dumps(payload)
+
+        result = G.collect_report(TARGET, REQUIREMENTS if requirements is None else requirements,
+                                  runner=runner, **kwargs)
