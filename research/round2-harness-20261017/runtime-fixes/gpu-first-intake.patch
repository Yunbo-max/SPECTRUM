+    def test_probe_timeout_and_output_limit_are_bounded_unknowns(self):
+        for error in (RuntimeError('timeout'), RuntimeError('output_limit'),
+                      subprocess.TimeoutExpired('ssh', 45)):
+            with patch.object(G, '_run_bounded', side_effect=error):
+                report = G.collect_report(TARGET, REQUIREMENTS)
+            self.assertEqual(report['status'], 'needs_measurement')
+            self.assertEqual(report['interpreters']['project']['status'], 'unknown')
+        report = G.collect_report(TARGET, REQUIREMENTS, runner=lambda argv: 'x' * (G.OUTPUT_LIMIT + 1))
+        self.assertEqual(report['interpreters']['project']['error'], 'output_limit')
+        for payload in ('{', '{}'):
+            report = G.collect_report(TARGET, REQUIREMENTS, runner=lambda argv: payload)
+            self.assertEqual(report['status'], 'needs_measurement')
+            self.assertEqual(report['reasons'], ['selected_project_observation_unavailable'])
+
+    def test_cli_writes_report_for_invalid_json(self):
