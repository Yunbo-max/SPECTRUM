+"""Scoped Work Harness C/D navigation and evidence contracts.
+
+Program-owned transitions retain invalidated evidence, never reset resource usage,
+and do not interpret structural validity as scientific truth.
+"""
+from __future__ import annotations
+from .models import ContractError, fields, text
+from .artifacts import verify_ref
+
+PROFILE = 'work-harness-cd-v1'
+CATALOG_PATH = 'assets/skill-sequence-cd-v1.json'
+B = frozenset({'L01', 'L02', 'L03', 'X02', 'L04', 'X03', 'L05'})
+C = frozenset({'B01', 'S01', 'E01', 'B02', 'B03', 'B04', 'B05'})
+D = frozenset({'H01', 'H02', 'H03', 'H04', 'H05', 'M01', 'M02', 'M03', 'M04', 'M05'})
+E = frozenset({'S02', 'S03', 'S04', 'E02', 'S05', 'G01', 'G02', 'G03', 'E03', 'G04', 'E05', 'E04', 'G05'})
+SCALEUP_OBLIGATIONS = frozenset({'problem_supported', 'math_code_correspondence',
+    'real_benchmark_comparison', 'strong_simple_controls', 'mechanism_prediction',
+    'uncertainty_and_practical_effect', 'confounds_checked', 'nearest_work',
+    'negative_results_and_exposure', 'scope_and_e_obligations'})
+
+
+def enabled(config):
+    value = config.get('sequence', {}).get('flow_profile')
+    if value not in (None, PROFILE):
+        raise ContractError('unsupported Work Harness flow profile')
+    return value == PROFILE
+
+
+def initialize_state():
+    return {'flow_profile': PROFILE, 'epoch': 1, 'visit': None, 'revisit_refs': [],
+            'problem_ref': None, 'verified_ref': None, 'scaleup_acceptance_ref': None,
+            'inherited_acceptance_count': 0}
+
+
+def _read(project, ref):
+    from .program import read_json
+    return read_json(project['root'], ref)
+
+
+def _refs(project, refs, name):
+    if not isinstance(refs, list) or not refs:
+        raise ContractError(name + ' requires nonempty pinned evidence')
+    for ref in refs:
+        if not verify_ref(project['root'], ref).stat().st_size:
+            raise ContractError(name + ' cites empty evidence')
+
+
+def context(prior):
+    if not enabled(prior['contract']):
+        return None
+    seq = prior['state']['sequence']
+    return {'flow_profile': PROFILE, 'epoch': seq['epoch'],
+            'visit': seq['visit'], 'revisit_refs': seq['revisit_refs'][-3:],
+            'problem_ref': seq['problem_ref'], 'verified_ref': seq['verified_ref'],
+            'scaleup_acceptance_ref': seq['scaleup_acceptance_ref'],
+            'gate': 'PROBLEM_SUPPORTED' if seq['step_id'] == 'B05' else
+                    'VERIFIED_FOR_SCALEUP' if seq['step_id'] == 'M05' else None,
+            'revisit_schema': {'mode': 'visit (one B source node) or revise (earlier C/D node)',
+                'origin': 'exact sequence binding', 'target': 'allowed node ID',
+                'return_to': 'origin step for visit; null for revise',
+                'reason': 'specific evidence gap', 'expected_output': 'discriminating evidence',
+                'evidence_refs': 'nonempty pinned references'},
+            'instructions': INSTRUCTIONS}
+
+
+def validate_revisit(project, prior, request):
+    from .skill_sequence import binding, _catalog
+    if not enabled(prior['contract']):
+        raise ContractError('revisit requires the adopted C/D profile')
+    seq = prior['state']['sequence']
+    fields(request, {'mode', 'origin', 'target', 'return_to', 'reason', 'expected_output', 'evidence_refs'})
+    if seq.get('visit') is not None or request['origin'] != binding(prior['state']):
+        raise ContractError('revisit origin is stale or already visiting a source node')
+    if seq['step_id'] not in C | D | E:
+        raise ContractError('only C/D or E counterevidence can request a scoped revisit')
+    text(request['reason'], 'revisit reason')
+    text(request['expected_output'], 'revisit expected output')
+    _refs(project, request['evidence_refs'], 'revisit')
+    catalog, _ = _catalog(project, PROFILE)
+    positions = {s['id']: i for i, s in enumerate(catalog['steps'])}
+    target = request['target']
+    if request['mode'] == 'visit':
+        if target not in B or request['return_to'] != seq['step_id']:
+            raise ContractError('source visit must select one B node and return to its origin')
+    elif request['mode'] == 'revise':
+        if target not in C | D or positions[target] > seq['index'] or request['return_to'] is not None:
+            raise ContractError('revision must reopen an earlier/current C/D node')
+    else:
+        raise ContractError('unknown scoped revisit mode')
+
+
+def apply_revisit(project, prior, request, result_ref, review_ref):
+    from .program import save_artifact
+    from .skill_sequence import _catalog, binding
+    validate_revisit(project, prior, request)
+    state, seq = prior['state'], prior['state']['sequence']
+    catalog, _ = _catalog(project, PROFILE)
+    position = next(i for i, s in enumerate(catalog['steps']) if s['id'] == request['target'])
+    start = (seq['cycle'] - 1) * len(catalog['steps'])
+    invalidated = seq['accepted'][start + position:] if request['mode'] == 'revise' else []
+    record = {'kind': 'research-cd-revisit', 'schema_version': 1, 'goal_id': state['goal_id'],
+              'sequence': binding(state), 'request': request, 'result_ref': result_ref,
+              'review_ref': review_ref, 'invalidated_acceptance_refs': invalidated,
+              'previous_problem_ref': seq['problem_ref'], 'previous_verified_ref': seq['verified_ref'],
+              'previous_ref': seq['revisit_refs'][-1] if seq['revisit_refs'] else None}
+    ref = save_artifact(project['root'],
+        f'research-state/harness/cd/epoch-{seq["epoch"]:06d}/revisit-{state["round"]:06d}.json', record)
+    seq['revisit_refs'].append(ref)
+    if request['mode'] == 'visit':
+        seq['visit'] = {'origin_index': seq['index'], 'origin_step': seq['step_id'],
+                        'origin_attempt': seq['attempt'], 'request_ref': ref}
+    else:
+        seq['accepted'] = seq['accepted'][:start + position]
+        # Source lookup alone does not invalidate a scientific gate. An actual
+        # revision reopens dependent C/D and formal E obligations explicitly.
+        seq['verified_ref'] = None
+        seq['scaleup_acceptance_ref'] = None
+        if request['target'] in C:
+            seq['problem_ref'] = None
+    seq.update(index=position, step_id=request['target'], attempt=0, epoch=seq['epoch'] + 1,
+               result_ref=None, inspect_task_ids=[], inspection_refs=[], repair_basis=[])
+    reset_transport(state)
+    state['reason'] = 'reviewed scoped C/D revisit; prior work and usage retained'
+    return ref
+
+
+def return_from_visit(project, prior, acceptance_ref):
+    from .program import save_artifact
+    seq = prior['state']['sequence']
+    visit = seq.get('visit')
+    if visit is None:
+        raise ContractError('no active source visit to return from')
+    ref = save_artifact(project['root'],
+        f'research-state/harness/cd/epoch-{seq["epoch"]:06d}/return.json', {
+            'kind': 'research-cd-visit-return', 'schema_version': 1,
+            'request_ref': visit['request_ref'], 'acceptance_ref': acceptance_ref,
+            'return_to': visit['origin_step'], 'previous_ref': seq['revisit_refs'][-1]})
+    seq['revisit_refs'].append(ref)
+    seq.update(index=visit['origin_index'], step_id=visit['origin_step'],
+               attempt=visit['origin_attempt'], epoch=seq['epoch'] + 1,
+               visit=None, result_ref=None, inspect_task_ids=[], inspection_refs=[], repair_basis=[])
+    reset_transport(prior['state'])
+    prior['state']['reason'] = 'targeted source evidence accepted; return to original research question'
+
+
+def reset_transport(state):
+    state.update(stage='decide', staged_tasks=[], execution_task_ids=[], retire_task_ids=[],
+                 proposal_ref=None, review_ref=None, validation_ref=None, verifier_task_id=None,
+                 planner_task_id=None, reviewer_task_id=None)
+
+
+def _actual_runs(program, prior, project, refs):
+    _refs(project, refs, 'scientific run receipts')
+    for ref in refs:
+        record = _read(project, ref)
+        item = record.get('controller', {})
+        task = item.get('task', {})
+        attempt = item.get('attempt')
+        if (item.get('state') != 'completed' or task.get('action') != 'native_harness'
+                or not attempt or not item.get('outputs')):
+            raise ContractError('scientific gate requires actual completed native runs, not startup/JSON')
+        actual = program.controller.get_task(project['project_id'], task.get('task_id'))
+        if actual != item:
+            raise ContractError('scientific gate run differs from controller history')
+        if task.get('parameters', {}).get('goal_id') != prior['state']['goal_id']:
+            raise ContractError('scientific gate run belongs to a different goal')
+        # All run artifacts including negative cases remain pinned; the reviewer
+        # must interpret scoring/uncertainty, not equate completion with benefit.
+        _refs(project, [row['archive_ref'] for row in record.get('retained_files', [])], 'retained run outputs')
+
+
+def validate_gate(program, prior, project, step_id, reference):
+    if not enabled(prior['contract']) or step_id not in {'B05', 'M05'}:
+        raise ContractError('C/D gate is exclusive to B05 and M05 in the adopted profile')
+    value = _read(project, reference)
+    if type(value.get('schema_version')) is not int or value['schema_version'] != 1 or value.get('goal_id') != prior['state']['goal_id']:
+        raise ContractError('scientific gate has an invalid schema/goal')
+    if step_id == 'B05':
+        fields(value, {'kind', 'schema_version', 'goal_id', 'version', 'method', 'conditions',
+            'dependency_or_failure', 'assumptions', 'observables', 'competing_explanations',
+            'intervention', 'consequences', 'uncertainty', 'evidence_refs', 'run_receipt_refs', 'scored_runs'})
+        if value['kind'] != 'research-cd-problem':
+            raise ContractError('B05 requires a scoped problem contract')
+        for key in ('version', 'method', 'conditions', 'dependency_or_failure', 'assumptions',
+                    'observables', 'competing_explanations', 'intervention', 'consequences', 'uncertainty'):
+            text(value[key], 'problem ' + key)
+        _refs(project, value['evidence_refs'], 'problem evidence')
+        _actual_runs(program, prior, project, value['run_receipt_refs'])
+    else:
+        fields(value, {'kind', 'schema_version', 'goal_id', 'problem_ref', 'mechanism_ref',
+            'candidate_id', 'code_ref', 'method_code_refs', 'protocol_ref', 'run_receipt_refs', 'analysis_refs',
+            'obligations', 'e_obligations', 'exposure_ref', 'scored_runs'})
+        if value['kind'] != 'research-cd-scaleup' or value['problem_ref'] != prior['state']['sequence']['problem_ref'] or value['problem_ref'] is None:
+            raise ContractError('scaleup must bind the current independently accepted C problem')
+        text(value['candidate_id'], 'scaleup candidate')
+        _refs(project, value['method_code_refs'], 'full method code identity')
+        if value['code_ref'] not in value['method_code_refs']:
+            raise ContractError('primary method code is absent from complete method identity')
+        _refs(project, [value[k] for k in ('problem_ref','mechanism_ref','code_ref','protocol_ref','exposure_ref')], 'scaleup identities')
+        _refs(project, value['analysis_refs'], 'scaleup analysis')
+        _actual_runs(program, prior, project, value['run_receipt_refs'])
+        rows = value['obligations']
+        if not isinstance(rows, list) or len(rows) != len(SCALEUP_OBLIGATIONS):
+            raise ContractError('scaleup needs every substantive evidence obligation')
+        seen = set()
+        for row in rows:
+            fields(row, {'id', 'finding', 'evidence_refs'})
+            if row['id'] not in SCALEUP_OBLIGATIONS or row['id'] in seen:
+                raise ContractError('scaleup obligation missing/duplicate/unknown')
+            seen.add(row['id'])
+            text(row['finding'], 'scaleup finding')
+            _refs(project, row['evidence_refs'], 'scaleup obligation')
+        if not isinstance(value['e_obligations'], list) or not value['e_obligations']:
+            raise ContractError('scaleup must preserve E confirmation obligations')
+        for obligation in value['e_obligations']:
+            text(obligation, 'E obligation')
+        # Prove the accepted code/protocol really occurred together in a run.
+        matched = False
+        for ref in value['run_receipt_refs']:
+            record = _read(project, ref)
+            task = record['controller']['task']
+            plan = _read(project, task['parameters']['harness_plan_ref'])
+            for item in plan['tasks']:
+                native = _read(project, item['plan_ref'])
+                if native['protocol_ref'] == value['protocol_ref']:
+                    from .artifacts import canonical_json
+                    required_code = {canonical_json(r) for r in value['method_code_refs']}
+                    for job in native['jobs']:
+                        if job['arm_role'] == 'treatment':
+                            if {canonical_json(r) for r in job['code_refs']} != required_code:
+                                raise ContractError('scaleup treatment dependency code differs from complete method identity')
+                            matched = True
+        if not matched:
+            raise ContractError('scaleup code/protocol has no matching actual native run')
+    scored = value['scored_runs']
