@@ -0,0 +1,18 @@
+"""Shared command-agent task receipt preflight; no execution or mutations."""
+from pathlib import Path
+from .models import ContractError
+
+
+def command_response_path(task):
+    outputs = task['outputs']
+    selected = task['parameters'].get('command_response_path')
+    if selected is not None:
+        if not isinstance(selected, str) or selected not in outputs:
+            raise ContractError('command_response_path must be a declared output')
+    elif len(outputs) != 1:
+        raise ContractError('multiple outputs require a separate command_response_path receipt')
+    else:
+        selected = outputs[0]
+    if Path(selected).suffix.lower() not in {'.json', '.txt', '.md'}:
+        raise ContractError('command final response must be a separate JSON/text receipt')
+    return selected
