{"task_id": "Mbpp/732", "original_task_id": 732, "entry_point": "replace_specialchar", "prompt": "Write a function to replace all occurrences of spaces, commas, or dots with a colon.\n\nImplement this Python function. Return only the complete implementation.\ndef replace_specialchar(text):\n    pass", "original_prompt": "Write a function to replace all occurrences of spaces, commas, or dots with a colon.", "prompt_protocol": "mbpp-function-interface-v1", "interface_source": "reference-ast-signature-only", "reference": "import re\r\ndef replace_specialchar(text):\r\n return (re.sub(\"[ ,.]\", \":\", text))\r", "tests": "assert replace_specialchar('Python language, Programming language.')==('Python:language::Programming:language:')\nassert replace_specialchar('a b c,d e f')==('a:b:c:d:e:f')\nassert replace_specialchar('ram reshma,ram rahim')==('ram:reshma:ram:rahim')", "source": "google-research-datasets/mbpp", "split": "train", "original_split": "train", "dataset_config": "full", "revision": "4bb6404fdc6cacfda99d4ac4205087b89d32030c", "split_seed": 42, "dataset_fingerprint": null}
{"task_id": "Mbpp/647", "original_task_id": 647, "entry_point": "split_upperstring", "prompt": "Write a function to split a string at uppercase letters.\n\nImplement this Python function. Return only the complete implementation.\ndef split_upperstring(text):\n    pass", "original_prompt": "Write a function to split a string at uppercase letters.", "prompt_protocol": "mbpp-function-interface-v1", "interface_source": "reference-ast-signature-only", "reference": "import re\r\ndef split_upperstring(text):\r\n return (re.findall('[A-Z][^A-Z]*', text))", "tests": "assert split_upperstring(\"PythonProgramLanguage\")==['Python','Program','Language']\nassert split_upperstring(\"PythonProgram\")==['Python','Program']\nassert split_upperstring(\"ProgrammingLanguage\")==['Programming','Language']", "source": "google-research-datasets/mbpp", "split": "train", "original_split": "train", "dataset_config": "full", "revision": "4bb6404fdc6cacfda99d4ac4205087b89d32030c", "split_seed": 42, "dataset_fingerprint": null}
