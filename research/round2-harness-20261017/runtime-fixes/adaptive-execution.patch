+"""Engineering-only adapter tests. Fixtures are not benchmark science evidence."""
+import copy
+import sys
+import unittest
+from fixtures import C, ProjectFixture, write
+from test_native_eval import native_contract_fixture, native_run_fixture, trusted_engineering_replay
+import _native_eval as N
+
+
+class BenchmarkAdapterTests(unittest.TestCase):
+    def setUp(self):
+        self.f = ProjectFixture(); self.addCleanup(self.f.close)
+        self.p = self.f.protocol(); c = native_contract_fixture(self.f.root, self.p)
+        self.c = c
+        self.definition = C.load_file(C.verify_ref(self.f.root,c['native_definition_ref']))
+        self.definition['scorer'] = None
+        self.definition['scorer_availability_ref'] = write(self.f.root,'engineering/availability.json',{'observed':'no executable in engineering fixture'})
+        c['native_definition_ref'] = write(self.f.root,'engineering/definition-adapter.json',self.definition)
+        c['scorer'] = dict(c['scorer'],kind='benchmark_adapter',identity='engineering-spec-adapter')
+        self.v = {'adapter_scorer':copy.deepcopy(c['scorer']),
+            'benchmark_id':c['benchmark_id'],'benchmark_revision':c['benchmark_revision'],
+            'specification_refs':c['published_source_refs'],'semantics_ref':write(self.f.root,'engineering/mapping.json',{'mapping':'fixture only'}),
+            'executes_generated_code':False,'probes':[]}
+        for name, value in [('known_correct',1),('known_incorrect',0)]:
+            out=write(self.f.root,f'engineering/{name}-output.json',{'denominator':2,'native_metrics':{'accuracy':value,'scope':value}})
+            pred=write(self.f.root,f'engineering/{name}-predictions.json',{'predictions':[{'sample_id':x,'correct':value} for x in ['existing-fixture-1','existing-fixture-2']]})
+            self.v['probes'].append({'case':name,'predictions_ref':pred,'sample_manifest_ref':c['sample_manifest_ref'],
+                'labels_or_tests_ref':c['labels_or_tests_ref'],'seed':0,'denominator':2,
+                'expected_metrics':{'accuracy':value,'scope':value},'expectation_ref':c['published_source_refs'][0],
+                'native_output_ref':out,'raw_output_refs':[out]})
+        self.refresh()
+
+    def refresh(self):
+        self.c['scorer']['verification_ref']=write(self.f.root,'engineering/adapter-verification.json',self.v)
+        self.p['protocol_digest']=C.protocol_hash(self.p)
+        self.m=self.f.runs(self.p)[0][0];native_run_fixture(self.f.root,self.p,self.m)
+        self.live=trusted_engineering_replay(self.f.root)
+
+    def reject(self,code,action):
+        with self.assertRaises(C.Failure) as ex: action()
+        self.assertEqual(code,ex.exception.code)
+
+    def test_spec_adapter_without_official_executable_replays_probes_and_real_arms(self):
+        result=N.verify_run(self.f.root,self.p,self.m,self.live)
+        self.assertEqual(len(result['replay_audit']),len(self.c['arm_requirements'])+2)
+        self.assertEqual(result['evaluation_scope']['scorer_kind'],'benchmark_adapter')
+        self.assertIn(self.v['semantics_ref'],result['proof_refs'])
+
+    def test_adapter_cannot_mislabel_available_official_scorer(self):
+        self.definition['scorer']=dict(self.v['adapter_scorer'],kind='official')
+        self.c['native_definition_ref']=write(self.f.root,'engineering/definition-adapter.json',self.definition)
+        self.reject('NATIVE_ADAPTER_USE_AVAILABLE_OFFICIAL_SCORER',lambda:N.verify_protocol(self.f.root,self.p))
+
+    def test_changed_adapter_identity_requires_new_verification(self):
+        self.c['scorer']['revision']='changed'
+        self.reject('NATIVE_ADAPTER_IDENTITY_MISMATCH',lambda:N.verify_protocol(self.f.root,self.p))
+
+    def test_generated_program_adapter_requires_exception_timeout_controls(self):
+        self.v['executes_generated_code']=True;self.refresh()
+        self.reject('NATIVE_ADAPTER_PROBES_REQUIRED',lambda:N.verify_protocol(self.f.root,self.p))
+
+    def test_unknown_probe_samples_rejected(self):
+        row=self.v['probes'][0]
+        sample=C.load_file(C.verify_ref(self.f.root,row['sample_manifest_ref']))
+        sample['sample_ids']=['invented']
+        row['sample_manifest_ref']=write(self.f.root,'engineering/invalid-probe-sample.json',sample);self.refresh()
+        self.reject('NATIVE_ADAPTER_PROBE_SAMPLES_INVALID',lambda:N.verify_protocol(self.f.root,self.p))
+
+    def test_identical_correct_and_incorrect_probes_rejected(self):
+        self.v['probes'][0]['expected_metrics']=copy.deepcopy(self.v['probes'][1]['expected_metrics']);self.refresh()
+        self.reject('NATIVE_ADAPTER_PROBES_NOT_DISTINGUISHING',lambda:N.verify_protocol(self.f.root,self.p))
+
+    def test_exception_timeout_names_without_actual_outcomes_rejected(self):
+        self.v['executes_generated_code']=True
+        for case in ('exception','timeout'):
+            self.v['probes'].append(dict(self.v['probes'][1],case=case))
+        self.refresh()
+        self.reject('NATIVE_ADAPTER_PROBE_OUTCOME_REQUIRED',lambda:N.verify_protocol(self.f.root,self.p))
+
+    def test_timeout_requires_live_termination_outcome(self):
+        self.v['executes_generated_code']=True
+        for case in ('exception','timeout'):
+            row=dict(self.v['probes'][1],case=case,outcome_path=['outcome'],process_status_path=['process_status'])
+            row['native_output_ref']=write(self.f.root,'engineering/'+case+'-outcome.json',{
+                'denominator':2,'native_metrics':row['expected_metrics'],'outcome':case,'process_status':'running'})
+            self.v['probes'].append(row)
+        self.refresh()
+        self.reject('NATIVE_ADAPTER_PROBE_PROCESS_NOT_TERMINATED',lambda:N.verify_run(self.f.root,self.p,self.m,self.live))
+
+    def test_live_probe_mismatch_rejects_scientific_acceptance(self):
+        self.v['probes'][0]['expected_metrics']['accuracy']=0;self.refresh()
+        self.reject('NATIVE_ADAPTER_PROBE_FAILED',lambda:N.verify_run(self.f.root,self.p,self.m,self.live))
+
+    def test_no_live_execution_cannot_be_replaced_with_saved_pass(self):
+        self.reject('NATIVE_SCORER_REPLAY_REQUIRED',lambda:N.verify_run(self.f.root,self.p,self.m))
+
+    def test_actual_subprocess_adapter_probes_on_test_host(self):
+        code=self.f.root/'engineering/probe_scorer.py'
+        code.write_text('import json,sys\np=json.load(open(sys.argv[1]))["predictions"]\nv=sum(x["correct"] for x in p)/len(p)\nprint(json.dumps({"denominator":len(p),"native_metrics":{"accuracy":v,"scope":v}}))\n')
+        from fixtures import ref
+        self.c['scorer']['command']=[sys.executable,str(code),'{predictions}']
+        self.c['scorer']['code_refs']=[ref(self.f.root,'engineering/probe_scorer.py')]
+        self.v['adapter_scorer']={k:v for k,v in self.c['scorer'].items() if k!='verification_ref'};self.refresh()
+        from run_experiments import build_official_replay_context
+        execute=build_official_replay_context(self.f.root,lambda scope:True,timeout_seconds=10)
+        proofs,audits=N._replay_adapter_probes(self.f.root,self.c,execute)
+        self.assertEqual(len(audits),2)
+        self.assertTrue(all(a['exit_code']==0 for a in audits))
