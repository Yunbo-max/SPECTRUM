{"task_id": "Mbpp/852", "original_task_id": 852, "entry_point": "remove_negs", "prompt": "Write a python function to remove negative numbers from a list.\n\nImplement this Python function. Return only the complete implementation.\ndef remove_negs(num_list):\n    pass", "original_prompt": "Write a python function to remove negative numbers from a list.", "prompt_protocol": "mbpp-function-interface-v1", "interface_source": "reference-ast-signature-only", "reference": "def remove_negs(num_list): \r\n    for item in num_list: \r\n        if item < 0: \r\n           num_list.remove(item) \r\n    return num_list", "tests": "assert remove_negs([1,-2,3,-4]) == [1,3]\nassert remove_negs([1,2,3,-4]) == [1,2,3]\nassert remove_negs([4,5,-6,7,-8]) == [4,5,7]", "source": "google-research-datasets/mbpp", "split": "train", "original_split": "train", "dataset_config": "full", "revision": "4bb6404fdc6cacfda99d4ac4205087b89d32030c", "split_seed": 42, "dataset_fingerprint": null}
