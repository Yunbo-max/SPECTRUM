@@ -0,0 +1,123 @@
+"""Worker writes only its project mailbox; controller retains execution authority."""
+import json
+import os
+import tempfile
+import threading
+import time
+import unittest
+from pathlib import Path
+from research_autopilot.phase_mailbox import MailboxService, submit
+
+
+class MailboxTests(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.tmp.cleanup)
+        self.root = Path(self.tmp.name)
+        self.calls = []
+        self.release = threading.Event()
+
+    def service(self, execute=None):
+        def run(request):
+            self.calls.append(request)
+            return {'status': 'completed', 'receipt_refs': ['actual-fixture']}
+        s = MailboxService(self.root, execute or run, time.time() + 30)
+        self.addCleanup(s.close)
+        return s
+
+    def client(self, s, request):
+        path = self.root / ('input-' + str(time.time_ns()) + '.json')
+        path.write_text(json.dumps(request))
+        result = {}
+        def call():
+            try: result['value'] = submit(s.descriptor, path, poll_seconds=.01)
+            except Exception as exc: result['error'] = str(exc)
+        thread = threading.Thread(target=call)
+        thread.start()
+        return thread, result
+
+    def finish(self, s, thread):
+        end = time.monotonic() + 5
+        while thread.is_alive() and time.monotonic() < end:
+            s.poll()
+            time.sleep(.01)
+        thread.join(.1)
+        self.assertFalse(thread.is_alive())
+
+    def test_client_roundtrip_without_database_or_context_authority(self):
+        s = self.service()
+        request = {'request_id': 'stable', 'task': {'id': 'native'}}
+        thread, out = self.client(s, request)
+        self.finish(s, thread)
+        self.assertEqual(self.calls, [request])
+        self.assertEqual(out['value']['receipt_refs'], ['actual-fixture'])
+        self.assertNotIn('db', s.descriptor.read_text())
+
+    def test_native_errors_return_to_worker_and_next_call_can_proceed(self):
+        s = self.service(lambda request: (_ for _ in ()).throw(ValueError('invalid request')))
+        thread, out = self.client(s, {'request_id': 'bad'})
+        self.finish(s, thread)
+        self.assertIn('invalid request', out['error'])
+        self.assertFalse(s.busy)
+
+    def test_only_one_call_runs_while_parent_pumps(self):
+        def run(request):
+            self.calls.append(request)
+            self.release.wait(3)
+            return {'status': 'completed'}
+        s = self.service(run)
+        a, _ = self.client(s, {'request_id': 'one'})
+        b, _ = self.client(s, {'request_id': 'two'})
+        for _ in range(15): s.poll(); time.sleep(.01)
+        self.assertEqual(len(self.calls), 1)
+        self.assertTrue(s.busy)
+        self.release.set()
+        self.finish(s, a); self.finish(s, b)
+        self.assertEqual(len(self.calls), 2)
+
+    def test_close_prevents_late_submission(self):
+        s = self.service(); s.close()
+        thread, out = self.client(s, {'request_id': 'late'})
+        thread.join(2)
+        self.assertFalse(thread.is_alive())
+        self.assertIn('stopped', out['error'])
+        self.assertEqual(self.calls, [])
+
+    def test_parent_exit_drains_active_but_does_not_launch_queued(self):
+        s = self.service(lambda request: (self.release.wait(3) or True) and {'status': 'completed'})
+        a, out = self.client(s, {'request_id': 'one'})
+        for _ in range(10): s.poll(); time.sleep(.01)
+        self.assertTrue(s.busy)
+        self.release.set()
+        end = time.monotonic()+3
+        while s.busy and time.monotonic()<end: s.poll(accept=False); time.sleep(.01)
+        a.join(1)
+        self.assertEqual(out['value']['status'], 'completed')
+
+    def test_missing_live_service_fails_without_native_execution(self):
+        s = self.service()
+        status = self.root/'service.json'
+        data=json.loads(status.read_text()); data['heartbeat_at']=0
+        status.write_text(json.dumps(data))
+        thread, out=self.client(s, {'request_id':'one'})
+        thread.join(2)
+        self.assertFalse(thread.is_alive())
+        self.assertIn('heartbeat',out['error'])
+        self.assertEqual(self.calls,[])
+
+    def test_fifo_request_does_not_block_dispatcher_heartbeat(self):
+        s=self.service();call_id='a'*32
+        os.mkfifo(self.root/(call_id+'.request.json'))
+        s.poll()
+        result=json.loads((self.root/(call_id+'.response.json')).read_text())
+        self.assertIn('regular files',result['message'])
+        self.assertEqual(self.calls,[])
+
+    def test_replaced_directory_cannot_redirect_controller_writes(self):
+        root=self.root/'mailbox';outside=self.root/'outside';outside.mkdir()
+        s=MailboxService(root,lambda r:{},time.time()+30)
+        self.addCleanup(s.close)
+        original=self.root/'original';root.rename(original);root.symlink_to(outside)
+        s._heartbeat()
+        self.assertFalse((outside/'service.json').exists())
+        self.assertTrue((original/'service.json').exists())
