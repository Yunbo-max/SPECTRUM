{"task_id": "Mbpp/963", "original_task_id": 963, "entry_point": "discriminant_value", "prompt": "Write a function to calculate the discriminant value.\n\nImplement this Python function. Return only the complete implementation.\ndef discriminant_value(x, y, z):\n    pass", "original_prompt": "Write a function to calculate the discriminant value.", "prompt_protocol": "mbpp-function-interface-v1", "interface_source": "reference-ast-signature-only", "reference": "def discriminant_value(x,y,z):\r\n    discriminant = (y**2) - (4*x*z)\r\n    if discriminant > 0:\r\n        return (\"Two solutions\",discriminant)\r\n    elif discriminant == 0:\r\n        return (\"one solution\",discriminant)\r\n    elif discriminant < 0:\r\n        return (\"no real solution\",discriminant)", "tests": "assert discriminant_value(4,8,2)==(\"Two solutions\",32)\nassert discriminant_value(5,7,9)==(\"no real solution\",-131)\nassert discriminant_value(0,0,9)==(\"one solution\",0)", "source": "google-research-datasets/mbpp", "split": "calibration", "original_split": "train", "dataset_config": "full", "revision": "4bb6404fdc6cacfda99d4ac4205087b89d32030c", "split_seed": 42, "dataset_fingerprint": null}
