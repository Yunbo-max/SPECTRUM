+
+    def test_malformed_requirements_never_probe(self):
+        for update in ({'gpu_count': True}, {'gpu_count': 0}, {'gpu_count': 129},
+                       {'stage': 'all'}, {'precision': 'auto'}, {'precision': []},
+                       {'min_free_vram_mib': -1}, {'min_free_vram_mib': True},
