@@ -0,0 +1,101 @@
+"""Explicit phase-sized research work, with retained milestone evidence.
+
+No scientific verdict is implied by grouping. B01 setup, G02 freeze, B05/M05
+scientific gates, optional-scope boundaries and closure remain real boundaries.
+"""
+from .models import ContractError
+
+MODE = 'phase_autonomy'
+# Inclusive end points, in canonical order; no extra agent at interior milestones.
+ENDS = {'P03', 'R03', 'X01', 'L05', 'B01', 'B05', 'M05', 'G02',
+        'G05', 'V06', 'W09', 'R05', 'A05', 'C05', 'P05'}
+
+
+def enabled(contract):
+    value = contract.get('sequence', {}).get('execution_mode')
+    if value not in (None, MODE):
+        raise ContractError('unknown sequence execution_mode')
+    if value == MODE and contract['sequence'].get('flow_profile') != 'work-harness-cd-v1':
+        raise ContractError('phase autonomy requires the adopted Work Harness C/D profile')
+    return value == MODE
+
+
+def expand(catalog, prior, step):
+    if (not enabled(prior['contract']) or step['id'] == 'cycle-closure'
+            or prior['state']['sequence'].get('visit')
+            or step['scope'] not in prior['contract']['sequence']['scopes']):
+        return step
+    steps = catalog['steps']
+    start = next(i for i, s in enumerate(steps) if s['id'] == step['id'])
+    members = []
+    for member in steps[start:]:
+        if member['scope'] != step['scope']:
+            break
+        members.append(member)
+        if member['id'] in ENDS:
+            break
+    if len(members) < 2:
+        result = dict(step)
+    else:
+        result = {**step, 'name': 'Sustained phase: ' + members[0]['id'] + ' through ' + members[-1]['id'],
+        'milestone_ids': [s['id'] for s in members],
+        'gate_step_id': members[-1]['id'],
+        'allows_native': any(s['allows_native'] for s in members),
+        'sources': list(dict.fromkeys(n for s in members for n in s['sources'])),
+        'requirements': [{'id': s['id'] + '.' + req['id'], 'description': req['description']}
+                         for s in members for req in s['requirements']]}
+    if step['id'] in {'S01', 'E01', 'B02', 'B03', 'B04', 'B05'}:
+        result.setdefault('milestone_ids', [step['id']])
+        result.setdefault('gate_step_id', step['id'])
+        result['requirements'] = [*result['requirements'], {'id': 'C.method_basis',
+            'description': 'Ground C in core papers and their actual official code revisions, entry points and settings; identify task-relevant strong methods and simple controls with selection/exclusion reasons, benchmark/model/data/native-evaluation bindings. Cite pinned source/code evidence. Verify enabled Xiaohongshu implementation leads against primary sources/code; retain unavailable-access and reproduction gaps explicitly. Project self-training controls alone do not satisfy this requirement.'}]
+    return result
+
+
+def gate(step):
+    return step.get('gate_step_id', step['id'])
+
+
+INSTRUCTIONS = """
+Execution mode: phase_autonomy. The assigned milestone_ids form ONE sustained
+research assignment. They describe coverage, not a sequence of small agent tasks.
+Read papers/code, search enabled discussion sources, derive mathematics, design,
+implement, run GPU diagnostics/experiments, debug and revise within this worker.
+Return to any B source or earlier local reasoning whenever useful without a new
+worker/reviewer. Keep a concise research log and negative results.
+Restore phase_progress: each new native selection and the final result must extend
+its latest decision_ref and coverage_ref, including after interrupted transports. Only reopening
+an already accepted scientific gate needs a typed reviewed revisit.
+
+Use response_protocol.phase_native to run real registered native work while this
+worker remains alive. This routes through the fixed target, canonical admission,
+actual NativeWorker and retained receipts. Never manufacture future run IDs,
+receipts, reviews or successful observations. Synchronize pinned inputs to the
+fixed GPU target before dispatch; use its existing environment/models/data. All
+code tests and research computation run there, not on the supervisor computer.
+Only one native experiment can run at a time. Inspect failures and repair within
+this assignment; no separate model review for each edit, preparation or GPU call.
+
+Return tasks=[] only for a meaningful phase result or an evidence-based typed
+revisit, with findings for every assigned requirement. Do NOT propose source_read,
+experiment_design or candidate_code child agents. If the transport is interrupted,
+retain the same phase, checkpoint and actual native identities for recovery;
+never claim a completed phase merely because the invocation ended.
+B05 still requires actual problem evidence and scorer verification; M05 still
+requires independent VERIFIED_FOR_SCALEUP acceptance. E retains protocol freeze,
+fair comparison, broader validation and full execution. No arbitrary round cap.
+
+C starts with a concrete literature-to-code method basis: nearest core papers,
+official repository revisions/entry points/settings, task-relevant strong methods,
+benchmark/model/data/native evaluation, and verified discussion implementation
+leads. Read implementation before choosing diagnostic conditions. Cite selection
+and exclusion reasons; unavailable code or an unqualified reproduction is explicit.
+Existing project self-training controls are not a substitute for these methods.
+Do not call a method current SOTA without verifying primary evidence for the exact
+task/protocol. Xiaohongshu discussions are leads to check against paper/code and
+GPU observations, never scientific proof. Reuse the user's read-only opt-in.
+C tests mathematically specified failure modes or unnecessary dependencies under
+plausible conditions; D derives and tests a mechanism under those conditions.
+Iterate B/C/D as evidence requires. Keep native evaluation, strong simple controls,
+uncertainty, confounds, practical effect sizes and negative boundaries in scope.
+"""
