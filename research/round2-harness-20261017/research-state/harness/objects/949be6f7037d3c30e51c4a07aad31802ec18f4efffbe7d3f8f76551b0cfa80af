{"task_id": "Mbpp/940", "original_task_id": 940, "entry_point": "heap_sort", "prompt": "Write a function to sort the given array by using heap sort.\n\nImplement this Python function. Return only the complete implementation.\ndef heap_sort(arr):\n    pass", "original_prompt": "Write a function to sort the given array by using heap sort.", "prompt_protocol": "mbpp-function-interface-v1", "interface_source": "reference-ast-signature-only", "reference": "def heap_sort(arr):\r\n    heapify(arr)  \r\n    end = len(arr) - 1\r\n    while end > 0:\r\n        arr[end], arr[0] = arr[0], arr[end]\r\n        shift_down(arr, 0, end - 1)\r\n        end -= 1\r\n    return arr\r\n\r\ndef heapify(arr):\r\n    start = len(arr) // 2\r\n    while start >= 0:\r\n        shift_down(arr, start, len(arr) - 1)\r\n        start -= 1\r\ndef shift_down(arr, start, end):\r\n    root = start\r\n    while root * 2 + 1 <= end:\r\n        child = root * 2 + 1\r\n        if child + 1 <= end and arr[child] < arr[child + 1]:\r\n            child += 1\r\n        if child <= end and arr[root] < arr[child]:\r\n            arr[root], arr[child] = arr[child], arr[root]\r\n            root = child\r\n        else:\r\n            return\r\n", "tests": "assert heap_sort([12, 2, 4, 5, 2, 3]) == [2, 2, 3, 4, 5, 12]\nassert heap_sort([32, 14, 5, 6, 7, 19]) == [5, 6, 7, 14, 19, 32]\nassert heap_sort([21, 15, 29, 78, 65]) == [15, 21, 29, 65, 78]", "source": "google-research-datasets/mbpp", "split": "train", "original_split": "train", "dataset_config": "full", "revision": "4bb6404fdc6cacfda99d4ac4205087b89d32030c", "split_seed": 42, "dataset_fingerprint": null}
{"task_id": "Mbpp/934", "original_task_id": 934, "entry_point": "dealnnoy_num", "prompt": "Write a function to find the nth delannoy number.\n\nImplement this Python function. Return only the complete implementation.\ndef dealnnoy_num(n, m):\n    pass", "original_prompt": "Write a function to find the nth delannoy number.", "prompt_protocol": "mbpp-function-interface-v1", "interface_source": "reference-ast-signature-only", "reference": "def dealnnoy_num(n, m): \r\n\tif (m == 0 or n == 0) : \r\n\t\treturn 1\r\n\treturn dealnnoy_num(m - 1, n) + dealnnoy_num(m - 1, n - 1) + dealnnoy_num(m, n - 1)", "tests": "assert dealnnoy_num(3, 4) == 129\nassert dealnnoy_num(3, 3) == 63\nassert dealnnoy_num(4, 5) == 681", "source": "google-research-datasets/mbpp", "split": "train", "original_split": "train", "dataset_config": "full", "revision": "4bb6404fdc6cacfda99d4ac4205087b89d32030c", "split_seed": 42, "dataset_fingerprint": null}
{"task_id": "Mbpp/653", "original_task_id": 653, "entry_point": "grouping_dictionary", "prompt": "Write a function to group a sequence of key-value pairs into a dictionary of lists using collections module.\n\nImplement this Python function. Return only the complete implementation.\ndef grouping_dictionary(l):\n    pass", "original_prompt": "Write a function to group a sequence of key-value pairs into a dictionary of lists using collections module.", "prompt_protocol": "mbpp-function-interface-v1", "interface_source": "reference-ast-signature-only", "reference": "from collections import defaultdict\r\ndef grouping_dictionary(l):\r\n    d = defaultdict(list)\r\n    for k, v in l:\r\n        d[k].append(v)\r\n    return d", "tests": "assert grouping_dictionary([('yellow', 1), ('blue', 2), ('yellow', 3), ('blue', 4), ('red', 1)])== ({'yellow': [1, 3], 'blue': [2, 4], 'red': [1]})\nassert grouping_dictionary([('yellow', 10), ('blue', 20), ('yellow', 30), ('blue', 40), ('red', 10)])== ({'yellow': [10, 30], 'blue': [20, 40], 'red': [10]})\nassert grouping_dictionary([('yellow', 15), ('blue', 25), ('yellow', 35), ('blue', 45), ('red', 15)])== ({'yellow': [15, 35], 'blue': [25, 45], 'red': [15]})", "source": "google-research-datasets/mbpp", "split": "train", "original_split": "train", "dataset_config": "full", "revision": "4bb6404fdc6cacfda99d4ac4205087b89d32030c", "split_seed": 42, "dataset_fingerprint": null}
