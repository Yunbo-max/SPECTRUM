+"""Real SQLite worker/reviewer ownership for a shared phase receipt; software only."""
+import copy,json,unittest
+import test_cd_flow as base
+from test_controller import task
+from research_autopilot import skill_sequence as seq, phase_autonomy
+from research_autopilot.program import save_artifact
+from research_autopilot.artifacts import canonical_json
+from research_autopilot.models import ContractError
+
+
+class PhaseAcceptanceTests(base.CDFlowTests):
+
+    def accepted_phase(self):
+        self.config['sequence']['execution_mode']='phase_autonomy'
+        state=self.prior['state'];state['sequence'].update(index=10,step_id='L01',attempt=1,
+            accepted=[self.instruction]*10,inherited_acceptance_count=10)
+        state['cd_adoption_ref']=save_artifact(self.root,'adoption.json',{'previous_state':copy.deepcopy(state)})
+        state.update(planner_task_id='harness.planner.phase',reviewer_task_id='harness.reviewer.phase',
+                     stage='planner',accepted_decision_ref=None)
+        step=phase_autonomy.expand(self.catalog,self.prior,self.catalog['steps'][10])
+        selected=seq.binding(state)
+        result={'kind':'research-skill-step-result','schema_version':1,'goal_id':'goal','sequence':selected,
+            'summary':'Synthetic source phase software fixture','findings':[{'requirement_id':r['id'],
+                'finding':'Synthetic evidence binding','evidence_refs':[self.instruction]} for r in step['requirements']],
+            'tasks':[],'decision_ref':None,'coverage_ref':self.instruction}
+        result_ref=save_artifact(self.root,'phase/result.json',result)
+        proposal_ref=save_artifact(self.root,'phase/proposal.json',{'goal_id':'goal','status':'wait',
+            'tasks':[],'decision_ref':None,'coverage_ref':self.instruction})
+        review={'kind':'research-skill-step-review','schema_version':1,'goal_id':'goal','sequence':selected,
+            'result_ref':result_ref,'proposal_ref':proposal_ref,'approved':True,'summary':'Synthetic independent fixture',
+            'requirements':[{'requirement_id':r['id'],'satisfied':True,'reason':'Pinned fixture',
+                             'evidence_refs':[self.instruction]} for r in step['requirements']]}
+        review_ref=save_artifact(self.root,'phase/review.json',review)
+        state['sequence']['result_ref']=result_ref
+        state.update(proposal_ref=proposal_ref,review_ref=review_ref)
+        def put_state():
+            with self.controller._transaction() as db:
+                db.execute('UPDATE research_programs SET contract=?,state=? WHERE project_id=?',
+                    (canonical_json(self.config),canonical_json(state),'p'))
+        for role,ref,action in [('planner',result_ref,'source_read'),('reviewer',review_ref,'math_review')]:
+            state['stage']=role;put_state()
+            t=task(state[role+'_task_id'],action=action,adapter='codex',max_cost=0,outputs=[ref['path']],
+                   parameters={'harness_role':role,'sequence_binding':selected,'phase_autonomy':True})
+            self.controller.register_task('p',t)
+            claimed=self.controller.claim('p','actual-fixture-'+role,adapter='codex',task_ids=[t['task_id']])
+            self.assertIsNotNone(claimed)
+            item=self.controller.complete(claimed['run_id'],claimed['owner'],claimed['fence'],actual_cost=0,actual_seconds=1)
+        self.prior=self.program.status('p')
+        outcome=seq._advance(self.program,self.prior,self.project,self.catalog,step,item=item)
+        self.prior=outcome['program']
+        return self.prior
+
+    def test_one_worker_and_reviewer_accept_all_milestones_with_auditable_shared_record(self):
+        prior=self.accepted_phase()
+        self.assertEqual(prior['state']['sequence']['step_id'],'B01')
+        refs=prior['state']['sequence']['accepted'][10:17]
+        self.assertEqual(len(refs),7);self.assertEqual(refs,[refs[0]]*7)
+        seq._audit_acceptances(self.program,prior,self.project,self.catalog)
+        self.assertEqual(len(self.controller.status('p')['tasks']),2)
+
+    def test_phase_audit_rejects_partial_or_substituted_shared_history(self):
+        prior=self.accepted_phase()
+        for tamper in ('partial','substitute'):
+            altered=copy.deepcopy(prior)
+            if tamper=='partial':altered['state']['sequence']['accepted'].pop()
+            else:altered['state']['sequence']['accepted'][12]=self.instruction
+            with self.assertRaisesRegex(ContractError,'contiguous milestone'):
+                seq._audit_acceptances(self.program,altered,self.project,self.catalog)
+
+for parent in base.CDFlowTests.__mro__:
+    if parent is unittest.TestCase: break
+    for name in parent.__dict__:
+        if name.startswith("test_") and name not in PhaseAcceptanceTests.__dict__:
+            setattr(PhaseAcceptanceTests, name, None)
