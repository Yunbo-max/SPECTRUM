{"task_id": "Mbpp/665", "original_task_id": 665, "entry_point": "move_last", "prompt": "Write a python function to shift first element to the end of given list.\n\nImplement this Python function. Return only the complete implementation.\ndef move_last(num_list):\n    pass", "original_prompt": "Write a python function to shift first element to the end of given list.", "prompt_protocol": "mbpp-function-interface-v1", "interface_source": "reference-ast-signature-only", "reference": "def move_last(num_list):\r\n    a = [num_list[0] for i in range(num_list.count(num_list[0]))]\r\n    x = [ i for i in num_list if i != num_list[0]]\r\n    x.extend(a)\r\n    return (x)", "tests": "assert move_last([1,2,3,4]) == [2,3,4,1]\nassert move_last([2,3,4,1,5,0]) == [3,4,1,5,0,2]\nassert move_last([5,4,3,2,1]) == [4,3,2,1,5]", "source": "google-research-datasets/mbpp", "split": "train", "original_split": "train", "dataset_config": "full", "revision": "4bb6404fdc6cacfda99d4ac4205087b89d32030c", "split_seed": 42, "dataset_fingerprint": null}
