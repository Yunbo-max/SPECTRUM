new file mode 100644
index 0000000..cd8a27a
--- /dev/null
+++ b/src/research_autopilot/phase_mailbox.py
@@ -0,0 +1,192 @@
+"""Project-local submission transport. Only the owning dispatcher opens the DB."""
+import argparse
+from concurrent.futures import ThreadPoolExecutor
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import stat
+import sys
+import time
+import uuid
+
+MAX_BYTES = 2 * 1024 * 1024
+
+
+def _read(path, *, dir_fd=None):
+    fd = os.open(path.name if dir_fd is not None else path,
+                 os.O_RDONLY | os.O_NONBLOCK | os.O_NOFOLLOW, dir_fd=dir_fd)
+    with os.fdopen(fd, 'rb') as stream:
+        if not stat.S_ISREG(os.fstat(stream.fileno()).st_mode):
+            raise ValueError('mailbox messages must be regular files')
+        raw = stream.read(MAX_BYTES + 1)
+    if len(raw) > MAX_BYTES:
+        raise ValueError('mailbox message exceeds byte limit')
+    value = json.loads(raw)
+    if not isinstance(value, dict):
+        raise ValueError('mailbox message must be an object')
+    return value
+
+
+def _bytes(value):
+    raw = json.dumps(value, sort_keys=True, separators=(',', ':'), allow_nan=False).encode()
+    if len(raw) > MAX_BYTES:
+        raise ValueError('mailbox message exceeds byte limit')
+    return raw
+
+
+def _write(path, value, *, replace=False, dir_fd=None):
+    raw = _bytes(value)
+    temp = path.with_name('.' + uuid.uuid4().hex + '.tmp')
+    try:
+        target = path.name if dir_fd is not None else path
+        temporary = temp.name if dir_fd is not None else temp
+        fd = os.open(temporary, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600, dir_fd=dir_fd)
+        with os.fdopen(fd, 'wb') as stream:
+            stream.write(raw); stream.flush(); os.fsync(stream.fileno())
+        if replace:
+            os.replace(temporary, target, src_dir_fd=dir_fd, dst_dir_fd=dir_fd)
+        else:
+            os.link(temporary, target, src_dir_fd=dir_fd, dst_dir_fd=dir_fd)
+    finally:
+        try: os.unlink(temporary, dir_fd=dir_fd)
+        except FileNotFoundError: pass
+
+
+def descriptor(directory, deadline):
+    directory = Path(directory)
+    directory.mkdir(mode=0o700, parents=True, exist_ok=True)
+    path = directory / 'mailbox.json'
+    _write(path, {'protocol': 'phase-mailbox-v1', 'deadline_unix': deadline})
+    return path
+
+
+def submit(mailbox, request_path, *, poll_seconds=.25):
+    """Submit without Controller construction, DB access or execution authority."""
+    mailbox = Path(mailbox)
+    info = _read(mailbox)
+    if info.get('protocol') != 'phase-mailbox-v1':
+        raise ValueError('unsupported phase mailbox')
+    directory = mailbox.parent
+    request = _read(Path(request_path))
+    digest = hashlib.sha256(_bytes(request)).hexdigest()
+    call_id = uuid.uuid4().hex
+    submitted = False
+    while True:
+        response = directory / (call_id + '.response.json')
+        if response.exists():
+            data = _read(response)
+            if data.get('request_digest') != digest or data.get('call_id') != call_id:
+                raise ValueError('mailbox response identity mismatch')
+            if 'error' in data:
+                raise RuntimeError(data['error'] + ': ' + data.get('message', ''))
+            return data['result']
+        if time.time() >= info['deadline_unix']:
+            raise TimeoutError('parent deadline reached; retain request identity and reconcile')
+        status = _read(directory / 'service.json')
+        if status.get('state') != 'running':
+            raise RuntimeError('owning dispatcher stopped; retain request identity and reconcile')
+        if time.time() - status['heartbeat_at'] > 30:
+            raise RuntimeError('dispatcher heartbeat missing; retain request identity and reconcile')
+        if not submitted:
+            _write(directory / (call_id + '.request.json'), request)
+            submitted = True
+        time.sleep(poll_seconds)
+
+
+class MailboxService:
+    """One native call at a time; authority is an in-memory controller closure."""
+    def __init__(self, directory, execute, deadline):
+        self.root = Path(directory)
+        self.descriptor = self.root / 'mailbox.json'
+        if not self.descriptor.exists():
+            descriptor(self.root, deadline)
+        # Keep directory identity even if the worker renames/replaces its path.
+        self.dir_fd = os.open(self.root, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
+        self.execute, self.deadline = execute, deadline
+        self.pool = ThreadPoolExecutor(max_workers=1, thread_name_prefix='phase-native')
+        self.active = None
+        self.seen = set()
+        self.closed = False
+        self.last_heartbeat = 0
+        self._heartbeat()
+
+    @property
+    def busy(self):
+        return self.active is not None
+
+    def _heartbeat(self):
+        _write(self.root / 'service.json', {'state': 'stopped' if self.closed else 'running',
+            'heartbeat_at': time.time()}, replace=True, dir_fd=self.dir_fd)
+        self.last_heartbeat = time.monotonic()
+
+    def poll(self, *, accept=True):
+        if self.closed:
+            return
+        if time.monotonic() - self.last_heartbeat >= 1:
+            self._heartbeat()
+        if self.active:
+            call_id, digest, future = self.active
+            if not future.done():
+                return
+            value = {'call_id': call_id, 'request_digest': digest}
+            try:
+                value['result'] = future.result()
+            except Exception as exc:
+                value.update(error=type(exc).__name__, message=str(exc))
+            _write(self.root / (call_id + '.response.json'), value, dir_fd=self.dir_fd)
+            self.active = None
+        if not accept or time.time() >= self.deadline:
+            return
+        names = set(os.listdir(self.dir_fd))
+        for name in sorted(names):
+            if not name.endswith('.request.json'):
+                continue
+            path = self.root / name
+            call_id = path.name.removesuffix('.request.json')
+            if not re.fullmatch('[a-f0-9]{32}', call_id) or call_id in self.seen:
+                continue
+            self.seen.add(call_id)
+            if call_id + '.response.json' in names:
+                continue
+            try:
+                request = _read(path, dir_fd=self.dir_fd)
+                digest = hashlib.sha256(_bytes(request)).hexdigest()
+            except Exception as exc:
+                _write(self.root / (call_id + '.response.json'), {
+                    'call_id': call_id, 'request_digest': None,
+                    'error': type(exc).__name__, 'message': str(exc)}, dir_fd=self.dir_fd)
+                continue
+            self.active = (call_id, digest, self.pool.submit(self.execute, request))
+            return
+
+    def close(self):
+        if not self.closed:
+            self.closed = True
+            try:
+                self._heartbeat()
+            except OSError:
+                pass  # Do not mask the original failure or prevent child cleanup.
+            finally:
+                # Interrupted native work retains its original controller identity.
+                self.pool.shutdown(wait=False, cancel_futures=True)
+                os.close(self.dir_fd)
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--mailbox', required=True)
+    parser.add_argument('--request', required=True)
+    args = parser.parse_args()
+    try:
+        print(json.dumps(submit(args.mailbox, args.request)))
+    except Exception as exc:
+        print(json.dumps({'error': type(exc).__name__, 'message': str(exc),
+                          'status': 'submission_failed'}))
+        return 2
+    return 0
+
+
+if __name__ == '__main__':
+    sys.exit(main())
