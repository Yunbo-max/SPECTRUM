+            code = G.main(['--target', str(root / 'target.json'), '--requirements',
+                           str(root / 'requirements.json'), '--output', str(root / 'report.json')])
+            self.assertEqual(code, 2)
+            self.assertEqual(json.loads((root / 'report.json').read_text())['status'], 'blocked')
