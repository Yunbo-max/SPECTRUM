+"""Software fixtures only; these tests are not scientific research evidence."""
+import copy
+import unittest
+from research_autopilot import cd_flow as flow
+from research_autopilot import skill_sequence as seq
+from research_autopilot.models import ContractError
+from research_autopilot.program import save_artifact, read_json
+import test_b01_qualification as base
+
+
+class CDFlowTests(base.B01QualificationTests):
+    # Reuse setup, not inherited old-profile tests.
+    def setUp(self):
+        super().setUp()
+        self.config = copy.deepcopy(self.contract)
+        self.config['sequence']['flow_profile'] = flow.PROFILE
+        self.catalog, ref = seq._catalog(self.project, flow.PROFILE)
+        self.seq = seq.validate_sequence(self.project, self.config)
+        self.seq.update(index=20, step_id='B02', accepted=[self.instruction] * 20, attempt=4)
+        self.prior = {'project_id': 'p', 'revision': 7, 'contract': self.config,
+                      'state': {**copy.deepcopy(self.state), 'sequence': self.seq}}
+
+    def request(self, target='L04', mode='visit', **kw):
+        return {'mode': mode, 'origin': seq.binding(self.prior['state']), 'target': target,
+                'return_to': self.seq['step_id'] if mode == 'visit' else None,
+                'reason': 'Trace causal explanation in implementation',
+                'expected_output': 'Pinned source and discriminating intervention',
+                'evidence_refs': [self.instruction], **kw}
+
+    def test_profile_is_explicit_and_old_catalog_is_unchanged(self):
+        old, oldref = seq._catalog(self.project)
+        self.assertNotEqual(oldref['sha256'], self.seq['catalog_sha256'])
+        self.assertEqual(len(self.catalog['steps']), 84)
+        self.assertEqual([x['id'] for x in old['steps']], [x['id'] for x in self.catalog['steps']])
+        self.assertNotIn('flow_profile', seq.binding(self.state))
+        self.assertEqual(seq.binding(self.prior['state'])['flow_profile'], flow.PROFILE)
+        with self.assertRaises(ContractError): seq._catalog(self.project, 'invented')
+
+    def test_c_and_d_allow_design_code_without_engineering_failure(self):
+        for key in ['B02', 'B03', 'B04', 'B05', 'H01', 'M02', 'M05']:
+            step = next(x for x in self.catalog['steps'] if x['id'] == key)
+            allowed = seq._allowed_actions(self.program, self.project, self.prior['state'], step, self.config)
+            self.assertTrue({'native_harness', 'candidate_code', 'experiment_design'} <= allowed)
+
+    def test_visit_returns_to_origin_preserving_canonical_history_and_budget(self):
+        before = copy.deepcopy(self.prior['state'])
+        req = self.request()
+        flow.validate_revisit(self.project, self.prior, req)
+        flow.apply_revisit(self.project, self.prior, req, self.instruction, self.instruction)
+        self.assertEqual(self.seq['step_id'], 'L04')
+        self.assertEqual(self.seq['epoch'], 2)
+        self.assertEqual(self.seq['accepted'], before['sequence']['accepted'])
+        flow.return_from_visit(self.project, self.prior, self.instruction)
+        self.assertEqual(self.seq['step_id'], 'B02')
+        self.assertEqual(self.seq['epoch'], 3)
+        self.assertEqual(self.seq['accepted'], before['sequence']['accepted'])
+        for key in ('round', 'consumed_runs', 'coverage_ref', 'accepted_decision_ref'):
+            self.assertEqual(self.prior['state'][key], before[key])
+
+    def test_visit_rejects_forward_jump_stale_origin_nested_or_tasks(self):
+        for req in [self.request('G04'), self.request(return_to='M05'), self.request(origin=seq.binding(self.state))]:
+            with self.assertRaises(ContractError): flow.validate_revisit(self.project, self.prior, req)
+        flow.apply_revisit(self.project, self.prior, self.request(), self.instruction, self.instruction)
+        with self.assertRaises(ContractError): flow.validate_revisit(self.project, self.prior, self.request())
+
+    def test_rewind_retains_invalidated_evidence_and_clears_gates(self):
+        self.seq.update(index=30, step_id='M02', accepted=[self.instruction] * 30,
+                        problem_ref=self.instruction, verified_ref=self.instruction)
+        req = self.request('B02', 'revise')
+        flow.validate_revisit(self.project, self.prior, req)
+        flow.apply_revisit(self.project, self.prior, req, self.instruction, self.instruction)
+        self.assertEqual(self.seq['index'], 20)
+        self.assertEqual(len(self.seq['accepted']), 20)
+        self.assertIsNone(self.seq['problem_ref'])
+        self.assertIsNone(self.seq['verified_ref'])
+        record = read_json(self.root, self.seq['revisit_refs'][-1])
+        self.assertEqual(record['invalidated_acceptance_refs'], [self.instruction] * 10)
+
+    def test_epoch_separates_attempt_paths_and_survives_cursor_restore(self):
+        before = seq._step_prefix(self.prior['state'])
+        flow.apply_revisit(self.project, self.prior, self.request(), self.instruction, self.instruction)
+        flow.return_from_visit(self.project, self.prior, self.instruction)
+        self.seq['attempt'] = 4
+        self.assertNotEqual(before, seq._step_prefix(self.prior['state']))
+        seq._cursor(self.project, self.prior)
+
+    def test_development_gate_requires_real_completed_native_receipt(self):
+        with self.assertRaises(ContractError):
+            flow.validate_gate(self.program, self.prior, self.project, 'M05', self.instruction)
+
+    def test_forged_profile_in_state_cannot_select_new_catalog(self):
+        prior = copy.deepcopy(self.prior)
+        prior['contract'] = self.contract
+        with self.assertRaises(ContractError): seq._cursor(self.project, prior)
+
+    def test_quiet_adoption_preserves_state_history_and_rejects_stale_revision(self):
+        # Old B01 accepted history is retained in the immutable adoption record;
+        # the new profile starts at C, so old C evidence is never auto-certified.
+        adopted = self.program.adopt_cd_flow('p', self.instruction, expected_revision=7)
+        self.assertEqual(adopted['contract']['sequence']['flow_profile'], flow.PROFILE)
+        self.assertEqual(adopted['state']['sequence']['step_id'], 'B01')
+        self.assertEqual(adopted['state']['round'], self.state['round'])
+        self.assertEqual(adopted['state']['consumed_runs'], self.state['consumed_runs'])
+        receipt = read_json(self.root, adopted['state']['cd_adoption_ref'])
+        self.assertEqual(receipt['previous_state'], self.state)
+        with self.assertRaises(ContractError):
+            self.program.adopt_cd_flow('p', self.instruction, expected_revision=7)
+
+    def test_adoption_rejects_pending_or_paused(self):
+        from test_controller import task
+        self.controller.register_task('p', task('pending', action='source_read', adapter='codex'))
+        with self.assertRaises(ContractError):
+            self.program.adopt_cd_flow('p', self.instruction, expected_revision=7)
+
+
+# Do not re-run inherited fixture tests as new-profile assertions.
+for name in list(base.B01QualificationTests.__dict__):
+    if name.startswith('test_') and name not in CDFlowTests.__dict__:
+        setattr(CDFlowTests, name, None)
+
+class CDReviewRegressionTests(CDFlowTests):
+    def test_inherited_cycle_receipt_uses_original_adoption_catalog(self):
+        # This function must explicitly validate the original cycle receipt pin,
+        # without comparing it to a new profile's catalog bytes.
+        old_catalog, old_ref = seq._catalog(self.project)
+        previous = copy.deepcopy(self.state)
+        previous['sequence']['cycle_receipts'] = [self.instruction]
+        adoption = save_artifact(self.root, 'adopted-history.json', {'previous_state': previous})
+        self.prior['state']['cd_adoption_ref'] = adoption
+        self.assertTrue(flow.inherited_cycle(self.project, self.prior, 0, self.instruction))
+        with self.assertRaises(ContractError):
+            flow.inherited_cycle(self.project, self.prior, 0, self.target)
+        self.assertFalse(flow.inherited_cycle(self.project, self.prior, 1, self.target))
+
+    def test_scaleup_e_obligations_are_actual_unsatisfied_coverage_ids(self):
+        coverage = save_artifact(self.root, 'coverage-e.json', {'obligations': [
+            {'id': 'confirm', 'kind': 'experiment', 'status': 'pending'},
+            {'id': 'variance', 'kind': 'scoring', 'status': 'pending'},
+            {'id': 'already', 'kind': 'experiment', 'status': 'satisfied'}]})
+        flow.check_e_obligations(self.project, ['confirm', 'variance'], coverage)
+        for ids in (['madeup prose'], ['already'], ['confirm', 'confirm']):
+            with self.assertRaises(ContractError): flow.check_e_obligations(self.project, ids, coverage)
+
+    def test_scaleup_needs_fixed_scoring_verifier_not_only_native_exit_zero(self):
+        with self.assertRaises(ContractError):
+            flow.require_scoring_verification(self.program, self.prior, self.project, self.instruction)
