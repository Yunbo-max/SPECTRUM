+"""Software-only scorer fixtures; run on the authorized GPU host, never research evidence."""
+import copy
+import json
+from pathlib import Path
+import subprocess
+import sys
+import unittest
+
+ROOT = Path(__file__).resolve().parents[2]
+SKILL = ROOT / 'skills/research-autopilot'
+sys.path.insert(0, str(SKILL / 'tests'))
+from fixtures import C, ProjectFixture, write, ref
+from test_native_eval import native_run_fixture
+from research_autopilot.artifacts import digest_tree, canonical_json
+from research_autopilot.cd_verification import execute_cd_verification
+from research_autopilot.models import ContractError
+from research_autopilot import closure_worker
+
+
+class CDVerificationTests(unittest.TestCase):
+    def setUp(self):
+        self.f = ProjectFixture()
+        self.addCleanup(self.f.close)
+        self.root = self.f.root
+        self.p = self.f.protocol()
+        scorer_path = self.root / 'engineering/native/actual_fixture_scorer.py'
+        scorer_path.write_text('''# Synthetic software fixture scorer, not benchmark evidence.
+import json,sys
+rows=json.load(open(sys.argv[1]))['predictions']
+metrics={k:sum(row['fixture_values'][k] for row in rows)/len(rows) for k in ('accuracy','scope')}
+print(json.dumps({'denominator':len(rows),'native_metrics':metrics}))
+''')
+        contract = self.p['native_eval_contract']
+        scorer = contract['scorer']
+        scorer['code_refs'] = [ref(self.root, str(scorer_path.relative_to(self.root)))]
+        scorer['command'] = [sys.executable, str(scorer_path), '{predictions}', '{samples}', '{labels}']
+        definition_ref = contract['native_definition_ref']
+        definition = C.load_file(C.verify_ref(self.root, definition_ref))
+        definition['scorer'] = copy.deepcopy(scorer)
+        contract['native_definition_ref'] = write(self.root, definition_ref['path'], definition)
+        self.p['protocol_digest'] = C.protocol_hash(self.p)
+        self.m = self.f.runs(self.p)[0][0]
+        self.fill_predictions()
+        self.project = {'project_id': 'fixture', 'root': str(self.root),
+            'workflow_class': 'scientific_method', 'role': 'local_executor',
+            'skill_root': str(SKILL), 'skill_digest': digest_tree(SKILL)}
+        self.protocol_ref = write(self.root, 'cd/protocol.json', self.p)
+        self.manifest_ref = write(self.root, 'cd/manifest.json', self.m)
+        self.scored = [{'protocol_ref': self.protocol_ref, 'manifest_ref': self.manifest_ref}]
+        self.gate = {'kind': 'research-cd-scaleup', 'schema_version': 1, 'goal_id': 'fixture-goal',
+                     'scored_runs': self.scored}
+        self.packet = {'kind': 'research-cd-verification-request', 'schema_version': 1,
+            'goal_id': 'fixture-goal', 'proposal_ref': write(self.root, 'cd/proposal.json', {'goal_id': 'fixture-goal'}),
+            'coverage_ref': write(self.root, 'cd/coverage.json', {'goal_id': 'fixture-goal'}),
+            'bindings': [], 'timeout_seconds': 30,
+            'native_target_ref': write(self.root, 'cd/target.json', {'host': 'authorized-test-gpu',
+                'root': str(self.root), 'skill_root': str(SKILL), 'python': sys.executable}),
+            'cd_gate_ref': write(self.root, 'cd/gate.json', self.gate), 'scored_runs': self.scored}
+
+    def fill_predictions(self):
+        for role, receipt_ref in self.m['native_eval_receipts'].items():
+            receipt = C.load_file(C.verify_ref(self.root, receipt_ref))
+            prediction = C.load_file(C.verify_ref(self.root, receipt['predictions_ref']))
+            for row in prediction['predictions']:
+                row['fixture_values'] = copy.deepcopy(receipt['native_metrics'])
+            receipt['predictions_ref'] = write(self.root, receipt['predictions_ref']['path'], prediction)
+            self.m['native_eval_receipts'][role] = write(self.root, receipt_ref['path'], receipt)
+
+    def repin_manifest(self):
+        self.manifest_ref = write(self.root, 'cd/manifest.json', self.m)
+        self.scored[0]['manifest_ref'] = self.manifest_ref
+        self.packet['cd_gate_ref'] = write(self.root, 'cd/gate.json', self.gate)
+
+    def test_actual_official_fixture_scorer_replay_and_metrics(self):
+        report = execute_cd_verification(self.project, self.packet)
+        self.assertTrue(report['ready'])
+        self.assertEqual(report['native_replay_count'], 4)
+        self.assertEqual(report['scored_runs'][0]['metrics']['accuracy'], {'treatment': .75, 'control': .5})
+        self.assertEqual(report['cd_gate_ref'], self.packet['cd_gate_ref'])
+        for audit in report['native_replays']:
+            self.assertEqual(audit['exit_code'], 0)
+            execution = C.load_file(C.verify_ref(self.root, audit['execution_ref']))
+            self.assertEqual(execution['execution_id'], audit['execution_id'])
+
+    def test_unscored_export_cannot_verify(self):
+        self.m.pop('native_eval_receipts')
+        self.repin_manifest()
+        with self.assertRaisesRegex(ContractError, 'NATIVE_ARM_RECEIPTS_INCOMPLETE'):
+            execute_cd_verification(self.project, self.packet)
+
+    def test_scoring_rejects_metrics_that_differ_from_actual_predictions(self):
+        rref = self.m['native_eval_receipts']['treatment']
+        receipt = C.load_file(C.verify_ref(self.root, rref))
+        predictions = C.load_file(C.verify_ref(self.root, receipt['predictions_ref']))
+        for row in predictions['predictions']: row['fixture_values']['accuracy'] = .1
+        receipt['predictions_ref'] = write(self.root, receipt['predictions_ref']['path'], predictions)
+        self.m['native_eval_receipts']['treatment'] = write(self.root, rref['path'], receipt)
+        self.repin_manifest()
+        with self.assertRaisesRegex(ContractError, 'NATIVE_METRIC_REPLAY_DISAGREEMENT'):
+            execute_cd_verification(self.project, self.packet)
+
+    def test_weak_baseline_is_scored_problem_evidence_but_not_verified_solution(self):
+        self.m['baseline_qualified'] = False
+        native_run_fixture(self.root, self.p, self.m)
+        self.fill_predictions(); self.repin_manifest()
+        report = execute_cd_verification(self.project, self.packet)
+        self.assertFalse(report['ready'])
+        self.assertTrue(report['native_replay_executed'])
+        self.gate['kind'] = 'research-cd-problem'
+        self.packet['cd_gate_ref'] = write(self.root, 'cd/gate.json', self.gate)
+        report = execute_cd_verification(self.project, self.packet)
+        self.assertTrue(report['ready'])
+        self.assertFalse(report['scored_runs'][0]['baseline_qualified'])
+
+    def test_local_target_is_rejected_before_execution(self):
+        target = C.load_file(C.verify_ref(self.root, self.packet['native_target_ref']))
+        target['host'] = None
+        self.packet['native_target_ref'] = write(self.root, 'cd/target.json', target)
+        with self.assertRaisesRegex(ContractError, 'explicit SSH target'):
+            execute_cd_verification(self.project, self.packet)
+        self.assertFalse((self.root / 'runs/native-replays').exists())
+
+    def test_gate_scored_bindings_cannot_be_replaced(self):
+        self.gate['scored_runs'] = []
+        self.packet['cd_gate_ref'] = write(self.root, 'cd/gate.json', self.gate)
+        with self.assertRaisesRegex(ContractError, 'exact gate scored-run'):
+            execute_cd_verification(self.project, self.packet)
+
+    def test_protocol_identity_mismatch_is_rejected(self):
+        self.m['protocol_id'] = 'different-protocol'
+        self.repin_manifest()
+        with self.assertRaisesRegex(ContractError, 'CD_VERIFICATION_PROTOCOL_BINDING_MISMATCH'):
+            execute_cd_verification(self.project, self.packet)
+
+    def test_fixed_target_bootstrap_captures_scoring_identity(self):
+        # Target-side transport integration. Entire suite runs on authorized GPU host.
+        sources = closure_worker._runtime_sources()
+        digest = closure_worker._source_digest(sources)
+        payload = {'sources': sources, 'project': self.project, 'packet': self.packet,
+            'task_id': 'fixture-verifier-task', 'run_id': 'fixture-verifier-run',
+            'inputs': [], 'timeout_seconds': 45, 'host': 'authorized-test-gpu'}
+        result = subprocess.run([sys.executable, '-I', '-B', '-c', closure_worker._TARGET, digest],
+            input=canonical_json(payload), text=True, capture_output=True, timeout=45)
+        self.assertEqual(result.returncode, 0, result.stderr)
+        receipt = json.loads(result.stdout)
+        self.assertEqual(receipt['kind'], 'research-cd-scientific-verification')
+        self.assertEqual(receipt['scored_runs'], self.scored)
+        self.assertEqual(receipt['cd_gate_ref'], self.packet['cd_gate_ref'])
+        self.assertEqual(receipt['runtime_sha256'], digest)
+        self.assertTrue(receipt['report']['ready'])
+        self.assertTrue(receipt['report']['native_replay_executed'])
+
+    def test_transport_collects_generated_scoring_evidence_to_origin(self):
+        import shutil
+        import tempfile
+        import time
+        from unittest.mock import patch
+        from test_controller import task as task_fixture
