+                    or db.execute("SELECT 1 FROM runs WHERE project_id=? AND state NOT IN ('completed','failed','cancelled') LIMIT 1",
+                                  (project_id,)).fetchone()):
+                raise ContractError('qualification adoption cannot replace pending, running or uncertain work')
+            receipt = save_artifact(project['root'],
+                f'research-state/harness/adoptions/b01-qualification-{revision:06d}.json', {
+                    'kind': 'research-b01-qualification-adoption', 'schema_version': 1,
+                    'project_id': project_id, 'previous_revision': expected_revision,
+                    'revision': revision, 'authorization_ref': authorization_ref,
+                    'previous_contract': config, 'previous_state': state,
+                    'adopted_contract': updated})
+            new_state = {**state, 'qualification_adoption_ref': receipt}
+            payload = canonical_json(new_state)
+            db.execute('UPDATE research_programs SET contract=?,state=?,revision=? WHERE project_id=?',
+                       (canonical_json(updated), payload, revision, project_id))
+            db.execute('INSERT INTO research_program_events VALUES(?,?,?,?,?)',
+                       (project_id, revision, 'b01_qualification_authorized', payload, time.time()))
+        return self.status(project_id)
