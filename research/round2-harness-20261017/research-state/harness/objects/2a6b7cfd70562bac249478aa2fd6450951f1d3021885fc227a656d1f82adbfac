{"task_id": "Mbpp/465", "original_task_id": 465, "entry_point": "drop_empty", "prompt": "Write a function to drop empty items from a given dictionary.\n\nImplement this Python function. Return only the complete implementation.\ndef drop_empty(dict1):\n    pass", "original_prompt": "Write a function to drop empty items from a given dictionary.", "prompt_protocol": "mbpp-function-interface-v1", "interface_source": "reference-ast-signature-only", "reference": "def drop_empty(dict1):\r\n  dict1 = {key:value for (key, value) in dict1.items() if value is not None}\r\n  return dict1", "tests": "assert drop_empty({'c1': 'Red', 'c2': 'Green', 'c3':None})=={'c1': 'Red', 'c2': 'Green'}\nassert drop_empty({'c1': 'Red', 'c2': None, 'c3':None})=={'c1': 'Red'}\nassert drop_empty({'c1': None, 'c2': 'Green', 'c3':None})=={ 'c2': 'Green'}", "source": "google-research-datasets/mbpp", "split": "eval", "original_split": "test", "dataset_config": "full", "revision": "4bb6404fdc6cacfda99d4ac4205087b89d32030c", "split_seed": 42, "dataset_fingerprint": null}
{"task_id": "Mbpp/466", "original_task_id": 466, "entry_point": "find_peak", "prompt": "Write a function to find the peak element in the given array.\n\nImplement this Python function. Return only the complete implementation.\ndef find_peak(arr, n):\n    pass", "original_prompt": "Write a function to find the peak element in the given array.", "prompt_protocol": "mbpp-function-interface-v1", "interface_source": "reference-ast-signature-only", "reference": "def find_peak_util(arr, low, high, n): \r\n\tmid = low + (high - low)/2\r\n\tmid = int(mid) \r\n\tif ((mid == 0 or arr[mid - 1] <= arr[mid]) and\r\n\t\t(mid == n - 1 or arr[mid + 1] <= arr[mid])): \r\n\t\treturn mid \r\n\telif (mid > 0 and arr[mid - 1] > arr[mid]): \r\n\t\treturn find_peak_util(arr, low, (mid - 1), n) \r\n\telse: \r\n\t\treturn find_peak_util(arr, (mid + 1), high, n) \r\ndef find_peak(arr, n): \r\n\treturn find_peak_util(arr, 0, n - 1, n) ", "tests": "assert find_peak([1, 3, 20, 4, 1, 0], 6) == 2\nassert find_peak([2, 3, 4, 5, 6], 5) == 4\nassert find_peak([8, 9, 11, 12, 14, 15], 6) == 5 ", "source": "google-research-datasets/mbpp", "split": "eval", "original_split": "test", "dataset_config": "full", "revision": "4bb6404fdc6cacfda99d4ac4205087b89d32030c", "split_seed": 42, "dataset_fingerprint": null}
{"task_id": "Mbpp/467", "original_task_id": 467, "entry_point": "decimal_to_Octal", "prompt": "Write a python function to convert decimal number to octal number.\n\nImplement this Python function. Return only the complete implementation.\ndef decimal_to_Octal(deciNum):\n    pass", "original_prompt": "Write a python function to convert decimal number to octal number.", "prompt_protocol": "mbpp-function-interface-v1", "interface_source": "reference-ast-signature-only", "reference": "def decimal_to_Octal(deciNum):\r\n    octalNum = 0\r\n    countval = 1;\r\n    dNo = deciNum;\r\n    while (deciNum!= 0):\r\n        remainder= deciNum % 8;\r\n        octalNum+= remainder*countval;\r\n        countval= countval*10;\r\n        deciNum //= 8; \r\n    return (octalNum)", "tests": "assert decimal_to_Octal(10) == 12\nassert decimal_to_Octal(2) == 2\nassert decimal_to_Octal(33) == 41", "source": "google-research-datasets/mbpp", "split": "eval", "original_split": "test", "dataset_config": "full", "revision": "4bb6404fdc6cacfda99d4ac4205087b89d32030c", "split_seed": 42, "dataset_fingerprint": null}
{"task_id": "Mbpp/468", "original_task_id": 468, "entry_point": "max_product", "prompt": "Write a function to find the maximum product formed by multiplying numbers of an increasing subsequence of that array.\n\nImplement this Python function. Return only the complete implementation.\ndef max_product(arr, n):\n    pass", "original_prompt": "Write a function to find the maximum product formed by multiplying numbers of an increasing subsequence of that array.", "prompt_protocol": "mbpp-function-interface-v1", "interface_source": "reference-ast-signature-only", "reference": "def max_product(arr, n ): \r\n\tmpis =[0] * (n) \r\n\tfor i in range(n): \r\n\t\tmpis[i] = arr[i] \r\n\tfor i in range(1, n): \r\n\t\tfor j in range(i): \r\n\t\t\tif (arr[i] > arr[j] and\r\n\t\t\t\t\tmpis[i] < (mpis[j] * arr[i])): \r\n\t\t\t\t\t\tmpis[i] = mpis[j] * arr[i] \r\n\treturn max(mpis)", "tests": "assert max_product([3, 100, 4, 5, 150, 6], 6) == 45000 \nassert max_product([4, 42, 55, 68, 80], 5) == 50265600\nassert max_product([10, 22, 9, 33, 21, 50, 41, 60], 8) == 21780000 ", "source": "google-research-datasets/mbpp", "split": "eval", "original_split": "test", "dataset_config": "full", "revision": "4bb6404fdc6cacfda99d4ac4205087b89d32030c", "split_seed": 42, "dataset_fingerprint": null}
{"task_id": "Mbpp/469", "original_task_id": 469, "entry_point": "max_profit", "prompt": "Write a function to find the maximum profit earned from a maximum of k stock transactions\n\nImplement this Python function. Return only the complete implementation.\ndef max_profit(price, k):\n    pass", "original_prompt": "Write a function to find the maximum profit earned from a maximum of k stock transactions", "prompt_protocol": "mbpp-function-interface-v1", "interface_source": "reference-ast-signature-only", "reference": "def max_profit(price, k):\r\n    n = len(price)\r\n    final_profit = [[None for x in range(n)] for y in range(k + 1)]\r\n    for i in range(k + 1):\r\n        for j in range(n):\r\n            if i == 0 or j == 0:\r\n                final_profit[i][j] = 0\r\n            else:\r\n                max_so_far = 0\r\n                for x in range(j):\r\n                    curr_price = price[j] - price[x] + final_profit[i-1][x]\r\n                    if max_so_far < curr_price:\r\n                        max_so_far = curr_price\r\n                final_profit[i][j] = max(final_profit[i][j-1], max_so_far)\r\n    return final_profit[k][n-1]", "tests": "assert max_profit([1, 5, 2, 3, 7, 6, 4, 5], 3) == 10\nassert max_profit([2, 4, 7, 5, 4, 3, 5], 2) == 7\nassert max_profit([10, 6, 8, 4, 2], 2) == 2", "source": "google-research-datasets/mbpp", "split": "eval", "original_split": "test", "dataset_config": "full", "revision": "4bb6404fdc6cacfda99d4ac4205087b89d32030c", "split_seed": 42, "dataset_fingerprint": null}
{"task_id": "Mbpp/470", "original_task_id": 470, "entry_point": "add_pairwise", "prompt": "Write a function to find the pairwise addition of the elements of the given tuples.\n\nImplement this Python function. Return only the complete implementation.\ndef add_pairwise(test_tup):\n    pass", "original_prompt": "Write a function to find the pairwise addition of the elements of the given tuples.", "prompt_protocol": "mbpp-function-interface-v1", "interface_source": "reference-ast-signature-only", "reference": "def add_pairwise(test_tup):\r\n  res = tuple(i + j for i, j in zip(test_tup, test_tup[1:]))\r\n  return (res) ", "tests": "assert add_pairwise((1, 5, 7, 8, 10)) == (6, 12, 15, 18)\nassert add_pairwise((2, 6, 8, 9, 11)) == (8, 14, 17, 20)\nassert add_pairwise((3, 7, 9, 10, 12)) == (10, 16, 19, 22)", "source": "google-research-datasets/mbpp", "split": "eval", "original_split": "test", "dataset_config": "full", "revision": "4bb6404fdc6cacfda99d4ac4205087b89d32030c", "split_seed": 42, "dataset_fingerprint": null}
{"task_id": "Mbpp/471", "original_task_id": 471, "entry_point": "find_remainder", "prompt": "Write a python function to find remainder of array multiplication divided by n.\n\nImplement this Python function. Return only the complete implementation.\ndef find_remainder(arr, lens, n):\n    pass", "original_prompt": "Write a python function to find remainder of array multiplication divided by n.", "prompt_protocol": "mbpp-function-interface-v1", "interface_source": "reference-ast-signature-only", "reference": "def find_remainder(arr, lens, n): \r\n    mul = 1\r\n    for i in range(lens):  \r\n        mul = (mul * (arr[i] % n)) % n \r\n    return mul % n ", "tests": "assert find_remainder([ 100, 10, 5, 25, 35, 14 ],6,11) ==9\nassert find_remainder([1,1,1],3,1) == 0\nassert find_remainder([1,2,1],3,2) == 0", "source": "google-research-datasets/mbpp", "split": "eval", "original_split": "test", "dataset_config": "full", "revision": "4bb6404fdc6cacfda99d4ac4205087b89d32030c", "split_seed": 42, "dataset_fingerprint": null}
{"task_id": "Mbpp/472", "original_task_id": 472, "entry_point": "check_Consecutive", "prompt": "Write a python function to check whether the given list contains consecutive numbers or not.\n\nImplement this Python function. Return only the complete implementation.\ndef check_Consecutive(l):\n    pass", "original_prompt": "Write a python function to check whether the given list contains consecutive numbers or not.", "prompt_protocol": "mbpp-function-interface-v1", "interface_source": "reference-ast-signature-only", "reference": "def check_Consecutive(l): \r\n    return sorted(l) == list(range(min(l),max(l)+1)) ", "tests": "assert check_Consecutive([1,2,3,4,5]) == True\nassert check_Consecutive([1,2,3,5,6]) == False\nassert check_Consecutive([1,2,1]) == False", "source": "google-research-datasets/mbpp", "split": "eval", "original_split": "test", "dataset_config": "full", "revision": "4bb6404fdc6cacfda99d4ac4205087b89d32030c", "split_seed": 42, "dataset_fingerprint": null}
{"task_id": "Mbpp/473", "original_task_id": 473, "entry_point": "tuple_intersection", "prompt": "Write a function to find the tuple intersection of elements in the given tuple list irrespective of their order.\n\nImplement this Python function. Return only the complete implementation.\ndef tuple_intersection(test_list1, test_list2):\n    pass", "original_prompt": "Write a function to find the tuple intersection of elements in the given tuple list irrespective of their order.", "prompt_protocol": "mbpp-function-interface-v1", "interface_source": "reference-ast-signature-only", "reference": "def tuple_intersection(test_list1, test_list2):\r\n  res = set([tuple(sorted(ele)) for ele in test_list1]) & set([tuple(sorted(ele)) for ele in test_list2])\r\n  return (res)", "tests": "assert tuple_intersection([(3, 4), (5, 6), (9, 10), (4, 5)] , [(5, 4), (3, 4), (6, 5), (9, 11)]) == {(4, 5), (3, 4), (5, 6)}\nassert tuple_intersection([(4, 1), (7, 4), (11, 13), (17, 14)] , [(1, 4), (7, 4), (16, 12), (10, 13)]) == {(4, 7), (1, 4)}\nassert tuple_intersection([(2, 1), (3, 2), (1, 3), (1, 4)] , [(11, 2), (2, 3), (6, 2), (1, 3)]) == {(1, 3), (2, 3)}", "source": "google-research-datasets/mbpp", "split": "eval", "original_split": "test", "dataset_config": "full", "revision": "4bb6404fdc6cacfda99d4ac4205087b89d32030c", "split_seed": 42, "dataset_fingerprint": null}
