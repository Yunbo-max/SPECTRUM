+        updated = strict_json(canonical_json(config))
+        updated['sequence']['qualification_authorization_ref'] = authorization_ref
+        _qualification_authorization(project, updated)
+        revision = expected_revision + 1
+        with self.controller._transaction() as db:
+            row = db.execute('SELECT revision,contract,state FROM research_programs WHERE project_id=?',
+                             (project_id,)).fetchone()
+            if (row is None or row['revision'] != expected_revision
