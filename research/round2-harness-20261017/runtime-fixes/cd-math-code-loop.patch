+def check_scored_lineage(root, gate):
+    """Join scored predictions to actual retained run outputs, not nearby runs.
+
+    This checks provenance only. Scorer execution and scientific interpretation
+    remain separate program-owned verification and independent-review duties.
+    """
+    proofs = []; runs = refs(root, gate.get('run_receipt_refs'), 'cited native runs', nonempty=True)
+    candidates = []
+    for run_ref in runs:
+        saved = document(root, run_ref); item = saved.get('controller', {}); task = item.get('task', {})
+        need(item.get('state') == 'completed' and task.get('action') == 'native_harness', 'lineage requires completed native run')
+        output_refs = refs(root, item.get('outputs'), 'actual task outputs', nonempty=True)
+        declared = task.get('outputs')
+        need(isinstance(declared, list), 'native task declared outputs required')
+        retained = saved.get('retained_files')
+        need(isinstance(retained, list) and retained, 'native run retained files required')
+        archives = []
+        for row in retained:
+            original, archive = row.get('original_ref'), row.get('archive_ref')
+            refs(root, [original, archive], 'retained prediction identity')
+            need(original['sha256'] == archive['sha256'], 'retained archive bytes differ from actual output')
+            archives.append(original); proofs.extend([original, archive])
+        href = task.get('parameters', {}).get('harness_plan_ref'); harness = document(root, href)
+        proofs.extend([run_ref, href, *output_refs])
+        for htask in harness.get('tasks', []):
+            nref = htask.get('plan_ref'); native = document(root, nref); proofs.append(nref)
+            for job in native.get('jobs', []):
+                candidates.append((native.get('protocol_ref'), job, output_refs, declared, archives))
+    scored = gate.get('scored_runs')
+    need(isinstance(scored, list) and scored, 'scored run inventory required')
+    for row in scored:
+        protocol = document(root, row.get('protocol_ref')); manifest = document(root, row.get('manifest_ref'))
+        proofs.extend([row['protocol_ref'], row['manifest_ref']])
+        for key in ('protocol_id', 'protocol_digest', 'run_id', 'group'):
+            text(manifest.get(key), 'scored manifest ' + key)
+        need(type(manifest.get('seed')) is int and manifest['seed'] >= 0, 'scored manifest seed required')
+        need(manifest.get('protocol_id') == protocol.get('protocol_id')
+             and manifest.get('protocol_digest') == protocol.get('protocol_digest'), 'scored manifest protocol mismatch')
+        arms = manifest.get('native_eval_receipts')
+        need(isinstance(arms, dict) and arms, 'scored manifest needs native arm receipts')
+        for role, receipt_ref in arms.items():
+            receipt = document(root, receipt_ref); pred = receipt.get('predictions_ref')
+            refs(root, [pred], 'scored predictions'); proofs.extend([receipt_ref, pred])
+            need(receipt.get('arm_role') == role and receipt.get('group') == manifest.get('group')
+                 and receipt.get('seed') == manifest.get('seed') and receipt.get('run_id') == manifest.get('run_id')
+                 and receipt.get('protocol_id') == manifest.get('protocol_id')
+                 and receipt.get('protocol_digest') == manifest.get('protocol_digest'), 'scored arm identity mismatch')
+            matched = any(protocol_ref == row['protocol_ref']
+                          and job.get('arm_role') == role and job.get('group') == manifest.get('group')
+                          and job.get('seed') == manifest.get('seed')
+                          and pred['path'] in job.get('output_paths', []) and pred['path'] in declared
+                          and pred in outputs and pred in retained
+                          for protocol_ref, job, outputs, declared, retained in candidates)
+            need(matched, 'scored predictions do not match cited native output/protocol/arm/group/seed')
+    return list({(ref['path'], ref['sha256']): ref for ref in proofs}.values())
+
