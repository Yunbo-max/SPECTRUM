@@ -0,0 +1,526 @@
+"""Bounded, read-only SSH GPU intake; readiness means prerequisites for a pilot only.
+
+This standalone command does not change program admission or a pinned project.
+Use --smoke explicitly to permit tiny sequential matrix multiplications.
+"""
+from __future__ import annotations
+
+import argparse
+from dataclasses import asdict
+from datetime import datetime, timezone
+import hashlib
+import inspect
+import json
+from pathlib import Path
+import subprocess
+import tempfile
+import time
+
+from .remote import NativeTarget, ssh_argv
+
+OUTPUT_LIMIT = 512 * 1024
+PROBE_SECONDS = 45
+
+
+def _normalize_uuid(raw, known=()):
+    """Match bare CUDA UUIDs to observed/allocated GPU or MIG identities."""
+    import uuid
+
+    if raw is None:
+        return None, None, 'missing'
+    if isinstance(raw, (bytes, bytearray, memoryview)):
+        raw_text = bytes(raw).hex()
+        try:
+            bare = str(uuid.UUID(bytes=bytes(raw)))
+        except ValueError:
+            return None, raw_text, 'invalid_uuid_bytes'
+    else:
+        raw_text = str(raw).strip()
+        # Preserve the GPU/MIG namespace. Legacy MIG-GPU-.../GI/CI identifiers
+        # are already typed, and cannot be inferred from a parent's GPU UUID.
+        for prefix in ('GPU-', 'MIG-'):
+            if raw_text.startswith(prefix):
+                try:
+                    canonical = prefix + str(uuid.UUID(raw_text[len(prefix):]))
+                except ValueError:
+                    canonical = raw_text
+                return canonical, raw_text, 'typed_uuid'
+        try:
+            bare = str(uuid.UUID(raw_text))
+        except ValueError:
+            return None, raw_text, 'unrecognized_uuid'
+    matches = set()
+    for identity in known:
+        if not isinstance(identity, str):
+            continue
+        for prefix in ('GPU-', 'MIG-'):
+            if identity.startswith(prefix):
+                try:
+                    if str(uuid.UUID(identity[len(prefix):])) == bare:
+                        matches.add(prefix + bare)
+                except ValueError:
+                    pass
+    if len(matches) == 1:
+        return matches.pop(), raw_text, 'matched_inventory_or_allocation'
+    return None, raw_text, 'ambiguous_uuid_namespace' if matches else 'unmapped_uuid_namespace'
+
+
+def _remote_probe(mode, root, requested, smoke, requirements=None):
+    # This function is sent as source, so imports must remain self-contained.
+    import csv
+    import importlib.metadata
+    import io
+    import os
+    import platform
+    import shutil
+    import signal
+    import subprocess
+    import sys
+
+    signal.alarm(35)
+    result = {'python': {'requested': requested, 'executable': sys.executable,
+                        'version': platform.python_version(), 'prefix': sys.prefix},
+              'packages': {}, 'errors': []}
+    for package in ('torch', 'numpy', 'transformers', 'accelerate'):
+        try:
+            result['packages'][package] = importlib.metadata.version(package)
+        except importlib.metadata.PackageNotFoundError:
+            result['packages'][package] = None
+    if mode == 'system':
+        return result
+    resolved = shutil.which(requested)
+    result['python']['requested_resolved'] = resolved
+    result['python']['matches_requested_realpath'] = bool(
+        resolved and os.path.realpath(resolved) == os.path.realpath(sys.executable))
+    # Virtualenv interpreters commonly share the system binary's realpath.
+    # Keep invocation identity and environment prefix separate from that fact.
+    result['python']['matches_requested_path'] = bool(
+        resolved and os.path.abspath(resolved) == os.path.abspath(sys.executable))
+    expected_prefix = None
+    if resolved:
+        candidate = os.path.dirname(os.path.dirname(os.path.abspath(resolved)))
+        if (os.path.isfile(os.path.join(candidate, 'pyvenv.cfg')) or
+                os.path.isdir(os.path.join(candidate, 'conda-meta'))):
+            expected_prefix = candidate
+    result['python']['expected_prefix'] = expected_prefix
+    result['python']['matches_expected_prefix'] = (
+        os.path.realpath(sys.prefix) == os.path.realpath(expected_prefix)
+        if expected_prefix else None)
+    result['python']['matches_requested'] = (
+        result['python']['matches_requested_path'] and
+        result['python']['matches_expected_prefix'] is not False)
+    if not result['python']['matches_requested']:
+        result['errors'].append('selected_interpreter_mismatch')
+        return result
+    try:
+        os.chdir(root)
+    except OSError as error:
+        result['errors'].append('project_root_unavailable:' + type(error).__name__)
+        return result
+    result['host_resources'] = {'ram_total_mib': None, 'ram_available_mib': None,
+                                'cgroup_memory_max_bytes': None,
+                                'cgroup_memory_current_bytes': None,
+                                'target_root_disk_free_mib': None}
+    try:
+        with open('/proc/meminfo') as handle:
+            values = dict(line.split(':', 1) for line in handle if ':' in line)
+        result['host_resources']['ram_total_mib'] = int(values['MemTotal'].split()[0]) // 1024
+        result['host_resources']['ram_available_mib'] = int(values['MemAvailable'].split()[0]) // 1024
+    except (OSError, ValueError, KeyError):
+        pass
+    try:
+        # Resolve this process's cgroup v2, rather than assuming the root group.
+        with open('/proc/self/cgroup') as handle:
+            group = next(line.strip().split('::', 1)[1] for line in handle if line.startswith('0::'))
+        base = os.path.join('/sys/fs/cgroup', group.lstrip('/'))
+        for filename, key in [('memory.max', 'cgroup_memory_max_bytes'),
+                              ('memory.current', 'cgroup_memory_current_bytes')]:
+            with open(os.path.join(base, filename)) as handle:
+                value = handle.read(64).strip()
+            result['host_resources'][key] = 'unlimited' if value == 'max' else int(value)
+    except (OSError, ValueError, StopIteration):
+        pass
+    try:
+        result['host_resources']['target_root_disk_free_mib'] = shutil.disk_usage(root).free // (1024 * 1024)
+    except OSError:
+        pass
+    result['nvidia_smi'] = {'status': 'unknown', 'gpus': []}
+    try:
+        process = subprocess.run(
+            ['nvidia-smi', '--query-gpu=uuid,name,memory.total,memory.free,driver_version',
+             '--format=csv,noheader,nounits'], capture_output=True, text=True, timeout=8)
+        if process.returncode:
+            result['nvidia_smi']['error'] = 'command_failed'
+        elif len(process.stdout) > 131072:
+            result['nvidia_smi']['error'] = 'output_limit'
+        else:
+            rows = list(csv.reader(io.StringIO(process.stdout)))
+            if len(rows) > 128:
+                raise ValueError('device_limit')
+            for row in rows:
+                if len(row) != 5:
+                    raise ValueError('malformed_csv')
+                uuid, name, total, free, driver = [value.strip() for value in row]
+                total, free = int(total), int(free)
+                if not uuid or total <= 0 or not 0 <= free <= total:
+                    raise ValueError('invalid_memory_or_identity')
+                result['nvidia_smi']['gpus'].append(
+                    {'uuid': uuid, 'name': name, 'total_vram_mib': total,
+                     'free_vram_mib': free, 'driver_version': driver})
+            result['nvidia_smi']['status'] = 'observed'
+    except Exception as error:
+        result['nvidia_smi']['error'] = type(error).__name__
+        result['nvidia_smi']['gpus'] = []
+    result['torch'] = {'status': 'unknown', 'devices': []}
+    try:
+        import torch
+    except ImportError:
+        result['torch']['status'] = 'missing'
+        return result
+    except Exception as error:
+        result['torch']['error'] = 'import_failed:' + type(error).__name__
+        return result
+    result['torch'].update({'version': str(torch.__version__),
+                            'cuda_build': torch.version.cuda})
+    try:
+        available = bool(torch.cuda.is_available())
+        count = int(torch.cuda.device_count())
+        if not 0 <= count <= 128:
+            raise ValueError('device_count_out_of_bounds')
+        result['torch'].update({'status': 'observed', 'cuda_available': available,
+                                'visible_device_count': count})
+        requirement = requirements or {'gpu_count': 1}
+        allocation = requirement.get('allocated_gpu_uuids')
+        known_uuids = [gpu['uuid'] for gpu in result['nvidia_smi']['gpus']] + (allocation or [])
+        if allocation is not None:
+            allocation = [_normalize_uuid(identity, known_uuids)[0] for identity in allocation]
+            allocation = [identity for identity in allocation if identity is not None]
+        for index in range(count if available else 0):
+            device = {'index': index, 'smoke': {precision: {'status': 'not_requested'}
+                       for precision in ('fp32', 'fp16', 'bf16')}, 'probe_selected': False}
+            result['torch']['devices'].append(device)
+            try:
+                # Metadata enumeration precedes device contexts, memory queries,
+                # precision checks and any optional tensor allocation.
+                properties = torch.cuda.get_device_properties(index)
+                capability = list(torch.cuda.get_device_capability(index))
+                canonical_uuid, raw_uuid, uuid_basis = _normalize_uuid(
+                    getattr(properties, 'uuid', None), known_uuids)
+                device.update({'name': str(properties.name),
+                               'uuid': canonical_uuid, 'uuid_raw': raw_uuid, 'uuid_basis': uuid_basis,
+                               'capability': capability,
+                               'total_vram_mib': int(properties.total_memory // (1024 * 1024))})
+            except Exception as error:
+                device['error'] = type(error).__name__
+        candidates = [device for device in result['torch']['devices']
+                      if allocation is None or device.get('uuid') in allocation]
+        selected_probe = candidates[:requirement.get('gpu_count', 1)]
+        result['torch']['probe_selected_device_indices'] = [device['index'] for device in selected_probe]
+        for device in selected_probe:
+            device['probe_selected'] = True
+            index = device['index']
+            if device.get('error'):
+                continue
+            capability = device['capability']
+            try:
+                with torch.cuda.device(index):
+                    try:
+                        free, total = torch.cuda.mem_get_info(index)
+                        device['free_vram_mib'] = int(free // (1024 * 1024))
+                        device['visible_total_vram_mib'] = int(total // (1024 * 1024))
+                    except Exception as error:
+                        device['free_vram_mib'] = None
+                        device['memory_error'] = type(error).__name__
+                    native_bf16 = None
+                    default_bf16 = None
+                    bf16_basis = 'unknown'
+                    if smoke:
+                        # The default API can allocate an emulation tensor on
+                        # older GPUs, so it requires explicit smoke permission.
+                        try:
+                            default_bf16 = bool(torch.cuda.is_bf16_supported())
+                        except Exception:
+                            pass
+                    try:
+                        native_bf16 = bool(torch.cuda.is_bf16_supported(including_emulation=False))
+                        bf16_basis = 'torch_including_emulation_false'
+                    except TypeError:
+                        # A pre-Ampere NVIDIA CUDA device cannot have native BF16.
+                        # Newer hardware alone does not establish runtime support.
+                        native_bf16 = False if capability[0] < 8 else None
+                        bf16_basis = 'legacy_api_conservative_capability'
+                    except Exception as error:
+                        device['bf16_error'] = type(error).__name__
+                    device['precision'] = {
+                        'fp32': True, 'fp16': tuple(capability) >= (5, 3),
+                        'bf16': native_bf16, 'bf16_default_may_emulate': default_bf16,
+                        'bf16_basis': bf16_basis}
+            except Exception as error:
+                device['error'] = type(error).__name__
+        if smoke:
+            candidates = []
+            for device in result['torch']['devices']:
+                device['smoke'] = {precision: {'status': 'not_selected'}
+                                   for precision in ('fp32', 'fp16', 'bf16')}
+                if not device['probe_selected']:
+                    continue
+                if allocation is not None and device.get('uuid') not in allocation:
+                    continue
+                if device.get('error'):
+                    continue
+                candidates.append(device)
+            # No retry on additional GPUs: the explicit smoke budget is one
+            # sequential pass on at most the requested count of selected GPUs.
+            selected = candidates[:requirement.get('gpu_count', 1)]
+            result['torch']['smoke_selected_device_indices'] = [device['index'] for device in selected]
+            for device in selected:
+                index = device['index']
+                try:
+                    with torch.cuda.device(index):
+                        for precision, dtype in [('fp32', torch.float32),
+                                                 ('fp16', torch.float16), ('bf16', torch.bfloat16)]:
+                            support = device['precision'][precision]
+                            if support is not True:
+                                device['smoke'][precision] = {'status': 'unsupported' if support is False else 'unknown'}
+                                continue
+                            left = output = None
+                            try:
+                                left = torch.ones((32, 32), device='cuda:' + str(index), dtype=dtype)
+                                output = left @ left
+                                torch.cuda.synchronize(index)
+                                finite = bool(torch.isfinite(output).all().item())
+                                correct = bool((output == 32).all().item())
+                                device['smoke'][precision] = {
+                                    'status': 'tested' if finite and correct else 'error',
+                                    'expected_value': 32}
+                                if not finite:
+                                    device['smoke'][precision]['error'] = 'nonfinite_output'
+                                elif not correct:
+                                    device['smoke'][precision]['error'] = 'incorrect_output'
+                            except Exception as error:
+                                device['smoke'][precision] = {'status': 'error', 'error': type(error).__name__}
+                            finally:
+                                del left, output
+                                # Release only this short-lived probe's allocator cache.
+                                torch.cuda.empty_cache()
+                except Exception as error:
+                    device['error'] = type(error).__name__
+    except Exception as error:
+        result['torch']['status'] = 'unknown'
+        result['torch']['error'] = type(error).__name__
+    return result
+
+
+def _run_bounded(argv, timeout=PROBE_SECONDS):
+    """Bound captured bytes and wall time; never disclose raw stderr/environment."""
+    with tempfile.TemporaryFile() as out, tempfile.TemporaryFile() as err:
+        process = subprocess.Popen(argv, stdout=out, stderr=err)
+        deadline = time.monotonic() + timeout
+        reason = None
+        while process.poll() is None:
+            if out.tell() > OUTPUT_LIMIT or err.tell() > OUTPUT_LIMIT:
+                reason = 'output_limit'
+                break
+            if time.monotonic() >= deadline:
+                reason = 'timeout'
+                break
+            time.sleep(0.05)
+        if reason:
+            process.kill()
+        process.wait()
+        if out.tell() > OUTPUT_LIMIT or err.tell() > OUTPUT_LIMIT:
+            reason = 'output_limit'
+        out.seek(0)
+        output = out.read(OUTPUT_LIMIT + 1)
+        if len(output) > OUTPUT_LIMIT:
+            reason = 'output_limit'
+        if reason:
+            raise RuntimeError(reason)
+        if process.returncode:
+            raise RuntimeError('ssh_or_interpreter_failed:exit_' + str(process.returncode))
+        return output.decode('utf-8')
+
+
+def _probe(target, mode, smoke, runner, requirements=None):
+    executable = target.python if mode == 'project' else 'python3'
+    source = ('import json\n' + inspect.getsource(_normalize_uuid) + '\n' + inspect.getsource(_remote_probe) +
+              '\nprint(json.dumps(_remote_probe(' + ','.join(repr(value) for value in
+              (mode, target.root, executable, smoke and mode == 'project', requirements)) +
+              '), allow_nan=False))\n')
+    argv = ssh_argv(target, [executable, '-c', source])
+    try:
+        output = runner(argv)
+        if len(output) > OUTPUT_LIMIT:
+            raise RuntimeError('output_limit')
+        value = json.loads(output)
+        if not isinstance(value, dict) or not isinstance(value.get('python'), dict):
+            raise ValueError('invalid_probe_shape')
+        return {'status': 'observed', 'observation': value}
+    except (OSError, RuntimeError, ValueError, subprocess.SubprocessError) as error:
+        # Error strings from the remote environment may contain private values.
+        code = str(error) if type(error) is RuntimeError and str(error).split(':')[0] in {
+            'output_limit', 'timeout', 'ssh_or_interpreter_failed'} else type(error).__name__
+        return {'status': 'unknown', 'error': code}
+
+
+def validate_requirements(requirements):
+    if not isinstance(requirements, dict):
+        raise ValueError('requirements must be a JSON object')
+    allowed = {'stage', 'gpu_count', 'precision', 'min_free_vram_mib', 'allocated_gpu_uuids'}
+    if set(requirements) - allowed:
+        raise ValueError('unknown requirement fields')
+    if requirements.get('stage') not in {'training', 'prediction', 'export', 'scoring'}:
+        raise ValueError('stage must be training, prediction, export or scoring')
+    count = requirements.get('gpu_count')
+    if type(count) is not int or not 1 <= count <= 128:
+        raise ValueError('gpu_count must be an integer from 1 to 128')
+    if requirements.get('precision') not in (None, 'fp32', 'fp16', 'bf16'):
+        raise ValueError('precision must be fp32, fp16, bf16 or null')
+    memory = requirements.get('min_free_vram_mib')
+    if memory is not None and (type(memory) is not int or memory <= 0):
+        raise ValueError('min_free_vram_mib must be a positive per-device integer or null')
+    allocation = requirements.get('allocated_gpu_uuids')
+    if allocation is not None and (not isinstance(allocation, list) or not allocation or
+            len(allocation) > 128 or any(not isinstance(item, str) or not item or len(item) > 128
+                                       for item in allocation) or len(set(allocation)) != len(allocation)):
+        raise ValueError('allocated_gpu_uuids must be a nonempty unique list of GPU or MIG UUIDs')
+    if allocation is not None and any(not item.startswith(('GPU-', 'MIG-')) or len(item) <= 4
+                                      for item in allocation):
+        raise ValueError('allocated_gpu_uuids entries must be canonical IDs prefixed with GPU- or MIG-; bare UUIDs are not accepted')
+
+
+def _assess(project, requirements, smoke):
+    if project['status'] != 'observed':
+        return 'needs_measurement', ['selected_project_observation_unavailable'], []
+    observed = project['observation']
+    if observed.get('errors') or observed.get('python', {}).get('matches_requested') is not True:
+        return 'blocked', ['selected_project_interpreter_or_root_unqualified'], []
+    torch = observed.get('torch', {})
+    if not isinstance(torch, dict):
+        return 'needs_measurement', ['project_cuda_observation_malformed'], []
+    if torch.get('status') == 'missing':
+        return 'blocked', ['selected_project_interpreter_missing_torch'], []
+    if torch.get('status') != 'observed':
+        return 'needs_measurement', ['project_cuda_observation_unknown'], []
+    if torch.get('cuda_available') is False:
+        return 'blocked', ['project_cuda_unavailable'], []
+    if torch.get('cuda_available') is not True or not isinstance(torch.get('devices'), list):
+        return 'needs_measurement', ['project_cuda_visibility_unknown'], []
+    devices = torch['devices']
+    if (type(torch.get('visible_device_count')) is not int or
+            torch['visible_device_count'] != len(devices) or len(devices) > 128 or
+            any(not isinstance(device, dict) for device in devices)):
+        return 'needs_measurement', ['incomplete_visible_device_inventory'], []
+    allocation = requirements.get('allocated_gpu_uuids')
+    if allocation is not None:
+        allocation = [_normalize_uuid(identity, allocation)[0] for identity in allocation]
+        if any(not device.get('uuid') for device in devices):
+            return 'needs_measurement', ['allocation_to_visible_uuid_mapping_unknown'], []
+        devices = [device for device in devices if device['uuid'] in allocation]
+    if any('probe_selected' in device for device in devices):
+        devices = [device for device in devices if device.get('probe_selected') is True]
+    if len(devices) < requirements['gpu_count']:
+        return 'blocked', ['insufficient_visible_allocated_gpu_count'], []
+    precision, memory = requirements.get('precision'), requirements.get('min_free_vram_mib')
+    missing = []
+    if precision is None:
+        missing.append('precision_requirement_unknown')
+    if memory is None:
+        missing.append('full_workload_per_device_memory_requirement_unknown')
+    if missing:
+        return 'needs_measurement', missing, []
+    eligible, unknown = [], []
+    for device in devices:
+        precision_observation = device.get('precision')
+        support = precision_observation.get(precision) if isinstance(precision_observation, dict) else None
+        free = device.get('free_vram_mib')
+        if support is False or (type(free) is int and free < memory):
+            continue
+        if support is not True or type(free) is not int or device.get('error'):
+            unknown.append(device.get('index'))
+            continue
+        if smoke:
+            smoke_observation = device.get('smoke')
+            smoke_result = smoke_observation.get(precision) if isinstance(smoke_observation, dict) else None
+            status = smoke_result.get('status') if isinstance(smoke_result, dict) else None
+            if status in {'error', 'unsupported'}:
+                continue
+            if status != 'tested':
+                unknown.append(device.get('index'))
+                continue
+        eligible.append(device.get('index'))
+    if len(eligible) >= requirements['gpu_count']:
+        return 'ready_for_pilot', ['declared_gpu_prerequisites_observed'], eligible
+    if len(eligible) + len(unknown) >= requirements['gpu_count']:
+        return 'needs_measurement', ['precision_memory_or_smoke_observation_unknown'], eligible
+    return 'blocked', ['insufficient_devices_meeting_precision_memory_and_requested_smoke'], eligible
+
+
+def collect_report(target, requirements, *, smoke=False, runner=None):
+    """Return JSON-safe evidence, without admitting or launching an experiment."""
+    report = {
+        'kind': 'research-gpu-preflight', 'schema_version': 1,
+        'observed_at': datetime.now(timezone.utc).isoformat(),
+        'status': 'blocked', 'smoke_requested': smoke,
+        'scope': 'declared GPU prerequisites for a pilot in one stage only',
+        'limitations': ['Free VRAM is a changing observation, not a reservation.',
+                       'No complete workload feasibility or scientific success is established.',
+                       'Measure model, activations, gradients, optimizer, workspaces and peak memory in a representative pilot.',
+                       'Scorer, dependencies and isolation qualification remain separate for each stage.',
+                       'Visible devices do not establish exclusive allocation or multi-GPU communication readiness.'],
+    }
+    try:
+        if isinstance(target, dict):
+            target = NativeTarget(**target)
+        if not isinstance(target, NativeTarget) or target.host is None:
+            raise ValueError('explicit authorized SSH host is required; local probing is disabled')
+        validate_requirements(requirements)
+    except (TypeError, ValueError) as error:
+        report['reasons'] = ['invalid_configuration']
+        report['configuration_error'] = str(error) if isinstance(error, ValueError) else 'invalid target fields'
+        return report
+    report['target'] = asdict(target)
+    report['target_sha256'] = hashlib.sha256(json.dumps(asdict(target), sort_keys=True).encode()).hexdigest()
+    report['requirements'] = requirements
+    report['requirements_sha256'] = hashlib.sha256(json.dumps(requirements, sort_keys=True).encode()).hexdigest()
+    runner = runner or _run_bounded
+    project = _probe(target, 'project', smoke, runner, requirements)
+    system = _probe(target, 'system', False, runner)
+    report['interpreters'] = {'project': project, 'system': system}
+    if project['status'] == system['status'] == 'observed':
+        p, s = project['observation']['python'], system['observation']['python']
+        report['interpreter_comparison'] = {
+            'same_executable': p.get('executable') == s.get('executable'),
+            'same_prefix': p.get('prefix') == s.get('prefix'),
+            'fallback_used': False}
+    else:
+        report['interpreter_comparison'] = {'same_executable': None, 'same_prefix': None, 'fallback_used': False}
+    report['status'], report['reasons'], report['eligible_visible_device_indices'] = _assess(project, requirements, smoke)
+    return report
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--target', required=True, type=Path)
+    parser.add_argument('--requirements', required=True, type=Path)
+    parser.add_argument('--output', required=True, type=Path)
+    parser.add_argument('--smoke', action='store_true')
+    args = parser.parse_args(argv)
+    try:
+        for path in (args.target, args.requirements):
+            if path.stat().st_size > OUTPUT_LIMIT:
+                raise ValueError('configuration file exceeds size limit')
+        target = json.loads(args.target.read_text())
+        requirements = json.loads(args.requirements.read_text())
+        report = collect_report(target, requirements, smoke=args.smoke)
+    except (OSError, ValueError) as error:
+        report = {'kind': 'research-gpu-preflight', 'schema_version': 1, 'status': 'blocked',
+                  'observed_at': datetime.now(timezone.utc).isoformat(),
+                  'reasons': ['configuration_read_failed:' + type(error).__name__]}
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    args.output.write_text(json.dumps(report, indent=2, sort_keys=True, allow_nan=False) + '\n')
+    return 0 if report['status'] == 'ready_for_pilot' else 2
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
