{"task_id": "Mbpp/192", "original_task_id": 192, "entry_point": "check_String", "prompt": "Write a python function to check whether a string has atleast one letter and one number.\n\nImplement this Python function. Return only the complete implementation.\ndef check_String(str):\n    pass", "original_prompt": "Write a python function to check whether a string has atleast one letter and one number.", "prompt_protocol": "mbpp-function-interface-v1", "interface_source": "reference-ast-signature-only", "reference": "def check_String(str): \r\n    flag_l = False\r\n    flag_n = False\r\n    for i in str: \r\n        if i.isalpha(): \r\n            flag_l = True  \r\n        if i.isdigit(): \r\n            flag_n = True\r\n    return flag_l and flag_n ", "tests": "assert check_String('thishasboth29') == True\nassert check_String('python') == False\nassert check_String ('string') == False", "source": "google-research-datasets/mbpp", "split": "eval", "original_split": "test", "dataset_config": "full", "revision": "4bb6404fdc6cacfda99d4ac4205087b89d32030c", "split_seed": 42, "dataset_fingerprint": null}
