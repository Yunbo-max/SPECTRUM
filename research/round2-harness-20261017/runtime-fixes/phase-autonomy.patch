+        self.assertIsNone(f.seq['problem_ref'])
+        self.assertIsNone(f.seq['verified_ref'])
+        self.assertIsNone(f.seq['scaleup_acceptance_ref'])
+        for key in ('round', 'consumed_runs', 'coverage_ref', 'accepted_decision_ref'):
+            self.assertEqual(f.prior['state'][key], old_state[key])
+
+    def test_singleton_b05_records_phase_shape_for_later_requirement_audit(self):
+        f = self.fixture
+        f.seq.update(index=23, step_id='B05')
+        original = next(node for node in f.catalog['steps'] if node['id'] == 'B05')
+        expanded = phase_autonomy.expand(f.catalog, f.prior, original)
+        self.assertEqual(expanded['milestone_ids'], ['B05'])
+        self.assertEqual(expanded['gate_step_id'], 'B05')
+        self.assertIn('C.method_basis', [row['id'] for row in expanded['requirements']])
+        # Audit reconstructs the historical step with visit=None and its stored
+        # start ID; it must recover exactly the same extra acceptance obligation.
+        audit_prior = copy.deepcopy(f.prior)
+        audit_prior['state']['sequence'].update(index=84, step_id='cycle-closure', visit=None)
+        audited = phase_autonomy.expand(f.catalog, audit_prior, original)
+        self.assertEqual(audited['requirements'], expanded['requirements'])
+        self.assertEqual(audited['milestone_ids'], ['B05'])
