{"task_id": "Mbpp/826", "original_task_id": 826, "entry_point": "check_Type_Of_Triangle", "prompt": "Write a python function to find the type of triangle from the given sides.\n\nImplement this Python function. Return only the complete implementation.\ndef check_Type_Of_Triangle(a, b, c):\n    pass", "original_prompt": "Write a python function to find the type of triangle from the given sides.", "prompt_protocol": "mbpp-function-interface-v1", "interface_source": "reference-ast-signature-only", "reference": "def check_Type_Of_Triangle(a,b,c): \r\n    sqa = pow(a,2) \r\n    sqb = pow(b,2) \r\n    sqc = pow(c,2) \r\n    if (sqa == sqa + sqb or sqb == sqa + sqc or sqc == sqa + sqb): \r\n        return (\"Right-angled Triangle\") \r\n    elif (sqa > sqc + sqb or sqb > sqa + sqc or sqc > sqa + sqb): \r\n        return (\"Obtuse-angled Triangle\") \r\n    else: \r\n        return (\"Acute-angled Triangle\") ", "tests": "assert check_Type_Of_Triangle(1,2,3) == \"Obtuse-angled Triangle\"\nassert check_Type_Of_Triangle(2,2,2) == \"Acute-angled Triangle\"\nassert check_Type_Of_Triangle(1,0,1) == \"Right-angled Triangle\"", "source": "google-research-datasets/mbpp", "split": "calibration", "original_split": "train", "dataset_config": "full", "revision": "4bb6404fdc6cacfda99d4ac4205087b89d32030c", "split_seed": 42, "dataset_fingerprint": null}
{"task_id": "Mbpp/894", "original_task_id": 894, "entry_point": "float_to_tuple", "prompt": "Write a function to convert the given string of float type into tuple.\n\nImplement this Python function. Return only the complete implementation.\ndef float_to_tuple(test_str):\n    pass", "original_prompt": "Write a function to convert the given string of float type into tuple.", "prompt_protocol": "mbpp-function-interface-v1", "interface_source": "reference-ast-signature-only", "reference": "def float_to_tuple(test_str):\r\n  res = tuple(map(float, test_str.split(', ')))\r\n  return (res) ", "tests": "assert float_to_tuple(\"1.2, 1.3, 2.3, 2.4, 6.5\") == (1.2, 1.3, 2.3, 2.4, 6.5)\nassert float_to_tuple(\"2.3, 2.4, 5.6, 5.4, 8.9\") == (2.3, 2.4, 5.6, 5.4, 8.9)\nassert float_to_tuple(\"0.3, 0.5, 7.8, 9.4\") == (0.3, 0.5, 7.8, 9.4)", "source": "google-research-datasets/mbpp", "split": "calibration", "original_split": "train", "dataset_config": "full", "revision": "4bb6404fdc6cacfda99d4ac4205087b89d32030c", "split_seed": 42, "dataset_fingerprint": null}
{"task_id": "Mbpp/687", "original_task_id": 687, "entry_point": "recur_gcd", "prompt": "Write a function to find the greatest common divisor (gcd) of two integers by using recursion.\n\nImplement this Python function. Return only the complete implementation.\ndef recur_gcd(a, b):\n    pass", "original_prompt": "Write a function to find the greatest common divisor (gcd) of two integers by using recursion.", "prompt_protocol": "mbpp-function-interface-v1", "interface_source": "reference-ast-signature-only", "reference": "def recur_gcd(a, b):\r\n\tlow = min(a, b)\r\n\thigh = max(a, b)\r\n\tif low == 0:\r\n\t\treturn high\r\n\telif low == 1:\r\n\t\treturn 1\r\n\telse:\r\n\t\treturn recur_gcd(low, high%low)", "tests": "assert recur_gcd(12,14) == 2\nassert recur_gcd(13,17) == 1\nassert recur_gcd(9, 3) == 3", "source": "google-research-datasets/mbpp", "split": "calibration", "original_split": "train", "dataset_config": "full", "revision": "4bb6404fdc6cacfda99d4ac4205087b89d32030c", "split_seed": 42, "dataset_fingerprint": null}
{"task_id": "Mbpp/873", "original_task_id": 873, "entry_point": "fibonacci", "prompt": "Write a function to solve the fibonacci sequence using recursion.\n\nImplement this Python function. Return only the complete implementation.\ndef fibonacci(n):\n    pass", "original_prompt": "Write a function to solve the fibonacci sequence using recursion.", "prompt_protocol": "mbpp-function-interface-v1", "interface_source": "reference-ast-signature-only", "reference": "def fibonacci(n):\r\n  if n == 1 or n == 2:\r\n    return 1\r\n  else:\r\n    return (fibonacci(n - 1) + (fibonacci(n - 2)))", "tests": "assert fibonacci(7) == 13\nassert fibonacci(8) == 21\nassert fibonacci(9) == 34", "source": "google-research-datasets/mbpp", "split": "calibration", "original_split": "train", "dataset_config": "full", "revision": "4bb6404fdc6cacfda99d4ac4205087b89d32030c", "split_seed": 42, "dataset_fingerprint": null}
{"task_id": "Mbpp/818", "original_task_id": 818, "entry_point": "lower_ctr", "prompt": "Write a python function to count lower case letters in a given string.\n\nImplement this Python function. Return only the complete implementation.\ndef lower_ctr(str):\n    pass", "original_prompt": "Write a python function to count lower case letters in a given string.", "prompt_protocol": "mbpp-function-interface-v1", "interface_source": "reference-ast-signature-only", "reference": "def lower_ctr(str):\r\n      lower_ctr= 0\r\n      for i in range(len(str)):\r\n          if str[i] >= 'a' and str[i] <= 'z': lower_ctr += 1     \r\n      return  lower_ctr", "tests": "assert lower_ctr('abc') == 3\nassert lower_ctr('string') == 6\nassert lower_ctr('Python') == 5", "source": "google-research-datasets/mbpp", "split": "calibration", "original_split": "train", "dataset_config": "full", "revision": "4bb6404fdc6cacfda99d4ac4205087b89d32030c", "split_seed": 42, "dataset_fingerprint": null}
{"task_id": "Mbpp/816", "original_task_id": 816, "entry_point": "clear_tuple", "prompt": "Write a function to clear the values of the given tuples.\n\nImplement this Python function. Return only the complete implementation.\ndef clear_tuple(test_tup):\n    pass", "original_prompt": "Write a function to clear the values of the given tuples.", "prompt_protocol": "mbpp-function-interface-v1", "interface_source": "reference-ast-signature-only", "reference": "def clear_tuple(test_tup):\r\n  temp = list(test_tup)\r\n  temp.clear()\r\n  test_tup = tuple(temp)\r\n  return (test_tup) ", "tests": "assert clear_tuple((1, 5, 3, 6, 8)) == ()\nassert clear_tuple((2, 1, 4 ,5 ,6)) == ()\nassert clear_tuple((3, 2, 5, 6, 8)) == ()", "source": "google-research-datasets/mbpp", "split": "calibration", "original_split": "train", "dataset_config": "full", "revision": "4bb6404fdc6cacfda99d4ac4205087b89d32030c", "split_seed": 42, "dataset_fingerprint": null}
{"task_id": "Mbpp/836", "original_task_id": 836, "entry_point": "max_sub_array_sum", "prompt": "Write a function to find length of the subarray having maximum sum.\n\nImplement this Python function. Return only the complete implementation.\ndef max_sub_array_sum(a, size):\n    pass", "original_prompt": "Write a function to find length of the subarray having maximum sum.", "prompt_protocol": "mbpp-function-interface-v1", "interface_source": "reference-ast-signature-only", "reference": "from sys import maxsize \r\ndef max_sub_array_sum(a,size): \r\n\tmax_so_far = -maxsize - 1\r\n\tmax_ending_here = 0\r\n\tstart = 0\r\n\tend = 0\r\n\ts = 0\r\n\tfor i in range(0,size): \r\n\t\tmax_ending_here += a[i] \r\n\t\tif max_so_far < max_ending_here: \r\n\t\t\tmax_so_far = max_ending_here \r\n\t\t\tstart = s \r\n\t\t\tend = i \r\n\t\tif max_ending_here < 0: \r\n\t\t\tmax_ending_here = 0\r\n\t\t\ts = i+1\r\n\treturn (end - start + 1)", "tests": "assert max_sub_array_sum([-2, -3, 4, -1, -2, 1, 5, -3],8) == 5\nassert max_sub_array_sum([1, -2, 1, 1, -2, 1],6) == 2\nassert max_sub_array_sum([-1, -2, 3, 4, 5],5) == 3", "source": "google-research-datasets/mbpp", "split": "calibration", "original_split": "train", "dataset_config": "full", "revision": "4bb6404fdc6cacfda99d4ac4205087b89d32030c", "split_seed": 42, "dataset_fingerprint": null}
{"task_id": "Mbpp/843", "original_task_id": 843, "entry_point": "nth_super_ugly_number", "prompt": "Write a function to find the nth super ugly number from a given prime list of size k using heap queue algorithm.\n\nImplement this Python function. Return only the complete implementation.\ndef nth_super_ugly_number(n, primes):\n    pass", "original_prompt": "Write a function to find the nth super ugly number from a given prime list of size k using heap queue algorithm.", "prompt_protocol": "mbpp-function-interface-v1", "interface_source": "reference-ast-signature-only", "reference": "import heapq\r\ndef nth_super_ugly_number(n, primes):\r\n    uglies = [1]\r\n    def gen(prime):\r\n        for ugly in uglies:\r\n            yield ugly * prime\r\n    merged = heapq.merge(*map(gen, primes))\r\n    while len(uglies) < n:\r\n        ugly = next(merged)\r\n        if ugly != uglies[-1]:\r\n            uglies.append(ugly)\r\n    return uglies[-1]", "tests": "assert nth_super_ugly_number(12,[2,7,13,19])==32\nassert nth_super_ugly_number(10,[2,7,13,19])==26\nassert nth_super_ugly_number(100,[2,7,13,19])==5408", "source": "google-research-datasets/mbpp", "split": "calibration", "original_split": "train", "dataset_config": "full", "revision": "4bb6404fdc6cacfda99d4ac4205087b89d32030c", "split_seed": 42, "dataset_fingerprint": null}
{"task_id": "Mbpp/679", "original_task_id": 679, "entry_point": "access_key", "prompt": "Write a function to access dictionary key’s element by index.\n\nImplement this Python function. Return only the complete implementation.\ndef access_key(ditionary, key):\n    pass", "original_prompt": "Write a function to access dictionary key’s element by index.", "prompt_protocol": "mbpp-function-interface-v1", "interface_source": "reference-ast-signature-only", "reference": "def access_key(ditionary,key):\r\n  return list(ditionary)[key]", "tests": "assert access_key({'physics': 80, 'math': 90, 'chemistry': 86},0)== 'physics'\nassert access_key({'python':10, 'java': 20, 'C++':30},2)== 'C++'\nassert access_key({'program':15,'computer':45},1)== 'computer'", "source": "google-research-datasets/mbpp", "split": "calibration", "original_split": "train", "dataset_config": "full", "revision": "4bb6404fdc6cacfda99d4ac4205087b89d32030c", "split_seed": 42, "dataset_fingerprint": null}
{"task_id": "Mbpp/752", "original_task_id": 752, "entry_point": "jacobsthal_num", "prompt": "Write a function to find the nth jacobsthal number.\n\nImplement this Python function. Return only the complete implementation.\ndef jacobsthal_num(n):\n    pass", "original_prompt": "Write a function to find the nth jacobsthal number.", "prompt_protocol": "mbpp-function-interface-v1", "interface_source": "reference-ast-signature-only", "reference": "def jacobsthal_num(n): \r\n\tdp = [0] * (n + 1) \r\n\tdp[0] = 0\r\n\tdp[1] = 1\r\n\tfor i in range(2, n+1): \r\n\t\tdp[i] = dp[i - 1] + 2 * dp[i - 2] \r\n\treturn dp[n]", "tests": "assert jacobsthal_num(5) == 11\nassert jacobsthal_num(2) == 1\nassert jacobsthal_num(4) == 5", "source": "google-research-datasets/mbpp", "split": "calibration", "original_split": "train", "dataset_config": "full", "revision": "4bb6404fdc6cacfda99d4ac4205087b89d32030c", "split_seed": 42, "dataset_fingerprint": null}
{"task_id": "Mbpp/898", "original_task_id": 898, "entry_point": "extract_elements", "prompt": "Write a function to extract specified number of elements from a given list, which follow each other continuously.\n\nImplement this Python function. Return only the complete implementation.\ndef extract_elements(numbers, n):\n    pass", "original_prompt": "Write a function to extract specified number of elements from a given list, which follow each other continuously.", "prompt_protocol": "mbpp-function-interface-v1", "interface_source": "reference-ast-signature-only", "reference": "from itertools import groupby \r\ndef extract_elements(numbers, n):\r\n    result = [i for i, j in groupby(numbers) if len(list(j)) == n] \r\n    return result", "tests": "assert extract_elements([1, 1, 3, 4, 4, 5, 6, 7],2)==[1, 4]\nassert extract_elements([0, 1, 2, 3, 4, 4, 4, 4, 5, 7],4)==[4]\nassert extract_elements([0,0,0,0,0],5)==[0]", "source": "google-research-datasets/mbpp", "split": "calibration", "original_split": "train", "dataset_config": "full", "revision": "4bb6404fdc6cacfda99d4ac4205087b89d32030c", "split_seed": 42, "dataset_fingerprint": null}
{"task_id": "Mbpp/935", "original_task_id": 935, "entry_point": "series_sum", "prompt": "Write a function to calculate the sum of series 1²+2²+3²+….+n².\n\nImplement this Python function. Return only the complete implementation.\ndef series_sum(number):\n    pass", "original_prompt": "Write a function to calculate the sum of series 1²+2²+3²+….+n².", "prompt_protocol": "mbpp-function-interface-v1", "interface_source": "reference-ast-signature-only", "reference": "def series_sum(number):\r\n total = 0\r\n total = (number * (number + 1) * (2 * number + 1)) / 6\r\n return total", "tests": "assert series_sum(6)==91\nassert series_sum(7)==140\nassert series_sum(12)==650", "source": "google-research-datasets/mbpp", "split": "calibration", "original_split": "train", "dataset_config": "full", "revision": "4bb6404fdc6cacfda99d4ac4205087b89d32030c", "split_seed": 42, "dataset_fingerprint": null}
{"task_id": "Mbpp/691", "original_task_id": 691, "entry_point": "group_element", "prompt": "Write a function to group the 1st elements on the basis of 2nd elements in the given tuple list.\n\nImplement this Python function. Return only the complete implementation.\ndef group_element(test_list):\n    pass", "original_prompt": "Write a function to group the 1st elements on the basis of 2nd elements in the given tuple list.", "prompt_protocol": "mbpp-function-interface-v1", "interface_source": "reference-ast-signature-only", "reference": "from itertools import groupby \r\ndef group_element(test_list):\r\n  res = dict()\r\n  for key, val in groupby(sorted(test_list, key = lambda ele: ele[1]), key = lambda ele: ele[1]):\r\n    res[key] = [ele[0] for ele in val] \r\n  return (res)\r\n", "tests": "assert group_element([(6, 5), (2, 7), (2, 5), (8, 7), (9, 8), (3, 7)]) == {5: [6, 2], 7: [2, 8, 3], 8: [9]}\nassert group_element([(7, 6), (3, 8), (3, 6), (9, 8), (10, 9), (4, 8)]) == {6: [7, 3], 8: [3, 9, 4], 9: [10]}\nassert group_element([(8, 7), (4, 9), (4, 7), (10, 9), (11, 10), (5, 9)]) == {7: [8, 4], 9: [4, 10, 5], 10: [11]}", "source": "google-research-datasets/mbpp", "split": "calibration", "original_split": "train", "dataset_config": "full", "revision": "4bb6404fdc6cacfda99d4ac4205087b89d32030c", "split_seed": 42, "dataset_fingerprint": null}
{"task_id": "Mbpp/721", "original_task_id": 721, "entry_point": "maxAverageOfPath", "prompt": "Write a function to find a path with the maximum average over all existing paths for the given square matrix of size n*n.\n\nImplement this Python function. Return only the complete implementation.\ndef maxAverageOfPath(cost, N):\n    pass", "original_prompt": "Write a function to find a path with the maximum average over all existing paths for the given square matrix of size n*n.", "prompt_protocol": "mbpp-function-interface-v1", "interface_source": "reference-ast-signature-only", "reference": "M = 100\r\ndef maxAverageOfPath(cost, N): \r\n\tdp = [[0 for i in range(N + 1)] for j in range(N + 1)] \r\n\tdp[0][0] = cost[0][0] \r\n\tfor i in range(1, N): \r\n\t\tdp[i][0] = dp[i - 1][0] + cost[i][0] \r\n\tfor j in range(1, N): \r\n\t\tdp[0][j] = dp[0][j - 1] + cost[0][j] \r\n\tfor i in range(1, N): \r\n\t\tfor j in range(1, N): \r\n\t\t\tdp[i][j] = max(dp[i - 1][j], \r\n\t\t\t\t\t\tdp[i][j - 1]) + cost[i][j] \r\n\treturn dp[N - 1][N - 1] / (2 * N - 1)", "tests": "assert maxAverageOfPath([[1, 2, 3], [6, 5, 4], [7, 3, 9]], 3) == 5.2\nassert maxAverageOfPath([[2, 3, 4], [7, 6, 5], [8, 4, 10]], 3) == 6.2\nassert maxAverageOfPath([[3, 4, 5], [8, 7, 6], [9, 5, 11]], 3) == 7.2 ", "source": "google-research-datasets/mbpp", "split": "calibration", "original_split": "train", "dataset_config": "full", "revision": "4bb6404fdc6cacfda99d4ac4205087b89d32030c", "split_seed": 42, "dataset_fingerprint": null}
{"task_id": "Mbpp/830", "original_task_id": 830, "entry_point": "round_up", "prompt": "Write a function to round up a number to specific digits.\n\nImplement this Python function. Return only the complete implementation.\ndef round_up(a, digits):\n    pass", "original_prompt": "Write a function to round up a number to specific digits.", "prompt_protocol": "mbpp-function-interface-v1", "interface_source": "reference-ast-signature-only", "reference": "import math\r\ndef round_up(a, digits):\r\n    n = 10**-digits\r\n    return round(math.ceil(a / n) * n, digits)", "tests": "assert round_up(123.01247,0)==124\nassert round_up(123.01247,1)==123.1\nassert round_up(123.01247,2)==123.02", "source": "google-research-datasets/mbpp", "split": "calibration", "original_split": "train", "dataset_config": "full", "revision": "4bb6404fdc6cacfda99d4ac4205087b89d32030c", "split_seed": 42, "dataset_fingerprint": null}
{"task_id": "Mbpp/765", "original_task_id": 765, "entry_point": "is_polite", "prompt": "Write a function to find nth polite number.\n\nImplement this Python function. Return only the complete implementation.\ndef is_polite(n):\n    pass", "original_prompt": "Write a function to find nth polite number.", "prompt_protocol": "mbpp-function-interface-v1", "interface_source": "reference-ast-signature-only", "reference": "import math \r\ndef is_polite(n): \r\n\tn = n + 1\r\n\treturn (int)(n+(math.log((n + math.log(n, 2)), 2))) ", "tests": "assert is_polite(7) == 11\nassert is_polite(4) == 7\nassert is_polite(9) == 13", "source": "google-research-datasets/mbpp", "split": "calibration", "original_split": "train", "dataset_config": "full", "revision": "4bb6404fdc6cacfda99d4ac4205087b89d32030c", "split_seed": 42, "dataset_fingerprint": null}
{"task_id": "Mbpp/667", "original_task_id": 667, "entry_point": "Check_Vow", "prompt": "Write a python function to count number of vowels in the string.\n\nImplement this Python function. Return only the complete implementation.\ndef Check_Vow(string, vowels):\n    pass", "original_prompt": "Write a python function to count number of vowels in the string.", "prompt_protocol": "mbpp-function-interface-v1", "interface_source": "reference-ast-signature-only", "reference": "def Check_Vow(string, vowels): \r\n    final = [each for each in string if each in vowels] \r\n    return(len(final)) \r\n", "tests": "assert Check_Vow('corner','AaEeIiOoUu') == 2\nassert Check_Vow('valid','AaEeIiOoUu') == 2\nassert Check_Vow('true','AaEeIiOoUu') ==2", "source": "google-research-datasets/mbpp", "split": "calibration", "original_split": "train", "dataset_config": "full", "revision": "4bb6404fdc6cacfda99d4ac4205087b89d32030c", "split_seed": 42, "dataset_fingerprint": null}
{"task_id": "Mbpp/701", "original_task_id": 701, "entry_point": "equilibrium_index", "prompt": "Write a function to find the equilibrium index of the given array.\n\nImplement this Python function. Return only the complete implementation.\ndef equilibrium_index(arr):\n    pass", "original_prompt": "Write a function to find the equilibrium index of the given array.", "prompt_protocol": "mbpp-function-interface-v1", "interface_source": "reference-ast-signature-only", "reference": "def equilibrium_index(arr):\r\n  total_sum = sum(arr)\r\n  left_sum=0\r\n  for i, num in enumerate(arr):\r\n    total_sum -= num\r\n    if left_sum == total_sum:\r\n      return i\r\n    left_sum += num\r\n  return -1", "tests": "assert equilibrium_index([1, 2, 3, 4, 1, 2, 3]) == 3\nassert equilibrium_index([-7, 1, 5, 2, -4, 3, 0]) == 3\nassert equilibrium_index([1, 2, 3]) == -1", "source": "google-research-datasets/mbpp", "split": "calibration", "original_split": "train", "dataset_config": "full", "revision": "4bb6404fdc6cacfda99d4ac4205087b89d32030c", "split_seed": 42, "dataset_fingerprint": null}
{"task_id": "Mbpp/723", "original_task_id": 723, "entry_point": "count_same_pair", "prompt": "Write a function to count the same pair in two given lists using map function.\n\nImplement this Python function. Return only the complete implementation.\ndef count_same_pair(nums1, nums2):\n    pass", "original_prompt": "Write a function to count the same pair in two given lists using map function.", "prompt_protocol": "mbpp-function-interface-v1", "interface_source": "reference-ast-signature-only", "reference": "from operator import eq\r\ndef count_same_pair(nums1, nums2):\r\n    result = sum(map(eq, nums1, nums2))\r\n    return result", "tests": "assert count_same_pair([1, 2, 3, 4, 5, 6, 7, 8],[2, 2, 3, 1, 2, 6, 7, 9])==4\nassert count_same_pair([0, 1, 2, -1, -5, 6, 0, -3, -2, 3, 4, 6, 8],[2, 1, 2, -1, -5, 6, 4, -3, -2, 3, 4, 6, 8])==11\nassert count_same_pair([2, 4, -6, -9, 11, -12, 14, -5, 17],[2, 1, 2, -1, -5, 6, 4, -3, -2, 3, 4, 6, 8])==1", "source": "google-research-datasets/mbpp", "split": "calibration", "original_split": "train", "dataset_config": "full", "revision": "4bb6404fdc6cacfda99d4ac4205087b89d32030c", "split_seed": 42, "dataset_fingerprint": null}
{"task_id": "Mbpp/814", "original_task_id": 814, "entry_point": "rombus_area", "prompt": "Write a function to find the area of a rombus.\n\nImplement this Python function. Return only the complete implementation.\ndef rombus_area(p, q):\n    pass", "original_prompt": "Write a function to find the area of a rombus.", "prompt_protocol": "mbpp-function-interface-v1", "interface_source": "reference-ast-signature-only", "reference": "def rombus_area(p,q):\r\n  area=(p*q)/2\r\n  return area", "tests": "assert rombus_area(10,20)==100\nassert rombus_area(10,5)==25\nassert rombus_area(4,2)==4", "source": "google-research-datasets/mbpp", "split": "calibration", "original_split": "train", "dataset_config": "full", "revision": "4bb6404fdc6cacfda99d4ac4205087b89d32030c", "split_seed": 42, "dataset_fingerprint": null}
{"task_id": "Mbpp/783", "original_task_id": 783, "entry_point": "rgb_to_hsv", "prompt": "Write a function to convert rgb color to hsv color.\n\nImplement this Python function. Return only the complete implementation.\ndef rgb_to_hsv(r, g, b):\n    pass", "original_prompt": "Write a function to convert rgb color to hsv color.", "prompt_protocol": "mbpp-function-interface-v1", "interface_source": "reference-ast-signature-only", "reference": "def rgb_to_hsv(r, g, b):\r\n    r, g, b = r/255.0, g/255.0, b/255.0\r\n    mx = max(r, g, b)\r\n    mn = min(r, g, b)\r\n    df = mx-mn\r\n    if mx == mn:\r\n        h = 0\r\n    elif mx == r:\r\n        h = (60 * ((g-b)/df) + 360) % 360\r\n    elif mx == g:\r\n        h = (60 * ((b-r)/df) + 120) % 360\r\n    elif mx == b:\r\n        h = (60 * ((r-g)/df) + 240) % 360\r\n    if mx == 0:\r\n        s = 0\r\n    else:\r\n        s = (df/mx)*100\r\n    v = mx*100\r\n    return h, s, v", "tests": "assert rgb_to_hsv(255, 255, 255)==(0, 0.0, 100.0)\nassert rgb_to_hsv(0, 215, 0)==(120.0, 100.0, 84.31372549019608)\nassert rgb_to_hsv(10, 215, 110)==(149.26829268292684, 95.34883720930233, 84.31372549019608)", "source": "google-research-datasets/mbpp", "split": "calibration", "original_split": "train", "dataset_config": "full", "revision": "4bb6404fdc6cacfda99d4ac4205087b89d32030c", "split_seed": 42, "dataset_fingerprint": null}
{"task_id": "Mbpp/628", "original_task_id": 628, "entry_point": "replace_spaces", "prompt": "Write a function to replace all spaces in the given string with character * list item * list item * list item * list item '%20'.\n\nImplement this Python function. Return only the complete implementation.\ndef replace_spaces(string):\n    pass", "original_prompt": "Write a function to replace all spaces in the given string with character * list item * list item * list item * list item '%20'.", "prompt_protocol": "mbpp-function-interface-v1", "interface_source": "reference-ast-signature-only", "reference": "MAX=1000;\r\ndef replace_spaces(string):\r\n  string=string.strip()\r\n  i=len(string)\r\n  space_count=string.count(' ')\r\n  new_length = i + space_count*2\r\n  if new_length > MAX:\r\n    return -1\r\n  index = new_length-1\r\n  string=list(string)\r\n  for f in range(i-2, new_length-2):\r\n    string.append('0')\r\n  for j in range(i-1, 0, -1):\r\n    if string[j] == ' ':\r\n      string[index] = '0'\r\n      string[index-1] = '2'\r\n      string[index-2] = '%'\r\n      index=index-3\r\n    else:\r\n      string[index] = string[j]\r\n      index -= 1\r\n  return ''.join(string)", "tests": "assert replace_spaces(\"My Name is Dawood\") == 'My%20Name%20is%20Dawood'\nassert replace_spaces(\"I am a Programmer\") == 'I%20am%20a%20Programmer'\nassert replace_spaces(\"I love Coding\") == 'I%20love%20Coding'", "source": "google-research-datasets/mbpp", "split": "calibration", "original_split": "train", "dataset_config": "full", "revision": "4bb6404fdc6cacfda99d4ac4205087b89d32030c", "split_seed": 42, "dataset_fingerprint": null}
{"task_id": "Mbpp/879", "original_task_id": 879, "entry_point": "text_match", "prompt": "Write a function that matches a string that has an 'a' followed by anything, ending in 'b' by using regex.\n\nImplement this Python function. Return only the complete implementation.\ndef text_match(text):\n    pass", "original_prompt": "Write a function that matches a string that has an 'a' followed by anything, ending in 'b' by using regex.", "prompt_protocol": "mbpp-function-interface-v1", "interface_source": "reference-ast-signature-only", "reference": "import re\r\ndef text_match(text):\r\n  patterns = 'a.*?b$'\r\n  if re.search(patterns,  text):\r\n    return ('Found a match!')\r\n  else:\r\n    return ('Not matched!')", "tests": "assert text_match(\"aabbbbd\") == 'Not matched!'\nassert text_match(\"aabAbbbc\") == 'Not matched!'\nassert text_match(\"accddbbjjjb\") == 'Found a match!'", "source": "google-research-datasets/mbpp", "split": "calibration", "original_split": "train", "dataset_config": "full", "revision": "4bb6404fdc6cacfda99d4ac4205087b89d32030c", "split_seed": 42, "dataset_fingerprint": null}
{"task_id": "Mbpp/813", "original_task_id": 813, "entry_point": "string_length", "prompt": "Write a function to find length of the string.\n\nImplement this Python function. Return only the complete implementation.\ndef string_length(str1):\n    pass", "original_prompt": "Write a function to find length of the string.", "prompt_protocol": "mbpp-function-interface-v1", "interface_source": "reference-ast-signature-only", "reference": "def string_length(str1):\r\n    count = 0\r\n    for char in str1:\r\n        count += 1\r\n    return count", "tests": "assert string_length('python')==6\nassert string_length('program')==7\nassert string_length('language')==8", "source": "google-research-datasets/mbpp", "split": "calibration", "original_split": "train", "dataset_config": "full", "revision": "4bb6404fdc6cacfda99d4ac4205087b89d32030c", "split_seed": 42, "dataset_fingerprint": null}
{"task_id": "Mbpp/846", "original_task_id": 846, "entry_point": "find_platform", "prompt": "Write a function to find the minimum number of platforms required for a railway/bus station.\n\nImplement this Python function. Return only the complete implementation.\ndef find_platform(arr, dep, n):\n    pass", "original_prompt": "Write a function to find the minimum number of platforms required for a railway/bus station.", "prompt_protocol": "mbpp-function-interface-v1", "interface_source": "reference-ast-signature-only", "reference": "def find_platform(arr, dep, n): \r\n    arr.sort() \r\n    dep.sort() \r\n    plat_needed = 1\r\n    result = 1\r\n    i = 1\r\n    j = 0\r\n    while (i < n and j < n): \r\n        if (arr[i] <= dep[j]):           \r\n            plat_needed+= 1\r\n            i+= 1\r\n        elif (arr[i] > dep[j]):           \r\n            plat_needed-= 1\r\n            j+= 1\r\n        if (plat_needed > result):  \r\n            result = plat_needed           \r\n    return result", "tests": "assert find_platform([900, 940, 950, 1100, 1500, 1800],[910, 1200, 1120, 1130, 1900, 2000],6)==3\nassert find_platform([100,200,300,400],[700,800,900,1000],4)==4\nassert find_platform([5,6,7,8],[4,3,2,1],4)==1", "source": "google-research-datasets/mbpp", "split": "calibration", "original_split": "train", "dataset_config": "full", "revision": "4bb6404fdc6cacfda99d4ac4205087b89d32030c", "split_seed": 42, "dataset_fingerprint": null}
{"task_id": "Mbpp/709", "original_task_id": 709, "entry_point": "get_unique", "prompt": "Write a function to count unique keys for each value present in the tuple.\n\nImplement this Python function. Return only the complete implementation.\ndef get_unique(test_list):\n    pass", "original_prompt": "Write a function to count unique keys for each value present in the tuple.", "prompt_protocol": "mbpp-function-interface-v1", "interface_source": "reference-ast-signature-only", "reference": "from collections import defaultdict \r\ndef get_unique(test_list):\r\n  res = defaultdict(list)\r\n  for sub in test_list:\r\n    res[sub[1]].append(sub[0])\r\n  res = dict(res)\r\n  res_dict = dict()\r\n  for key in res:\r\n    res_dict[key] = len(list(set(res[key])))\r\n  return (str(res_dict)) ", "tests": "assert get_unique([(3, 4), (1, 2), (2, 4), (8, 2), (7, 2), (8, 1), (9, 1), (8, 4), (10, 4)] ) == '{4: 4, 2: 3, 1: 2}'\nassert get_unique([(4, 5), (2, 3), (3, 5), (9, 3), (8, 3), (9, 2), (10, 2), (9, 5), (11, 5)] ) == '{5: 4, 3: 3, 2: 2}'\nassert get_unique([(6, 5), (3, 4), (2, 6), (11, 1), (8, 22), (8, 11), (4, 3), (14, 3), (11, 6)] ) == '{5: 1, 4: 1, 6: 2, 1: 1, 22: 1, 11: 1, 3: 2}'", "source": "google-research-datasets/mbpp", "split": "calibration", "original_split": "train", "dataset_config": "full", "revision": "4bb6404fdc6cacfda99d4ac4205087b89d32030c", "split_seed": 42, "dataset_fingerprint": null}
