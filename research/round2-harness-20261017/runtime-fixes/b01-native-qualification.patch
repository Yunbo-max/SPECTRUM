+    def authorize_b01_qualification(self, project_id, authorization_ref, *, expected_revision):
+        """Owner-only, audited opt-in at a quiet B01 decision boundary.
+
+        Call from the supervising host after explicit user authorization. This
+        is not an agent response field, resume operation or source/target update.
+        """
+        from .skill_sequence import _cursor, _qualification_authorization
