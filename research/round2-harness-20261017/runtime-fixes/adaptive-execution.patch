+"""Later-stage operational execution; synthetic fixtures are not research evidence."""
+import copy
+import json
+import unittest
+
+import test_native_stages as base
+import test_admission as legacy
+from fixtures import write, C
+import run_experiments as R
+import run_harness as H
+import native_stages as NS
+from research_autopilot import admission
+from research_autopilot.controller import Controller
+from research_autopilot.program import ResearchProgram
+from research_autopilot.models import ContractError
+
+
+class ScaleupStageTests(unittest.TestCase):
+    setUp = base.NativeStageTests.setUp
+    make = base.NativeStageTests.make
+    native = base.NativeStageTests.native
+    prepare = base.NativeStageTests.prepare
+    stage_task = base.NativeStageTests.stage_task
+    lineage = base.NativeStageTests.lineage
+    scaleup = base.NativeStageTests.scaleup
+
+    def later_stage(self, kind='prepare', step='E03'):
+        task = self.stage_task(export=kind == 'export')
+        handoff = self.scaleup()
+        self.binding.update(step_id=step, problem_ref=self.metadata,
+                            verified_ref=handoff['verified_ref'],
+                            scaleup_acceptance_ref=handoff['acceptance_ref'])
+        self.decision.update(stage='scaleup', problem_ref=self.metadata,
+                             mechanism_ref=self.metadata, verified_ref=handoff['verified_ref'])
+        self.dref = write(self.f.root, 'cd/later-decision.json', self.decision)
+        self.evidence.update(stage='scaleup', problem_ref=self.metadata, mechanism_ref=self.metadata)
+        self.eref = write(self.f.root, 'cd/later-experiment.json', self.evidence)
+        self.stage = json.loads((self.f.root / self.native_plan['provenance']['native_stage_ref']['path']).read_text())
+        self.protocol = json.loads((self.f.root / self.native_plan['protocol_ref']['path']).read_text())
+        self.protocol.update(cd_scaleup=handoff, cd_problem_ref=self.metadata)
+        self.protocol['cd_development'].update(stage='scaleup', cd_evidence_ref=self.eref)
+        self.stage.update(stage_kind=kind, cd_evidence_ref=self.eref)
+        self.native_plan['provenance']['cd_evidence_ref'] = self.eref
+        task['parameters'].update(sequence_binding=copy.deepcopy(self.binding), reasoning_ref=self.dref,
+                                  cd_evidence_ref=self.eref, research_scope='method')
+        return self.repin(task)
+
+    def repin(self, task):
+        self.protocol['protocol_digest'] = C.protocol_hash(self.protocol)
+        pref = write(self.f.root, 'cd/later-program.json', self.protocol)
+        self.stage['protocol_ref'] = pref
+        self.native_plan.update(protocol_ref=pref, protocol_digest=self.protocol['protocol_digest'],
+                                jobs=[copy.deepcopy(self.stage['job'])])
+        self.native_plan['provenance']['native_stage_ref'] = write(self.f.root, 'cd/later-stage.json', self.stage)
+        self.native_plan['plan_digest'] = R.plan_digest(self.native_plan)
+        self.plan['tasks'][0]['plan_ref'] = write(self.f.root, 'cd/later-native.json', self.native_plan)
+        self.plan['plan_digest'] = H.plan_digest(self.plan)
+        task['parameters']['harness_plan_ref'] = write(self.f.root, 'cd/later-harness.json', self.plan)
+        return task
+
+    def test_all_operational_stage_kinds_use_real_admission_after_scaleup(self):
+        for kind in ('prepare', 'software_check', 'calibrate', 'freeze', 'train', 'export'):
+            with self.subTest(kind=kind):
+                task = self.prepare(self.later_stage(kind))
+                self.assertTrue(admission.ScientificAdmission()(self.p, task))
+                self.assertEqual(self.native_plan['evidence_mode'], 'developmental')
+
+    def test_later_development_uses_coverage_without_formal_experiment_bindings(self):
+        task = self.prepare(self.later_stage(step='V03'))
+        c = Controller(self.f.root / 'coverage.db'); c.register_project(self.p)
+        p = ResearchProgram(c)
+        coverage = {'manifest': {'obligations': [
+            {'id': 'repair', 'kind': 'implementation', 'status': 'pending',
+             'task_ids': ['task'], 'evidence_refs': []}]}, 'report': {'eligible_jobs': []}}
+        p._coverage_tasks(self.p, [task], coverage, [])
+        task['parameters']['native_purpose'] = 'comparison'
+        with self.assertRaises(ContractError): p._coverage_tasks(self.p, [task], coverage, [])
+        task['parameters']['native_purpose'] = 'development_stage'
+        coverage['manifest']['obligations'][0]['task_ids'] = []
+        with self.assertRaises(ContractError): p._coverage_tasks(self.p, [task], coverage, [])
+
+    def test_accepted_handoff_is_required_even_for_software_repair(self):
+        task = self.later_stage('software_check')
+        task['parameters']['sequence_binding']['verified_ref'] = None
+        with self.assertRaisesRegex(ContractError, 'controller-owned verified handoff'):
+            self.prepare(task)
+
+    def test_scaleup_program_cannot_change_accepted_method_identity(self):
+        task = self.later_stage()
+        self.protocol['cd_problem_ref'] = self.eref
+        with self.assertRaises(ContractError): self.prepare(self.repin(task))
+        self.protocol['cd_problem_ref'] = self.metadata
+        self.protocol['candidate_id'] = 'another-method'
+        with self.assertRaises(ContractError): self.prepare(self.repin(task))
+
+    def test_actual_operational_code_may_change_but_not_claim_confirmation(self):
+        task = self.later_stage('software_check')
+        added = self.f.root / 'cd/compatibility.py'
+        added.write_text('# CUDA/library compatibility repair fixture\n')
+        self.stage['job']['code_refs'].append(C.reference(self.f.root, added))
+        self.assertTrue(admission.ScientificAdmission()(self.p, self.prepare(self.repin(task))))
+        self.native_plan['evidence_mode'] = 'prospective_confirmatory'
+        self.native_plan['plan_digest'] = R.plan_digest(self.native_plan)
+        with self.assertRaises(Exception): R.validate_plan(self.f.root, self.native_plan)
+
+    def test_online_quality_selection_and_forged_predecessor_still_rejected(self):
+        task = self.later_stage('train')
+        self.stage['selection_metric'] = 'accuracy'
+        with self.assertRaises(ContractError): self.prepare(self.repin(task))
+        self.stage['selection_metric'] = 'none'
+        self.stage['required_predecessor_ids'] = ['nonexistent']
+        with self.assertRaises(ContractError): self.prepare(self.repin(task))
+
+    def test_formal_purpose_cannot_reuse_operational_stage(self):
+        task = self.later_stage('export')
+        task['parameters']['native_purpose'] = 'comparison'
+        with self.assertRaisesRegex(ContractError, 'development evidence as confirmation'):
+            self.prepare(task)
+        scored = copy.deepcopy(self.protocol)
+        scored['evidence_mode'] = 'prospective_confirmatory'
+        scored['native_stage_program_ref'] = self.native_plan['protocol_ref']
+        scored['native_stage_exports'] = [{'native_stage_ref': self.native_plan['provenance']['native_stage_ref'],
+                                         'execution_bindings': self.stage['execution_bindings']}]
+        scored['protocol_digest'] = C.protocol_hash(scored)
+        scored_ref = write(self.f.root, 'cd/later-scored.json', scored)
+        self.assertFalse(NS.matches_scored_protocol(self.f.root, self.native_plan['protocol_ref'],
+                                                   scored_ref, self.native_plan['provenance']['native_stage_ref']))
+        scored['evidence_mode'] = 'developmental'
+        scored['protocol_digest'] = C.protocol_hash(scored)
+        scored_ref = write(self.f.root, 'cd/later-development-scored.json', scored)
+        self.assertTrue(NS.matches_scored_protocol(self.f.root, self.native_plan['protocol_ref'],
+                                                  scored_ref, self.native_plan['provenance']['native_stage_ref']))
+
+    def formal_task(self, adapted=False):
+        task = self.later_stage('export')
+        handoff = self.protocol['cd_scaleup']
+        self.protocol = self.f.protocol()
+        self.protocol.update(cd_scaleup=handoff, cd_problem_ref=self.metadata, candidate_id='candidate')
+        job = self.native_plan['jobs'][0]
+        job.update(arm_role='treatment', code_refs=[self.metadata])
+        if adapted:
+            repaired = self.f.root / 'cd/repaired-method.py'
+            repaired.write_text('# operational compatibility patch fixture\n')
+            job['code_refs'] = [C.reference(self.f.root, repaired)]
+            self.adaptation = {'kind': 'research-cd-operational-adaptation', 'schema_version': 1,
+                'goal_id': 'goal', 'candidate_id': 'candidate', 'verified_ref': handoff['verified_ref'],
+                'original_method_code_refs': [self.metadata], 'executed_method_code_refs': job['code_refs'],
+                'change_scope': 'operational_only', 'verification_status': 'pending_independent_review',
+                'change_description': 'Adapt native library launcher on the fixed GPU host.',
+                'preserved_semantics': 'Same algorithm, objective and information; inspect check evidence at phase review.',
+                'semantic_check_refs': [self.metadata]}
+            self.protocol['cd_adaptation_ref'] = write(self.f.root, 'cd/adaptation.json', self.adaptation)
+        self.protocol['native_eval_contract']['arm_requirements']['treatment']['implementation_refs'] = job['code_refs']
+        self.protocol['protocol_digest'] = C.protocol_hash(self.protocol)
+        pref = write(self.f.root, 'cd/formal-later-program.json', self.protocol)
+        self.native_plan.update(protocol_ref=pref, protocol_digest=self.protocol['protocol_digest'],
+                                evidence_mode='prospective_confirmatory', jobs=[job])
+        self.native_plan['provenance'].pop('native_stage_ref')
+        self.native_plan['limits'].update(max_confirmation_trials=1, max_development_trials=0)
+        self.native_plan['plan_digest'] = R.plan_digest(self.native_plan)
+        self.plan['tasks'][0]['plan_ref'] = write(self.f.root, 'cd/formal-later-native.json', self.native_plan)
+        self.plan['plan_digest'] = H.plan_digest(self.plan)
+        task['parameters'].update(native_purpose='comparison',
+            harness_plan_ref=write(self.f.root, 'cd/formal-later-harness.json', self.plan))
+        task['parameters'].pop('cd_evidence_ref')
+        return task
+
+    def test_exact_and_operationally_adapted_formal_methods_pass_canonical_admission(self):
+        for adapted in (False, True):
+            with self.subTest(adapted=adapted):
+                task = self.prepare(self.formal_task(adapted))
+                self.assertTrue(admission.ScientificAdmission()(self.p, task))
+                if adapted: self.assertIn(self.protocol['cd_adaptation_ref'], task['inputs'])
+
+    def test_adaptation_requires_actual_pins_and_cannot_declare_new_method_or_approval(self):
+        import research_cd as CD
+        task = self.formal_task(True)
+        report = CD.require_scaleup(self.f.root, self.protocol['cd_scaleup'])
+        actual = self.native_plan['jobs'][0]['code_refs']
+        for key, value in (('change_scope', 'new_method'), ('semantic_check_refs', []),
+                           ('verification_status', 'verified'), ('executed_method_code_refs', [self.metadata])):
+            with self.subTest(key=key):
+                changed = {**self.adaptation, key: value}
+                protocol = {**self.protocol, 'cd_adaptation_ref': write(self.f.root, 'cd/invalid-adaptation.json', changed)}
+                with self.assertRaises(ValueError):
+                    CD.scaleup_code_refs(self.f.root, protocol, self.protocol['cd_scaleup'], report, actual)
+        protocol = copy.deepcopy(self.protocol); protocol.pop('cd_adaptation_ref')
+        with self.assertRaisesRegex(ValueError, 'record an operational adaptation'):
+            CD.scaleup_code_refs(self.f.root, protocol, self.protocol['cd_scaleup'], report, actual)
+
+    def test_real_native_worker_executes_later_stage_without_scientific_acceptance(self):
+        from research_autopilot.remote import NativeWorker, NativeBridge, NativeTarget
+        task = self.prepare(self.later_stage('software_check'))
+        task['adapter'] = 'native'; self.p['adapters'].append('native')
+        c = Controller(self.f.root / 'worker.db', admission=admission.ScientificAdmission())
+        c.register_project(self.p); c.register_task(self.p['project_id'], task)
+        ResearchProgram(c)
+        state = {'phase': 'active', 'stage': 'execute', 'goal_id': 'goal',
+                 'execution_task_ids': ['task'], 'accepted_decision_ref': self.dref,
+                 'sequence': self.binding}
+        with c._transaction() as db:
+            db.execute('INSERT INTO research_programs VALUES(?,?,?,?)',
+                       (self.p['project_id'], '{}', json.dumps(state), 1))
+        bridge = NativeBridge(NativeTarget(root=str(self.f.root), skill_root=str(self.skill)),
+                              allow_local_scientific=True)
+        result = NativeWorker(c, bridge).run_once(self.p['project_id'], 'fixture-owner')
+        self.assertEqual(result['state'], 'completed', result)
+        context = json.loads((self.f.root / task['outputs'][0]).read_text())
+        self.assertFalse(context['scientific_verified'])
+        self.assertEqual(context['stage_kind'], 'software_check')
+        self.assertEqual(context['controller']['run_id'], result['attempt']['run_id'])
+
