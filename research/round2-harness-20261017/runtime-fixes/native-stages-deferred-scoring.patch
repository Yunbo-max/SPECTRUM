diff --git a/skills/research-autopilot/scripts/native_stages.py b/skills/research-autopilot/scripts/native_stages.py
new file mode 100644
index 0000000..52cac18
--- /dev/null
+++ b/skills/research-autopilot/scripts/native_stages.py
@@ -0,0 +1,159 @@
+"""Reviewed unscored C/D stages; never an evaluator or scientific gate."""
+import json,os
+from pathlib import Path
+import _autoresearch as C
+
+KINDS={'prepare','software_check','calibrate','train','export'}
+PROFILE='work-harness-cd-v1'
+
+def need(value,code):
+    if not value:C.fail('NATIVE_STAGE_'+code)
+
+def read(root,ref):return C.load_file(C.verify_ref(C.root_path(root),ref))
+def refs(root,values,nonempty=True):
+    need(isinstance(values,list) and (values or not nonempty),'REFS_REQUIRED')
+    for ref in values:C.verify_ref(C.root_path(root),ref)
+    return values
+
+def groups(program):
+    contracts=program.get('native_eval_contracts')
+    if contracts is not None:return contracts
+    return {g:program['native_eval_contract'] for g in program['required_groups']}
+
+def validate_program(root,p):
+    need(p.get('kind')=='research-native-stage-program' and p.get('stage_contract_version')==1,'PROGRAM_REQUIRED')
+    need(p.get('evidence_mode')=='developmental' and p.get('protocol_digest')==C.protocol_hash(p),'PROGRAM_DIGEST_OR_MODE')
+    d=p.get('cd_development',{})
+    need(d.get('flow_profile')==PROFILE and d.get('stage') in {'diagnosis','development'},'PROFILE_REQUIRED')
+    e=read(root,d.get('cd_evidence_ref'))
+    need(e.get('kind')=='research-cd-experiment' and e.get('flow_profile')==PROFILE
+         and e.get('stage')==d['stage'] and e.get('goal_id')==p.get('goal_id')
+         and e.get('candidate_id')==p.get('candidate_id'),'EXPERIMENT_IDENTITY')
+    pending=p.get('pending_scoring_obligations')
+    need(isinstance(pending,list) and pending and all(isinstance(x,str) and x for x in pending)
+         and len(pending)==len(set(pending)),'PENDING_SCORING_REQUIRED')
+    gs=p.get('required_groups');seeds=p.get('seed_policy',{}).get('seeds')
+    need(isinstance(gs,list) and gs and len(gs)==len(set(gs)),'GROUPS_REQUIRED')
+    need(isinstance(seeds,list) and seeds and all(type(s) is int and s>=0 for s in seeds),'SEEDS_REQUIRED')
+    result=[d['cd_evidence_ref']];contracts=groups(p)
+    need(set(contracts)==set(gs),'GROUP_CONTRACTS')
+    for g,contract in contracts.items():
+        need(isinstance(g,str) and g,'GROUP_ID')
+        for name in ('sample_manifest_ref','labels_or_tests_ref'):result+=refs(root,[contract.get(name)])
+        arms=contract.get('arm_requirements')
+        need(isinstance(arms,dict) and 'baseline' in arms and len(arms)>=2,'COMPARISON_REQUIRED')
+        for role,arm in arms.items():
+            need(isinstance(role,str) and role and role!='prerequisite','ROLE')
+            result+=refs(root,arm.get('implementation_refs'))
+    return result
+
+def validate_plan(root,native):
+    root=C.root_path(root)
+    ref=native['provenance'].get('native_stage_ref');s=read(root,ref)
+    need(set(s)=={'kind','schema_version','stage_id','stage_kind','protocol_ref','cd_evidence_ref','job',
+                  'scoring_dependency','dependency_analysis_ref','predecessor_receipt_refs','required_predecessor_ids','execution_bindings','selection_metric'},'DESCRIPTOR_FIELDS')
+    need(s['kind']=='research-native-stage' and s['schema_version']==1 and s['stage_kind'] in KINDS,'DESCRIPTOR_KIND')
+    need(isinstance(s['stage_id'],str) and s['stage_id'],'STAGE_ID')
+    need(native['purpose']=='scientific' and native['evidence_mode']=='developmental','DEVELOPMENT_ONLY')
+    need(native['protocol_ref']==s['protocol_ref'],'PROTOCOL_PIN')
+    p=read(root,s['protocol_ref']);result=validate_program(root,p)
+    need(native['protocol_digest']==p['protocol_digest'],'PROTOCOL_DIGEST')
+    need(s['cd_evidence_ref']==p['cd_development']['cd_evidence_ref']==native['provenance'].get('cd_evidence_ref'),'EVIDENCE_PIN')
+    need(s['scoring_dependency']=='deferred','ONLINE_SCORER_REQUIRED')
+    need(s['selection_metric'] in {'none','resource_memory','runtime'},'QUALITY_SELECTION_REQUIRES_SCORER')
+    bindings=s['execution_bindings']
+    need(isinstance(bindings,dict) and set(bindings)=={'model_refs','data_refs','selection_refs'},'EXECUTION_BINDINGS')
+    for key,values in bindings.items():
+        result+=refs(root,values,key!='selection_refs')
+        need(native['provenance'].get(key)==values,'PROVENANCE_BINDINGS')
+        need(all(r in s['job']['input_refs'] for r in values),'BOUND_INPUTS')
+    result+=refs(root,[ref,s['protocol_ref'],s['dependency_analysis_ref']])
+    need(native['jobs']==[s['job']],'EXACT_REVIEWED_JOB')
+    j=s['job'];need(j['output_paths'],'OUTPUTS_REQUIRED')
+    prefix='runs/stage-outputs/'+native['run_id']+'/'
+    need(all(path.startswith(prefix) and C.safe_path(root,path).relative_to(C.safe_path(root,prefix)).parts for path in j['output_paths']),'OUTPUT_NAMESPACE')
+    result+=refs(root,j['input_refs'],False)+refs(root,j['code_refs'])
+    if s['stage_kind']=='export':
+        need(j['group'] in p['required_groups'] and j['seed'] in p['seed_policy']['seeds'],'EXPORT_INVENTORY')
+        contract=groups(p)[j['group']];need(j['arm_role'] in contract['arm_requirements'],'EXPORT_ROLE')
+        required=contract['arm_requirements'][j['arm_role']]['implementation_refs']
+        need(all(r in j['code_refs'] for r in required),'EXPORT_CODE')
+        need(contract['sample_manifest_ref'] in j['input_refs'],'EXPORT_SAMPLES')
+    else:
+        need(j['arm_role']=='prerequisite' and j['group']=='prerequisite','PREREQUISITE_ROLE')
+    need(native['limits']['max_retries_per_trial']==0,'RECONCILE_BEFORE_RETRY')
+    expected=s['required_predecessor_ids'];need(isinstance(expected,list) and len(expected)==len(set(expected)),'PREDECESSOR_IDS')
+    actual=[]
+    for rr in refs(root,s['predecessor_receipt_refs'],False):
+        saved=read(root,rr);item=saved.get('controller',{});task=item.get('task',{})
+        need(item.get('state')=='completed' and task.get('action')=='native_harness','PREDECESSOR_COMPLETED_NATIVE')
+        outputs=refs(root,item.get('outputs'));retained=saved.get('retained_files',[])
+        need(any(o in j['input_refs'] for o in outputs),'PREDECESSOR_OUTPUT_NOT_CONSUMED')
+        need(all(any(row.get('original_ref')==o and row.get('archive_ref',{}).get('sha256')==o['sha256'] for row in retained) for o in outputs),'PREDECESSOR_ARCHIVES')
+        for row in retained:result+=refs(root,[row['archive_ref']])
+        h=read(root,task['parameters']['harness_plan_ref'])
+        for htask in h['tasks']:
+            n=read(root,htask['plan_ref']);ns=read(root,n['provenance'].get('native_stage_ref'))
+            result+=refs(root,[htask['plan_ref'],n['provenance']['native_stage_ref']])
+            need(n['protocol_ref']==native['protocol_ref'] and ns['protocol_ref']==native['protocol_ref'],'PREDECESSOR_PROGRAM')
+            actual.append(ns['stage_id'])
+        result+=outputs+[rr,task['parameters']['harness_plan_ref']]
+    need(sorted(actual)==sorted(expected),'PREDECESSOR_SET')
+    return s,p,list({(r['path'],r['sha256']):r for r in result}.values())
+
+def context(root,plan,job,attempt,workspace):
+    """Called after actual runtime authorization; static plans contain no approval flag."""
+    s,p,_=validate_plan(root,plan)
+    raw=os.environ.get('RESEARCH_NATIVE_CONTROLLER_CONTEXT')
+    need(raw is not None,'CONTROLLER_CONTEXT_REQUIRED');controller=json.loads(raw)
+    need(set(controller)=={'task_id','run_id','owner','fence'} and type(controller['fence']) is int
+         and controller['fence']>0 and all(isinstance(controller[k],str) and controller[k] for k in ('task_id','run_id','owner')),'CONTROLLER_CONTEXT')
+    value={'kind':'research-native-stage-context','schema_version':1,'controller':controller,
+           'run_id':plan['run_id'],'attempt_id':attempt.name,'trial_id':job['trial_id'],
+           'stage_id':s['stage_id'],'stage_kind':s['stage_kind'],'native_stage_ref':plan['provenance']['native_stage_ref'],
+           'protocol_ref':plan['protocol_ref'],'plan_digest':plan['plan_digest'],
+           'project_root':str(root),'workspace_root':str(workspace),'scientific_verified':False,
+           'dispatch_identity_sha256':os.environ.get('RESEARCH_NATIVE_DISPATCH_SHA256'),
+           'harness_context_ref':None}
+    hpath=os.environ.get('RESEARCH_NATIVE_HARNESS_CONTEXT')
+    if hpath:
+        h=Path(hpath);value['harness_context_ref']=C.reference(root,h)
+        actual=C.load_file(h);need(actual['native_plan_digest']==plan['plan_digest'],'HARNESS_CONTEXT_MISMATCH')
+    path=attempt/'native-stage-context.json'
+    with path.open('x') as f:f.write(C.canonical(value)+'\n')
+    return path
+
+def matches_scored_protocol(root,generation_ref,scored_ref,stage_ref=None):
+    if generation_ref==scored_ref:return True
+    scored=read(root,scored_ref)
+    if scored.get('native_stage_program_ref')!=generation_ref:return False
+    p=read(root,generation_ref);validate_program(root,p)
+    if stage_ref is None:return False
+    descriptor=read(root,stage_ref)
+    if descriptor.get('stage_kind')!='export':return False
+    if {'native_stage_ref':stage_ref,'execution_bindings':descriptor.get('execution_bindings')} not in scored.get('native_stage_exports',[]):return False
+    # Scorer is separately verified by the unchanged scientific verifier.
+    if (scored.get('cd_development')!=p['cd_development'] or scored.get('required_groups')!=p['required_groups']
+            or scored.get('seed_policy')!=p['seed_policy']):return False
+    import _native_eval as N
+    for g,contract in groups(p).items():
+        final=N.contract_for_group(scored,g)
+        for key in ('benchmark_id','benchmark_revision','split','sample_manifest_ref','labels_or_tests_ref',
+                    'arm_requirements','selection','primary_metric','metrics','prediction_format','sampling','budget','contrasts'):
+            if final.get(key)!=contract.get(key):return False
+    return True
+
+
+def publish_outputs(root,workspace,plan,job):
+    """Publish declared stage files exclusively; never replace old attempts."""
+    import shutil
+    outputs=[]
+    for relative in job['output_paths']:
+        source=C.safe_path(workspace,relative);target=C.safe_path(root,relative)
+        need(source.is_file() and not source.is_symlink(),'OUTPUT_MISSING_OR_LINK')
+        need(not target.exists(),'OUTPUT_ALREADY_EXISTS')
+        target.parent.mkdir(parents=True,exist_ok=True)
+        with source.open('rb') as src,target.open('xb') as dst:shutil.copyfileobj(src,dst)
+        need(C.filehash(source)==C.filehash(target),'OUTPUT_COPY_MISMATCH')
+        outputs.append(C.reference(root,target))
+    return outputs
