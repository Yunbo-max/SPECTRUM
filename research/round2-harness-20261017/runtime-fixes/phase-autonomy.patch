+"""Synthetic phase lineage regressions; these fixtures prove no science.
+
+Run on the authorized GPU host. Reuse the existing pinned/scorer fixtures and
+call real handoff, freeze and revisit code without replacing their validators.
+"""
+import copy
+import json
+import types
+import unittest
+
+import test_cd_admission as admission_base
+import test_cd_flow as flow_base
+from research_autopilot import cd_flow, phase_autonomy
+from research_autopilot.program import save_artifact, read_json
+import research_cd as CD
+
+
+class PhaseScaleupLineageTests(unittest.TestCase):
+    # Reuse fixture construction, without inheriting unrelated tests.
+    setUp = admission_base.CDAdmissionTests.setUp
+    lineage = admission_base.CDAdmissionTests.lineage
+    scaleup = admission_base.CDAdmissionTests.scaleup
+
+    def phase_handoff(self, start='H01'):
+        handoff = self.scaleup()
+        acceptance = CD.document(self.f.root, handoff['acceptance_ref'])
+        result = CD.response(self.f.root, acceptance['result_ref'])
+        review = CD.response(self.f.root, acceptance['review_ref'])
+        catalog = json.loads((admission_base.PACKAGE /
+                              'assets/skill-sequence-cd-v1.json').read_text())
+        ids = ['H01', 'H02', 'H03', 'H04', 'H05',
+               'M01', 'M02', 'M03', 'M04', 'M05']
+        ids = ids[ids.index(start):]
+        requirements = [node['id'] + '.' + row['id']
+                        for node in catalog['steps'] if node['id'] in ids
+                        for row in node['requirements']]
+        selected = {**acceptance['sequence'], 'step_id': start}
+        result.update(sequence=selected, findings=[
+            {'requirement_id': key, 'finding': 'Synthetic pinned phase evidence.',
+             'evidence_refs': [handoff['verified_ref']]} for key in requirements])
+        review.update(sequence=selected, requirements=[
+            {'requirement_id': key, 'satisfied': True,
+             'reason': 'Synthetic independent-review fixture.',
+             'evidence_refs': [handoff['verified_ref']]} for key in requirements])
+        acceptance.update(kind='research-skill-phase-acceptance',
+                          sequence=selected, milestone_ids=ids)
+        return self.repin(handoff, acceptance, result, review)
+
+    def repin(self, handoff, acceptance, result, review):
+        result_ref = admission_base.write(self.f.root, 'phase/result.json', result)
+        review['result_ref'] = result_ref
+        review_ref = admission_base.write(self.f.root, 'phase/review.json', review)
+        acceptance.update(result_ref=result_ref, review_ref=review_ref)
+        return {**handoff, 'acceptance_ref': admission_base.write(
+            self.f.root, 'phase/acceptance.json', acceptance)}
+
+    def test_complete_d_phase_is_a_valid_scaleup_handoff(self):
+        handoff = self.phase_handoff()
+        self.assertEqual(CD.require_scaleup(self.f.root, handoff)['candidate_id'],
+                         'candidate')
+
+    def test_resumed_d_phase_accepts_exact_remaining_milestones(self):
+        handoff = self.phase_handoff('M03')
+        self.assertEqual(CD.require_scaleup(self.f.root, handoff)['candidate_id'],
+                         'candidate')
+
+    def test_phase_handoff_rejects_missing_or_reordered_milestones(self):
+        for mutation in ('missing-middle', 'missing-gate', 'reordered'):
+            with self.subTest(mutation=mutation):
+                handoff = self.phase_handoff()
+                acceptance = CD.document(self.f.root, handoff['acceptance_ref'])
+                if mutation == 'missing-middle':
+                    acceptance['milestone_ids'].remove('H03')
+                elif mutation == 'missing-gate':
+                    acceptance['milestone_ids'].remove('M05')
+                else:
+                    acceptance['milestone_ids'][1:3] = ['H03', 'H02']
+                handoff['acceptance_ref'] = admission_base.write(
+                    self.f.root, 'phase/invalid-acceptance.json', acceptance)
+                with self.assertRaisesRegex(ValueError, 'exact remaining D milestones'):
+                    CD.require_scaleup(self.f.root, handoff)
+
+    def test_matching_result_and_review_cannot_omit_a_d_requirement(self):
+        handoff = self.phase_handoff()
+        acceptance = CD.document(self.f.root, handoff['acceptance_ref'])
+        result = CD.response(self.f.root, acceptance['result_ref'])
+        review = CD.response(self.f.root, acceptance['review_ref'])
+        missing = next(row['requirement_id'] for row in result['findings']
+                       if row['requirement_id'].startswith('H02.'))
+        result['findings'] = [row for row in result['findings']
+                              if row['requirement_id'] != missing]
+        review['requirements'] = [row for row in review['requirements']
+                                  if row['requirement_id'] != missing]
+        handoff = self.repin(handoff, acceptance, result, review)
+        with self.assertRaisesRegex(ValueError, 'phase omitted required D evidence'):
+            CD.require_scaleup(self.f.root, handoff)
+
+    def test_complete_phase_handoff_reaches_actual_e_freeze_gate(self):
+        handoff = self.phase_handoff()
+        protocol = self.f.protocol(frozen=False)
+        protocol.update(cd_scaleup=handoff, cd_problem_ref=self.metadata,
+                        candidate_id='candidate')
+        reference = admission_base.write(self.f.root, 'phase/formal-protocol.json', protocol)
+        with admission_base.C.locked(self.f.root):
+            frozen = admission_base.C.freeze_gate(types.SimpleNamespace(
+                protocol=str(self.f.root / reference['path']), gate='gate-a'), self.f.root)
+        self.assertEqual(frozen['status'], 'frozen')
+        state, events, _ = admission_base.C.project(self.f.root)
+        self.assertEqual(state['current_route'], 'execute_gate_a')
+        self.assertEqual(events[-1]['payload']['cd_scaleup'], handoff)
+        self.assertNotIn('natural_gate_0_ref', state)
+
+
+class PhaseRevisitLineageTests(unittest.TestCase):
+    def setUp(self):
+        self.fixture = flow_base.CDFlowTests()
+        self.addCleanup(self.fixture.doCleanups)
+        self.fixture.setUp()
+        self.fixture.config['sequence']['execution_mode'] = 'phase_autonomy'
+
+    def test_interior_c_revision_invalidates_entire_accepted_phase(self):
+        f = self.fixture
+        accepted = save_artifact(f.root, 'accepted-phase.json', {
+            'kind': 'research-skill-phase-acceptance', 'schema_version': 1,
+            'milestone_ids': ['B02', 'B03', 'B04', 'B05'],
+            'sequence': {'step_id': 'B02'},
+        })
+        f.seq.update(index=30, step_id='M02',
+                     accepted=[f.instruction] * 20 + [accepted] * 4 + [f.target] * 6,
+                     problem_ref=f.instruction, verified_ref=f.instruction,
+                     scaleup_acceptance_ref=f.instruction)
+        old_state = copy.deepcopy(f.prior['state'])
+        request = f.request('B04', 'revise')
+        reference = cd_flow.apply_revisit(f.project, f.prior, request,
+                                         f.instruction, f.instruction)
+        record = read_json(f.root, reference)
+        self.assertEqual(record['request']['target'], 'B04')
+        self.assertEqual(record['effective_target'], 'B02')
+        self.assertEqual(f.seq['step_id'], 'B02')
