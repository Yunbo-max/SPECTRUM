diff --git a/src/research_autopilot/prompt_experiments.py b/src/research_autopilot/prompt_experiments.py
new file mode 100644
index 0000000..1cdffe5
--- /dev/null
+++ b/src/research_autopilot/prompt_experiments.py
@@ -0,0 +1,147 @@
+"""Harness-managed long experiment sessions, with unconstrained research output.
+
+Keeps the existing consumer lease, program pause, logs and resume thread. Scientific
+work uses direct tools; no experiment admission, mailbox or response schema.
+"""
+from __future__ import annotations
+
+import json
+from contextlib import closing
+import os
+from pathlib import Path
+import subprocess
+import time
+
+from .artifacts import verify_ref
+from .models import ContractError, cumulative_time_limit
+
+
+def enabled(prior):
+    return prior['state'].get('experiment_autonomy', {}).get('enabled') is True
+
+
+def _thread(path):
+    # The transport emits thread.started before potentially large tool events.
+    try:
+        with path.open('rb') as stream:
+            for _ in range(12):
+                raw = stream.readline(65536)
+                if not raw:
+                    break
+                try:
+                    event = json.loads(raw)
+                except (ValueError, UnicodeDecodeError):
+                    continue
+                if event.get('type') == 'thread.started':
+                    return event.get('thread_id')
+    except FileNotFoundError:
+        pass
+    return None
+
+
+def _update(program, pid, **values):
+    current = program.status(pid)
+    current['state']['experiment_autonomy'].update(values)
+    return program._update(current, current['state'], 'experiment_session_observed')
+
+
+def run(controller, program, args, lease):
+    pid = args.project
+    project = controller.get_project(pid)
+    root = Path(project['root'])
+    maximum = 1 if args.command == 'tick' else args.max_ticks
+    count = 0
+    while maximum is None or count < maximum:
+        prior = program.status(pid)
+        if prior['state']['phase'] != 'active' or not enabled(prior):
+            return 0
+        program._policy(project, prior['contract'])
+        with closing(controller._connect()) as db:
+            live = db.execute("SELECT 1 FROM tasks WHERE project_id=? AND state NOT IN ('completed','failed','cancelled') LIMIT 1", (pid,)).fetchone()
+            historic_seconds = db.execute('SELECT spent_seconds FROM projects WHERE project_id=?', (pid,)).fetchone()[0]
+        if live:
+            lease.observed('reconcile_existing_task_before_experiment_session')
+            time.sleep(5)
+            continue
+        settings = prior['state']['experiment_autonomy']
+        remaining = settings.get('not_before', 0) - time.time()
+        if remaining > 0:
+            lease.observed('experiment_continuation_backoff')
+            time.sleep(min(remaining, 5))
+            continue
+        spent = historic_seconds + settings.get('elapsed_seconds', 0)
+        allowance = cumulative_time_limit(project) - spent
+        if allowance <= 0:
+            lease.observed('existing_user_time_budget_exhausted')
+            return 0
+        instruction = verify_ref(root, settings['instruction_ref']).read_text()
+        adapter = json.loads(verify_ref(root, prior['contract']['agent_config_ref']).read_text())
+        binary = adapter['adapters'][prior['contract']['planner']['adapter']]['argv'][0]
+        attempt = settings.get('attempt', 0) + 1
+        directory = root / 'research-state/harness/experiment-sessions' / f'{attempt:06d}'
+        directory.mkdir(parents=True, exist_ok=True)
+        # New directory numbers survive interruption because state precedes spawn.
+        events = directory / 'events.jsonl'
+        errors = directory / 'stderr.log'
+        response = directory / 'summary.md'
+        prompt = instruction + '\n\nContinue the same research now. Read the living handbook and previous session notes. Reconcile remote jobs before launching anything. Use real tool execution, preserve evidence, update memory before ending a turn. A turn ending is not scientific completion. The Harness will resume this same conversation automatically. Do not wait for the old phase-native mailbox or generate its proposals.\n'
+        (directory / 'prompt.md').write_text(prompt)
+        argv = [binary, 'exec']
+        thread = settings.get('thread_id')
+        if thread:
+            argv += ['resume']
+        argv += ['-c', 'sandbox_mode="danger-full-access"', '-c', 'approval_policy="never"',
+                 '-m', settings['model'], '--skip-git-repo-check', '--json',
+                 '--output-last-message', str(response)]
+        if thread:
+            argv += [thread]
+        argv += ['-']
+        _update(program, pid, attempt=attempt, status='starting', directory=str(directory.relative_to(root)),
+                started_at=time.time(), worker_pid=None)
+        started = time.monotonic()
+        child = None
+        rc = None
+        try:
+            with events.open('wb') as out, errors.open('wb') as err:
+                child = subprocess.Popen(argv, cwd=root, stdin=subprocess.PIPE, stdout=out, stderr=err,
+                                         env=os.environ.copy())
+                _update(program, pid, status='running', worker_pid=child.pid)
+                child.stdin.write(prompt.encode()); child.stdin.close()
+                while child.poll() is None:
+                    current = program.status(pid)
+                    if current['state']['phase'] != 'active' or not enabled(current):
+                        break
+                    if time.monotonic() - started >= allowance:
+                        break
+                    found = _thread(events)
+                    if found and found != thread:
+                        thread = found
+                        _update(program, pid, thread_id=thread)
+                    lease.observed('experiment_worker_running')
+                    time.sleep(3)
+                rc = child.poll()
+        finally:
+            # The existing host guard reconciles descendants on consumer shutdown.
+            # Never terminate a detached remote scientific job from this transport.
+            if child is not None and child.poll() is None:
+                child.terminate()
+                try:
+                    child.wait(timeout=15)
+                except subprocess.TimeoutExpired:
+                    child.kill(); child.wait(timeout=5)
+            if child is not None:
+                rc = child.returncode
+            current = program.status(pid)
+            now = current['state']['experiment_autonomy']
+            found = _thread(events)
+            failures = 0 if rc == 0 else now.get('consecutive_transport_failures', 0) + 1
+            delay = 30 if rc == 0 else min(600, 30 * 2 ** min(failures, 5))
+            _update(program, pid, status='between_turns' if rc == 0 else 'transport_retry',
+                    worker_pid=None, thread_id=found or thread, exit_code=rc,
+                    elapsed_seconds=now.get('elapsed_seconds', 0) + time.monotonic() - started,
+                    consecutive_transport_failures=failures, not_before=time.time() + delay,
+                    summary_path=str(response.relative_to(root)) if response.exists() else None)
+        count += 1
+        lease.observed('experiment_turn_retained')
+        print(json.dumps({'status': 'experiment_turn_retained', 'attempt': attempt, 'exit_code': rc}), flush=True)
+    return 0
