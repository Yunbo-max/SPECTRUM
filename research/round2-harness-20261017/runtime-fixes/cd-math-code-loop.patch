+def require_scaleup(root, handoff):
+    """Replay a pinned M05 handoff; runtime additionally binds its trusted pin.
+
+    CLI freezing checks this artifact lineage. It cannot authorize dispatch; the
+    program/controller separately requires its own accepted verified_ref.
+    """
+    need(isinstance(handoff, dict) and set(handoff) == {'flow_profile', 'verified_ref', 'acceptance_ref'}
+         and handoff['flow_profile'] == PROFILE, 'typed C/D scaleup handoff required')
+    report = document(root, handoff['verified_ref'])
+    need(report.get('kind') == 'research-cd-scaleup' and report.get('schema_version') == 1,
+         'scaleup report schema required')
+    acceptance = document(root, handoff['acceptance_ref'])
+    seq = acceptance.get('sequence', {})
+    need(acceptance.get('kind') == 'research-skill-step-acceptance' and acceptance.get('schema_version') == 1
+         and acceptance.get('disposition') == 'accepted' and seq.get('flow_profile') == PROFILE
+         and seq.get('step_id') == 'M05' and acceptance.get('cd_gate_ref') == handoff['verified_ref']
+         and acceptance.get('goal_id') == report.get('goal_id'), 'scaleup lacks accepted M05 lineage')
+    text(acceptance.get('review_run_id'), 'actual review run')
+    need(acceptance.get('planner_task_id') != acceptance.get('reviewer_task_id'), 'independent review required')
+    result = response(root, acceptance['result_ref']); review = response(root, acceptance['review_ref'])
+    proposal = document(root, acceptance['proposal_ref'])
+    need(result.get('kind') == 'research-skill-step-result' and result.get('sequence') == seq
+         and result.get('goal_id') == report['goal_id'] and result.get('tasks') == [], 'M05 result mismatch')
+    need(review.get('kind') == 'research-skill-step-review' and review.get('approved') is True
+         and review.get('sequence') == seq and review.get('result_ref') == acceptance['result_ref']
+         and review.get('proposal_ref') == acceptance['proposal_ref']
+         and review.get('goal_id') == report['goal_id'], 'M05 independent review mismatch')
+    need(proposal.get('goal_id') == report['goal_id'] and proposal.get('tasks') == []
+         and proposal.get('decision_ref') == result.get('decision_ref'), 'M05 proposal mismatch')
+    findings = result.get('findings'); requirements = review.get('requirements')
+    need(isinstance(findings, list) and findings and isinstance(requirements, list) and requirements,
+         'M05 findings and reviews required')
+    ids = {row['requirement_id'] for row in findings}
+    need(len(ids) == len(findings) == len(requirements)
+         and {row['requirement_id'] for row in requirements} == ids
+         and all(row.get('satisfied') is True for row in requirements), 'M05 requirements incomplete')
+    need(any(handoff['verified_ref'] in row.get('evidence_refs', []) for row in findings)
+         and any(handoff['verified_ref'] in row.get('evidence_refs', []) for row in requirements),
+         'M05 review did not examine scaleup report')
+    verification = document(root, acceptance.get('cd_verification_ref'))
+    scored = verification.get('report', {})
+    need(verification.get('kind') == 'research-cd-scientific-verification'
+         and verification.get('schema_version') == 1 and verification.get('goal_id') == report['goal_id']
+         and verification.get('proposal_ref') == acceptance['proposal_ref']
+         and verification.get('cd_gate_ref') == handoff['verified_ref'], 'M05 scorer receipt identity mismatch')
+    need(scored.get('ready') is True and scored.get('native_replay_executed') is True
+         and scored.get('goal_id') == report['goal_id'] and scored.get('proposal_ref') == acceptance['proposal_ref']
+         and scored.get('cd_gate_ref') == handoff['verified_ref'], 'M05 requires actual ready native scoring')
+    measured = scored.get('scored_runs')
+    need(isinstance(measured, list) and measured, 'M05 needs scored development runs')
+    need(verification.get('scored_runs') == report.get('scored_runs'), 'M05 scoring differs from accepted report')
+    need(verification.get('scored_runs') == [{'protocol_ref': row['protocol_ref'], 'manifest_ref': row['manifest_ref']}
+                                           for row in measured], 'M05 scorer run inventory mismatch')
+    for row in measured:
+        need(row.get('baseline_qualified') is True and row.get('positive_control_passed') is True,
+             'M05 baseline and controls must qualify')
+        refs(root, [row['protocol_ref'], row['manifest_ref']], 'scored native inputs')
+        refs(root, row.get('proof_refs'), 'native scorer proofs', nonempty=True)
+    replays = scored.get('native_replays')
+    need(isinstance(replays, list) and replays and type(scored.get('native_replay_count')) is int
+         and scored['native_replay_count'] == len(replays), 'M05 requires retained native scorer executions')
+    for replay in replays: refs(root, [replay.get('execution_ref')], 'native scorer execution')
+    refs(root, [verification.get('identity_ref'), verification.get('native_receipt_ref')], 'scorer provenance')
+    text(verification.get('run_id'), 'scorer actual run'); text(verification.get('task_id'), 'scorer task')
+    for row in findings + requirements: refs(root, row.get('evidence_refs'), 'M05 evidence', nonempty=True)
+    for key in ('problem_ref', 'mechanism_ref', 'code_ref', 'protocol_ref', 'exposure_ref'):
+        refs(root, [report.get(key)], key)
+    expected_code = code_identity(root, report.get('method_code_refs'))
+    need(report['code_ref'] in report['method_code_refs'], 'primary code reference is outside complete method identity')
+    refs(root, report.get('analysis_refs'), 'actual analysis', nonempty=True)
+    runs = refs(root, report.get('run_receipt_refs'), 'actual local runs', nonempty=True)
+    check_scored_lineage(root, report)
+    matched_method = False
+    for ref in runs:
+        receipt = document(root, ref); controller = receipt.get('controller', {})
+        need(controller.get('state') == 'completed' and controller.get('task', {}).get('action') == 'native_harness'
+             and controller.get('attempt', {}).get('run_id'), 'scaleup requires actual completed native receipts')
+        harness = document(root, controller['task'].get('parameters', {}).get('harness_plan_ref'))
+        for item in harness.get('tasks', []):
+            native = document(root, item.get('plan_ref'))
+            if native.get('protocol_ref') != report['protocol_ref']:
+                continue
+            treatments = [job for job in native.get('jobs', []) if job.get('arm_role') == 'treatment']
+            for job in treatments:
+                need(code_identity(root, job.get('code_refs')) == expected_code,
+                     'D treatment run differs from complete verified method identity')
+                matched_method = True
+    need(matched_method, 'scaleup lacks a treatment run with its exact protocol and full code identity')
+    need(isinstance(report.get('e_obligations'), list) and report['e_obligations'], 'formal E obligations required')
+    obligations = report.get('obligations')
+    need(isinstance(obligations, list) and obligations, 'scaleup evidence obligations required')
+    for row in obligations:
+        text(row.get('id'), 'obligation'); text(row.get('finding'), 'finding')
+        refs(root, row.get('evidence_refs'), 'obligation evidence', nonempty=True)
+    return report
