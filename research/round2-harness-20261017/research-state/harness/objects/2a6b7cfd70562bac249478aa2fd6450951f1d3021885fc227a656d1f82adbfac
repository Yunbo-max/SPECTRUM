{"task_id": "Mbpp/256", "original_task_id": 256, "entry_point": "count_Primes_nums", "prompt": "Write a python function to count the number of prime numbers less than a given non-negative number.\n\nImplement this Python function. Return only the complete implementation.\ndef count_Primes_nums(n):\n    pass", "original_prompt": "Write a python function to count the number of prime numbers less than a given non-negative number.", "prompt_protocol": "mbpp-function-interface-v1", "interface_source": "reference-ast-signature-only", "reference": "def count_Primes_nums(n):\r\n    ctr = 0\r\n    for num in range(n):\r\n        if num <= 1:\r\n            continue\r\n        for i in range(2,num):\r\n            if (num % i) == 0:\r\n                break\r\n        else:\r\n            ctr += 1\r\n    return ctr", "tests": "assert count_Primes_nums(5) == 2\nassert count_Primes_nums(10) == 4\nassert count_Primes_nums(100) == 25", "source": "google-research-datasets/mbpp", "split": "eval", "original_split": "test", "dataset_config": "full", "revision": "4bb6404fdc6cacfda99d4ac4205087b89d32030c", "split_seed": 42, "dataset_fingerprint": null}
{"task_id": "Mbpp/257", "original_task_id": 257, "entry_point": "swap_numbers", "prompt": "Write a function to swap two numbers.\n\nImplement this Python function. Return only the complete implementation.\ndef swap_numbers(a, b):\n    pass", "original_prompt": "Write a function to swap two numbers.", "prompt_protocol": "mbpp-function-interface-v1", "interface_source": "reference-ast-signature-only", "reference": "def swap_numbers(a,b):\r\n temp = a\r\n a = b\r\n b = temp\r\n return (a,b)", "tests": "assert swap_numbers(10,20)==(20,10)\nassert swap_numbers(15,17)==(17,15)\nassert swap_numbers(100,200)==(200,100)", "source": "google-research-datasets/mbpp", "split": "eval", "original_split": "test", "dataset_config": "full", "revision": "4bb6404fdc6cacfda99d4ac4205087b89d32030c", "split_seed": 42, "dataset_fingerprint": null}
{"task_id": "Mbpp/258", "original_task_id": 258, "entry_point": "count_odd", "prompt": "Write a function to find number of odd elements in the given list using lambda function.\n\nImplement this Python function. Return only the complete implementation.\ndef count_odd(array_nums):\n    pass", "original_prompt": "Write a function to find number of odd elements in the given list using lambda function.", "prompt_protocol": "mbpp-function-interface-v1", "interface_source": "reference-ast-signature-only", "reference": "def count_odd(array_nums):\r\n   count_odd = len(list(filter(lambda x: (x%2 != 0) , array_nums)))\r\n   return count_odd", "tests": "assert count_odd([1, 2, 3, 5, 7, 8, 10])==4\nassert count_odd([10,15,14,13,-18,12,-20])==2\nassert count_odd([1, 2, 4, 8, 9])==2", "source": "google-research-datasets/mbpp", "split": "eval", "original_split": "test", "dataset_config": "full", "revision": "4bb6404fdc6cacfda99d4ac4205087b89d32030c", "split_seed": 42, "dataset_fingerprint": null}
{"task_id": "Mbpp/259", "original_task_id": 259, "entry_point": "maximize_elements", "prompt": "Write a function to maximize the given two tuples.\n\nImplement this Python function. Return only the complete implementation.\ndef maximize_elements(test_tup1, test_tup2):\n    pass", "original_prompt": "Write a function to maximize the given two tuples.", "prompt_protocol": "mbpp-function-interface-v1", "interface_source": "reference-ast-signature-only", "reference": "def maximize_elements(test_tup1, test_tup2):\r\n  res = tuple(tuple(max(a, b) for a, b in zip(tup1, tup2))\r\n   for tup1, tup2 in zip(test_tup1, test_tup2))\r\n  return (res) ", "tests": "assert maximize_elements(((1, 3), (4, 5), (2, 9), (1, 10)), ((6, 7), (3, 9), (1, 1), (7, 3))) == ((6, 7), (4, 9), (2, 9), (7, 10))\nassert maximize_elements(((2, 4), (5, 6), (3, 10), (2, 11)), ((7, 8), (4, 10), (2, 2), (8, 4))) == ((7, 8), (5, 10), (3, 10), (8, 11))\nassert maximize_elements(((3, 5), (6, 7), (4, 11), (3, 12)), ((8, 9), (5, 11), (3, 3), (9, 5))) == ((8, 9), (6, 11), (4, 11), (9, 12))", "source": "google-research-datasets/mbpp", "split": "eval", "original_split": "test", "dataset_config": "full", "revision": "4bb6404fdc6cacfda99d4ac4205087b89d32030c", "split_seed": 42, "dataset_fingerprint": null}
{"task_id": "Mbpp/260", "original_task_id": 260, "entry_point": "newman_prime", "prompt": "Write a function to find the nth newman–shanks–williams prime number.\n\nImplement this Python function. Return only the complete implementation.\ndef newman_prime(n):\n    pass", "original_prompt": "Write a function to find the nth newman–shanks–williams prime number.", "prompt_protocol": "mbpp-function-interface-v1", "interface_source": "reference-ast-signature-only", "reference": "def newman_prime(n): \r\n\tif n == 0 or n == 1: \r\n\t\treturn 1\r\n\treturn 2 * newman_prime(n - 1) + newman_prime(n - 2)", "tests": "assert newman_prime(3) == 7 \nassert newman_prime(4) == 17\nassert newman_prime(5) == 41", "source": "google-research-datasets/mbpp", "split": "eval", "original_split": "test", "dataset_config": "full", "revision": "4bb6404fdc6cacfda99d4ac4205087b89d32030c", "split_seed": 42, "dataset_fingerprint": null}
{"task_id": "Mbpp/261", "original_task_id": 261, "entry_point": "division_elements", "prompt": "Write a function to perform mathematical division operation across the given tuples.\n\nImplement this Python function. Return only the complete implementation.\ndef division_elements(test_tup1, test_tup2):\n    pass", "original_prompt": "Write a function to perform mathematical division operation across the given tuples.", "prompt_protocol": "mbpp-function-interface-v1", "interface_source": "reference-ast-signature-only", "reference": "def division_elements(test_tup1, test_tup2):\r\n  res = tuple(ele1 // ele2 for ele1, ele2 in zip(test_tup1, test_tup2))\r\n  return (res) ", "tests": "assert division_elements((10, 4, 6, 9),(5, 2, 3, 3)) == (2, 2, 2, 3)\nassert division_elements((12, 6, 8, 16),(6, 3, 4, 4)) == (2, 2, 2, 4)\nassert division_elements((20, 14, 36, 18),(5, 7, 6, 9)) == (4, 2, 6, 2)", "source": "google-research-datasets/mbpp", "split": "eval", "original_split": "test", "dataset_config": "full", "revision": "4bb6404fdc6cacfda99d4ac4205087b89d32030c", "split_seed": 42, "dataset_fingerprint": null}
{"task_id": "Mbpp/262", "original_task_id": 262, "entry_point": "split_two_parts", "prompt": "Write a function to split a given list into two parts where the length of the first part of the list is given.\n\nImplement this Python function. Return only the complete implementation.\ndef split_two_parts(list1, L):\n    pass", "original_prompt": "Write a function to split a given list into two parts where the length of the first part of the list is given.", "prompt_protocol": "mbpp-function-interface-v1", "interface_source": "reference-ast-signature-only", "reference": "def split_two_parts(list1, L):\r\n    return list1[:L], list1[L:]", "tests": "assert split_two_parts([1,1,2,3,4,4,5,1],3)==([1, 1, 2], [3, 4, 4, 5, 1])\nassert split_two_parts(['a', 'b', 'c', 'd'],2)==(['a', 'b'], ['c', 'd'])\nassert split_two_parts(['p', 'y', 't', 'h', 'o', 'n'],4)==(['p', 'y', 't', 'h'], ['o', 'n'])", "source": "google-research-datasets/mbpp", "split": "eval", "original_split": "test", "dataset_config": "full", "revision": "4bb6404fdc6cacfda99d4ac4205087b89d32030c", "split_seed": 42, "dataset_fingerprint": null}
{"task_id": "Mbpp/263", "original_task_id": 263, "entry_point": "merge_dict", "prompt": "Write a function to merge two dictionaries.\n\nImplement this Python function. Return only the complete implementation.\ndef merge_dict(d1, d2):\n    pass", "original_prompt": "Write a function to merge two dictionaries.", "prompt_protocol": "mbpp-function-interface-v1", "interface_source": "reference-ast-signature-only", "reference": "def merge_dict(d1,d2):\r\n d = d1.copy()\r\n d.update(d2)\r\n return d", "tests": "assert merge_dict({'a': 100, 'b': 200},{'x': 300, 'y': 200})=={'x': 300, 'y': 200, 'a': 100, 'b': 200}\nassert merge_dict({'a':900,'b':900,'d':900},{'a':900,'b':900,'d':900})=={'a':900,'b':900,'d':900,'a':900,'b':900,'d':900}\nassert merge_dict({'a':10,'b':20},{'x':30,'y':40})=={'x':30,'y':40,'a':10,'b':20}", "source": "google-research-datasets/mbpp", "split": "eval", "original_split": "test", "dataset_config": "full", "revision": "4bb6404fdc6cacfda99d4ac4205087b89d32030c", "split_seed": 42, "dataset_fingerprint": null}
{"task_id": "Mbpp/264", "original_task_id": 264, "entry_point": "dog_age", "prompt": "Write a function to calculate a dog's age in dog's years.\n\nImplement this Python function. Return only the complete implementation.\ndef dog_age(h_age):\n    pass", "original_prompt": "Write a function to calculate a dog's age in dog's years.", "prompt_protocol": "mbpp-function-interface-v1", "interface_source": "reference-ast-signature-only", "reference": "def dog_age(h_age):\r\n if h_age < 0:\r\n \texit()\r\n elif h_age <= 2:\r\n\t d_age = h_age * 10.5\r\n else:\r\n\t d_age = 21 + (h_age - 2)*4\r\n return d_age", "tests": "assert dog_age(12)==61\nassert dog_age(15)==73\nassert dog_age(24)==109", "source": "google-research-datasets/mbpp", "split": "eval", "original_split": "test", "dataset_config": "full", "revision": "4bb6404fdc6cacfda99d4ac4205087b89d32030c", "split_seed": 42, "dataset_fingerprint": null}
