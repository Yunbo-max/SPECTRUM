{"task_id": "Mbpp/890", "original_task_id": 890, "entry_point": "find_Extra", "prompt": "Write a python function to find the index of an extra element present in one sorted array.\n\nImplement this Python function. Return only the complete implementation.\ndef find_Extra(arr1, arr2, n):\n    pass", "original_prompt": "Write a python function to find the index of an extra element present in one sorted array.", "prompt_protocol": "mbpp-function-interface-v1", "interface_source": "reference-ast-signature-only", "reference": "def find_Extra(arr1,arr2,n) : \r\n    for i in range(0, n) : \r\n        if (arr1[i] != arr2[i]) : \r\n            return i \r\n    return n ", "tests": "assert find_Extra([1,2,3,4],[1,2,3],3) == 3\nassert find_Extra([2,4,6,8,10],[2,4,6,8],4) == 4\nassert find_Extra([1,3,5,7,9,11],[1,3,5,7,9],5) == 5", "source": "google-research-datasets/mbpp", "split": "train", "original_split": "train", "dataset_config": "full", "revision": "4bb6404fdc6cacfda99d4ac4205087b89d32030c", "split_seed": 42, "dataset_fingerprint": null}
