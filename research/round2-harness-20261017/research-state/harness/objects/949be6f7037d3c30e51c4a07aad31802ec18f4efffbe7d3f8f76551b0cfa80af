{"task_id": "Mbpp/673", "original_task_id": 673, "entry_point": "convert", "prompt": "Write a python function to convert a list of multiple integers into a single integer.\n\nImplement this Python function. Return only the complete implementation.\ndef convert(list):\n    pass", "original_prompt": "Write a python function to convert a list of multiple integers into a single integer.", "prompt_protocol": "mbpp-function-interface-v1", "interface_source": "reference-ast-signature-only", "reference": "def convert(list): \r\n    s = [str(i) for i in list] \r\n    res = int(\"\".join(s))  \r\n    return (res) ", "tests": "assert convert([1,2,3]) == 123\nassert convert([4,5,6]) == 456\nassert convert([7,8,9]) == 789", "source": "google-research-datasets/mbpp", "split": "train", "original_split": "train", "dataset_config": "full", "revision": "4bb6404fdc6cacfda99d4ac4205087b89d32030c", "split_seed": 42, "dataset_fingerprint": null}
{"task_id": "Mbpp/717", "original_task_id": 717, "entry_point": "sd_calc", "prompt": "Write a function to calculate the standard deviation.\n\nImplement this Python function. Return only the complete implementation.\ndef sd_calc(data):\n    pass", "original_prompt": "Write a function to calculate the standard deviation.", "prompt_protocol": "mbpp-function-interface-v1", "interface_source": "reference-ast-signature-only", "reference": "import math\r\nimport sys\r\ndef sd_calc(data):\r\n    n = len(data)\r\n    if n <= 1:\r\n        return 0.0\r\n    mean, sd = avg_calc(data), 0.0\r\n    for el in data:\r\n        sd += (float(el) - mean)**2\r\n    sd = math.sqrt(sd / float(n-1))\r\n    return sd\r\ndef avg_calc(ls):\r\n    n, mean = len(ls), 0.0\r\n    if n <= 1:\r\n        return ls[0]\r\n    for el in ls:\r\n        mean = mean + float(el)\r\n    mean = mean / float(n)\r\n    return mean", "tests": "assert sd_calc([4, 2, 5, 8, 6])== 2.23606797749979\nassert sd_calc([1,2,3,4,5,6,7])==2.160246899469287\nassert sd_calc([5,9,10,15,6,4])==4.070217029430577", "source": "google-research-datasets/mbpp", "split": "train", "original_split": "train", "dataset_config": "full", "revision": "4bb6404fdc6cacfda99d4ac4205087b89d32030c", "split_seed": 42, "dataset_fingerprint": null}
