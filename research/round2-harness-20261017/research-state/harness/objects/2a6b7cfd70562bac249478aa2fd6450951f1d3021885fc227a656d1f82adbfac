{"task_id": "Mbpp/950", "original_task_id": 950, "entry_point": "chinese_zodiac", "prompt": "Write a function to display sign of the chinese zodiac for given year.\n\nImplement this Python function. Return only the complete implementation.\ndef chinese_zodiac(year):\n    pass", "original_prompt": "Write a function to display sign of the chinese zodiac for given year.", "prompt_protocol": "mbpp-function-interface-v1", "interface_source": "reference-ast-signature-only", "reference": "def chinese_zodiac(year):\r\n if (year - 2000) % 12 == 0:\r\n     sign = 'Dragon'\r\n elif (year - 2000) % 12 == 1:\r\n     sign = 'Snake'\r\n elif (year - 2000) % 12 == 2:\r\n     sign = 'Horse'\r\n elif (year - 2000) % 12 == 3:\r\n     sign = 'sheep'\r\n elif (year - 2000) % 12 == 4:\r\n     sign = 'Monkey'\r\n elif (year - 2000) % 12 == 5:\r\n     sign = 'Rooster'\r\n elif (year - 2000) % 12 == 6:\r\n     sign = 'Dog'\r\n elif (year - 2000) % 12 == 7:\r\n     sign = 'Pig'\r\n elif (year - 2000) % 12 == 8:\r\n     sign = 'Rat'\r\n elif (year - 2000) % 12 == 9:\r\n     sign = 'Ox'\r\n elif (year - 2000) % 12 == 10:\r\n     sign = 'Tiger'\r\n else:\r\n     sign = 'Hare'\r\n return sign", "tests": "assert chinese_zodiac(1997)==('Ox')\nassert chinese_zodiac(1998)==('Tiger')\nassert chinese_zodiac(1994)==('Dog')", "source": "google-research-datasets/mbpp", "split": "train", "original_split": "train", "dataset_config": "full", "revision": "4bb6404fdc6cacfda99d4ac4205087b89d32030c", "split_seed": 42, "dataset_fingerprint": null}
