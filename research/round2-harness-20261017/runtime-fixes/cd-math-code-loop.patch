+            max_cost=0, max_seconds=45, inputs=inputs, instructions=[packet_ref], outputs=['cd/response.json'],
+            parameters={'harness_role':'verifier', **{k:self.packet[k] for k in
+                ('goal_id','proposal_ref','coverage_ref','native_target_ref')}}))
+        output = origin / 'cd/response.json'
+        wrapper = {'instruction_handoff': {'task':selected, 'project_root':str(origin),
+            'project_id':'fixture', 'workflow_class':'scientific_method', 'role':'local_executor',
+            'skill_root':str(SKILL), 'skill_digest':self.project['skill_digest'], 'run_id':'fixture-transport-run',
+            'instructions':[{**packet_ref,'text':(origin/packet_ref['path']).read_text()}]},
+            'response_protocol':{'response_path':str(output),'response_mode':'json',
+                'task_deadline_unix':time.time()+45}}
+        digest = closure_worker.runtime_source_digest()
+        actual_run = subprocess.run
+        def target_transport(argv, **kw):
+            self.assertEqual(argv[0], 'ssh')
+            return actual_run([sys.executable, '-I', '-B', '-c', closure_worker._TARGET, digest], **kw)
+        with patch.object(closure_worker.subprocess, 'run', target_transport):
+            result = closure_worker.execute(wrapper, str(output), digest)
+        self.assertTrue(result['report']['ready'])
+        self.assertNotIn('scoring_artifacts', result)
+        self.assertTrue(result['evidence_refs'])
+        for reference in result['evidence_refs']:
+            C.verify_ref(origin, reference)
