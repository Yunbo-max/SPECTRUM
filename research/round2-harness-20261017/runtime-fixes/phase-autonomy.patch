@@ -0,0 +1,196 @@
+"""Phase guidance aggregation fixtures; never scientific experiment evidence.
+
+These tests call the public pure functions with the actual catalog. They must
+be run on the authorized GPU host, not on the local research workstation.
+"""
+import copy
+import json
+from pathlib import Path
+import unittest
+
+from research_autopilot import phase_autonomy as phase
+from research_autopilot import skill_sequence as sequence
+from research_autopilot.models import ContractError
+
+
+class PhaseAutonomyTests(unittest.TestCase):
+    def setUp(self):
+        root = Path(__file__).resolve().parents[2]
+        self.catalog = json.loads((root / 'skills/research-autopilot/assets/'
+                                   'skill-sequence-cd-v1.json').read_text())
+        self.contract = {
+            'schema_version': 2,
+            'sequence': {'mode': 'repeat', 'scopes': ['research'],
+                         'flow_profile': 'work-harness-cd-v1',
+                         'execution_mode': 'phase_autonomy'},
+        }
+
+    def step(self, key):
+        return next(item for item in self.catalog['steps'] if item['id'] == key)
+
+    def prior(self, key, *, visit=None):
+        return {'contract': copy.deepcopy(self.contract), 'state': {
+            'goal_id': 'phase-behavior-fixture', 'phase': 'active', 'stage': 'planner',
+            'sequence': {
+                'flow_profile': 'work-harness-cd-v1', 'epoch': 1, 'cycle': 1,
+                'catalog_sha256': 'a' * 64,
+                'attempt': 1, 'step_id': key,
+                'index': next(i for i, item in enumerate(self.catalog['steps'])
+                              if item['id'] == key),
+                'visit': visit, 'accepted': [],
+            },
+        }}
+
+    def expand(self, key, prior=None):
+        return phase.expand(self.catalog, prior or self.prior(key), self.step(key))
+
+    def test_only_explicit_phase_mode_enables_aggregation(self):
+        self.assertTrue(phase.enabled(self.contract))
+        legacy = copy.deepcopy(self.contract)
+        del legacy['sequence']['execution_mode']
+        self.assertFalse(phase.enabled(legacy))
+        self.assertFalse(phase.enabled({'schema_version': 1}))
+
+    def test_b01_setup_remains_standalone_with_exact_qualification_requirements(self):
+        self.assertEqual(self.expand('B01'), self.step('B01'))
+
+    def test_c_runs_through_problem_gate_without_entering_method_development(self):
+        result = self.expand('S01')
+        self.assertEqual(result['id'], 'S01')
+        self.assertEqual(result['milestone_ids'],
+                         ['S01', 'E01', 'B02', 'B03', 'B04', 'B05'])
+        self.assertEqual(result['gate_step_id'], 'B05')
+
+    def test_adoption_inside_c_does_not_repeat_previously_completed_milestones(self):
+        result = self.expand('B02')
+        self.assertEqual(result['id'], 'B02')
+        self.assertEqual(result['milestone_ids'], ['B02', 'B03', 'B04', 'B05'])
+        self.assertEqual(result['gate_step_id'], 'B05')
+
+    def test_d_stops_at_verified_gate_before_formal_e(self):
+        result = self.expand('H01')
+        self.assertEqual(result['id'], 'H01')
+        self.assertEqual(result['milestone_ids'],
+                         ['H01', 'H02', 'H03', 'H04', 'H05',
+                          'M01', 'M02', 'M03', 'M04', 'M05'])
+        self.assertEqual(result['gate_step_id'], 'M05')
+
+    def test_mid_d_restart_keeps_only_remaining_milestones(self):
+        result = self.expand('M03')
+        self.assertEqual(result['id'], 'M03')
+        self.assertEqual(result['milestone_ids'], ['M03', 'M04', 'M05'])
+        self.assertEqual(result['gate_step_id'], 'M05')
+
+    def test_requirements_preserve_each_nodes_evidence_and_disambiguate_ids(self):
+        # Repeated requirement names must not erase one node's acceptance duty.
+        self.step('B02')['requirements'] = [
+            {'id': 'evidence', 'description': 'Measured diagnostic observations.'}]
+        self.step('B03')['requirements'] = [
+            {'id': 'evidence', 'description': 'Credible strong-method comparison.'}]
+        self.step('B04')['requirements'] = [
+            {'id': 'boundary', 'description': 'Specific conditions and falsifier.'}]
+        self.step('B05')['requirements'] = [
+            {'id': 'gate', 'description': 'Actual scoring and independent acceptance.'}]
+        result = self.expand('B02')
+        ordinary = [row for row in result['requirements'] if row['id'] != 'C.method_basis']
+        self.assertEqual(ordinary, [
+            {'id': 'B02.evidence', 'description': 'Measured diagnostic observations.'},
+            {'id': 'B03.evidence', 'description': 'Credible strong-method comparison.'},
+            {'id': 'B04.boundary', 'description': 'Specific conditions and falsifier.'},
+            {'id': 'B05.gate', 'description': 'Actual scoring and independent acceptance.'},
+        ])
+
+    def test_every_c_entry_including_singleton_gate_requires_method_basis(self):
+        for key in ['S01', 'E01', 'B02', 'B03', 'B04', 'B05']:
+            with self.subTest(start=key):
+                ids = [row['id'] for row in self.expand(key)['requirements']]
+                self.assertEqual(ids.count('C.method_basis'), 1)
+        for key in ['B01', 'L04', 'H01', 'G02']:
+            with self.subTest(outside_c=key):
+                self.assertNotIn('C.method_basis',
+                                 [row['id'] for row in self.expand(key)['requirements']])
+
+    def test_result_rejects_omitted_method_basis_before_accepting_c(self):
+        # Exercise the real result boundary. No controller/native/scorer is
+        # required: incomplete findings must fail before any of those effects.
+        prior = self.prior('B02')
+        step = self.expand('B02', prior)
+        response = {
+            'kind': 'research-skill-step-result', 'schema_version': 1,
+            'goal_id': prior['state']['goal_id'],
+            'sequence': sequence.binding(prior['state']),
+            'summary': 'All ordinary diagnostic findings, but no method basis.',
+            'findings': [{'requirement_id': row['id'], 'finding': 'Fixture finding.',
+                          'evidence_refs': []} for row in step['requirements']
+                         if row['id'] != 'C.method_basis'],
+            'decision_ref': None, 'coverage_ref': None, 'tasks': [],
+        }
+        self.assertIn('C.method_basis', [row['id'] for row in step['requirements']])
+        with self.assertRaisesRegex(ContractError, 'report every prescribed requirement'):
+            sequence._result(None, prior, {}, response, step, [])
+
+    def test_sources_include_all_milestones_once(self):
+        self.step('B02')['sources'] = ['shared.md', 'diagnosis.md']
+        self.step('B03')['sources'] = ['shared.md', 'strong-methods.md']
+        self.step('B04')['sources'] = ['boundary.md', 'diagnosis.md']
+        self.step('B05')['sources'] = ['gate.md', 'shared.md']
+        result = self.expand('B02')
+        self.assertEqual(set(result['sources']),
+                         {'shared.md', 'diagnosis.md', 'strong-methods.md',
+                          'boundary.md', 'gate.md'})
+        self.assertEqual(len(result['sources']), 5)
+
+    def test_unauthorized_scope_is_a_boundary_not_a_node_to_skip(self):
+        self.step('B03')['scope'] = 'manuscript'
+        result = self.expand('B02')
+        self.assertEqual(result.get('milestone_ids', [result['id']]), ['B02'])
+        self.assertNotEqual(result.get('gate_step_id'), 'B05')
+        self.assertNotIn('B04', result.get('milestone_ids', []))
+
+    def test_even_authorized_different_scope_starts_a_separate_phase(self):
+        self.step('B03')['scope'] = 'manuscript'
+        prior = self.prior('B02')
+        prior['contract']['sequence']['scopes'].append('manuscript')
+        result = self.expand('B02', prior)
+        self.assertEqual(result.get('milestone_ids', [result['id']]), ['B02'])
+
+    def test_source_visit_reads_only_requested_b_node(self):
+        prior = self.prior('L04', visit={
+            'origin_index': 20, 'origin_step': 'B02', 'origin_attempt': 2,
+            'request_ref': {'path': 'visit.json', 'sha256': 'a' * 64}})
+        result = self.expand('L04', prior)
+        self.assertEqual(result['id'], 'L04')
+        self.assertEqual(result.get('milestone_ids', [result['id']]), ['L04'])
+        self.assertEqual(result['sources'], self.step('L04')['sources'])
+
+    def test_e_setup_cannot_cross_freeze_into_execution(self):
+        result = self.expand('S02')
+        milestones = result.get('milestone_ids', [result['id']])
+        self.assertEqual(milestones,
+                         ['S02', 'S03', 'S04', 'E02', 'S05', 'G01', 'G02'])
+        self.assertEqual(result['gate_step_id'], 'G02')
+        self.assertNotIn('G03', milestones)
+        self.assertNotIn('E03', milestones)
+        self.assertNotIn('G04', milestones)
+        self.assertTrue(set(milestones) <=
+                        {'S02', 'S03', 'S04', 'E02', 'S05', 'G01', 'G02'})
+
+    def test_freeze_itself_cannot_bundle_post_freeze_execution(self):
+        result = self.expand('G02')
+        self.assertEqual(result.get('milestone_ids', [result['id']]), ['G02'])
+
+    def test_legacy_expansion_preserves_original_step(self):
+        prior = self.prior('B02')
+        del prior['contract']['sequence']['execution_mode']
+        self.assertEqual(self.expand('B02', prior), self.step('B02'))
+
+    def test_aggregation_does_not_mutate_catalog_or_durable_cursor(self):
+        prior = self.prior('B02')
+        old_catalog, old_prior = copy.deepcopy(self.catalog), copy.deepcopy(prior)
+        self.expand('B02', prior)
+        self.assertEqual(self.catalog, old_catalog)
+        self.assertEqual(prior, old_prior)
+
+
+if __name__ == '__main__':
+    unittest.main()
