@@ -0,0 +1,276 @@
+"""B01 configuration acceptance; engineering fixtures never qualify a scorer."""
+import copy
+import unittest
+from unittest.mock import patch
+
+import test_b01_qualification as base
+from research_autopilot.artifacts import canonical_json
+from research_autopilot.models import ContractError
+from research_autopilot.program import save_artifact, read_json
+from research_autopilot import skill_sequence as sequence
+
+
+class B01SetupTests(unittest.TestCase):
+    def setUp(self):
+        base.B01QualificationTests.setUp(self)
+        self.output = save_artifact(self.root, 'startup-output.json', {'output': 'upstream version/import help'})
+        self.config_ref = save_artifact(self.root, 'eval-config.json', {'task': 'benchmark'})
+        self.receipt = save_artifact(self.root, 'startup.json', {
+            'target_ref': self.target, 'command': 'python -m upstream --help',
+            'interpreter': '/venv/bin/python', 'exit_code': 0, 'output_ref': self.output})
+        self.report = {'kind': 'research-b01-setup-report', 'schema_version': 1,
+            'project_id': 'p', 'goal_id': 'goal', 'target_ref': self.target,
+            'dataset': {'source': 'upstream dataset', 'revision': 'fixed commit',
+                'configuration': 'full', 'split': 'test', 'evidence_refs': [self.output]},
+            'executor': {'source': 'upstream implementation', 'version': 'fixed commit',
+                'provenance': 'community', 'official': False, 'evidence_refs': [self.output]},
+            'environment': {'interpreter': '/venv/bin/python', 'configuration_ref': self.config_ref},
+            'startup': {'command': 'python -m upstream --help', 'exit_code': 0, 'receipt_ref': self.receipt},
+            'runtime_gaps': ['Actual scoring and baseline qualification remain pending'],
+            'scoring_status': 'pending'}
+        self.report_ref = save_artifact(self.root, 'setup-report.json', self.report)
+        self.policy = {'kind': 'research-b01-setup-policy', 'schema_version': 1,
+            'project_id': 'p', 'goal_id': 'goal', 'step_id': 'B01',
+            'instruction_ref': self.instruction, 'target_ref': self.target, 'report_ref': self.report_ref}
+        self.policy_ref = save_artifact(self.root, 'setup-policy.json', self.policy)
+
+    def adopt(self):
+        return self.program.adopt_b01_setup('p', self.policy_ref, expected_revision=7)
+
+    def test_owner_adoption_preserves_history_budget_and_catalog(self):
+        budget = self.controller.status('p')['budget']
+        adopted = self.adopt()
+        self.assertEqual(adopted['revision'], 8)
+        self.assertEqual(adopted['contract']['sequence']['b01_setup_ref'], self.policy_ref)
