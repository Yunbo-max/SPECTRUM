+"""Configuration-stage wording preserves the formal-research alternative."""
+import json
+from pathlib import Path
+import unittest
+
+SKILL = Path(__file__).resolve().parents[2] / 'skills/research-autopilot'
+
+
+class B01SetupGuidanceTests(unittest.TestCase):
+    def test_catalog_keeps_formal_contract_and_exact_requirement_ids(self):
+        catalog = json.loads((SKILL / 'assets/skill-sequence.json').read_text())
+        step = next(s for s in catalog['steps'] if s['id'] == 'B01')
+        self.assertEqual([r['id'] for r in step['requirements']],
+                         ['task_endpoint', 'evaluation_identity', 'measurement_fit'])
+        requirement = next(r for r in step['requirements'] if r['id'] == 'evaluation_identity')
+        self.assertIn('formal contract', requirement['description'])
+        self.assertIn('setup is not required', requirement['description'])
+        self.assertIn('references/b01-upstream-setup.md', step['sources'])
+
+    def test_shared_guidance_preserves_configuration_scoring_boundary(self):
+        guide = (SKILL / 'references/b01-upstream-setup.md').read_text()
+        self.assertIn('Startup success proves only configuration/startup', guide)
+        self.assertIn('scoring stage', guide)
+        self.assertIn('formal-only', guide)
+
+
+if __name__ == '__main__':
+    unittest.main()
