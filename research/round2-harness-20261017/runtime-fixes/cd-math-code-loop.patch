@@ -0,0 +1,416 @@
+"""Pinned checks for Work Harness C/D development; never a scientific verdict.
+
+Controller-owned sequence bindings select this policy. Development retains native
+scoring/provenance checks while avoiding prerequisites whose evidence it produces.
+"""
+from pathlib import Path
+import hashlib
+import json
+import _autoresearch as C
+
+PROFILE = 'work-harness-cd-v1'
+CATALOG = 'assets/skill-sequence-cd-v1.json'
+C_STEPS = {'B01', 'S01', 'E01', 'B02', 'B03', 'B04', 'B05'}
+B_STEPS = {'L01', 'L02', 'L03', 'X02', 'L04', 'X03', 'L05'}
+D_STEPS = {'H01', 'H02', 'H03', 'H04', 'H05', 'M01', 'M02', 'M03', 'M04', 'M05'}
+
+
+def need(value, message):
+    if not value:
+        raise ValueError(message)
+
+
+def text(value, label):
+    need(isinstance(value, str) and bool(value.strip()), label + ' requires text')
+
+
+def unique(pairs):
+    result = {}
+    for key, value in pairs:
+        need(key not in result, 'duplicate JSON key')
+        result[key] = value
+    return result
+
+
+def document(root, ref):
+    path = C.verify_ref(C.root_path(root), ref)
+    raw = path.read_bytes()
+    need(len(raw) <= 2 * 1024 * 1024, 'C/D metadata exceeds byte bound')
+    value = json.loads(raw, object_pairs_hook=unique,
+                       parse_constant=lambda _: (_ for _ in ()).throw(ValueError('nonfinite JSON')))
+    need(isinstance(value, dict), 'C/D document must be an object')
+    return value
+
+
+def refs(root, values, label, *, nonempty=False):
+    need(isinstance(values, list) and (values or not nonempty), label + ' requires references')
+    seen = {}
+    for ref in values:
+        C.verify_ref(C.root_path(root), ref)
+        need(ref['path'] not in seen or seen[ref['path']] == ref['sha256'], 'conflicting reference pins')
+        seen[ref['path']] = ref['sha256']
+    return values
+
+
+def code_identity(root, values):
+    refs(root, values, 'complete method code identity', nonempty=True)
+    identity = {(ref['path'], ref['sha256']) for ref in values}
+    need(len(identity) == len(values), 'method code identity contains duplicate references')
+    return identity
+
+
+def binding(project, task):
+    selected = task.get('parameters', {}).get('sequence_binding', {})
+    need(selected.get('flow_profile') == PROFILE, 'C/D requires adopted flow profile')
+    need(type(selected.get('epoch')) is int and selected['epoch'] >= 1, 'C/D requires adopted epoch')
+    source = Path(project['skill_root']) / CATALOG
+    need(source.is_file() and hashlib.sha256(source.read_bytes()).hexdigest() == selected.get('catalog_sha256'),
+         'C/D catalog pin mismatch')
+    marker = Path(project['skill_root']) / 'assets/harness-policy.json'
+    need(marker.is_file() and json.loads(marker.read_text()).get('edition') == 'autonomous-rsi-harness',
+         'C/D policy belongs to Work Harness')
+    need(project.get('workflow_class') == 'scientific_method', 'C/D requires scientific project')
+    return selected
+
+
+def decision_refs(root, reference, goal_id, previous_ref=None, receipt_refs=None):
+    """Validate append-only selections and input pins, without accepting science."""
+    result, visited, current, newest = [], set(), reference, None
+    while current is not None:
+        identity = (current['path'], current['sha256'])
+        need(identity not in visited, 'C/D decision chain cycle')
+        visited.add(identity)
+        d = document(root, current)
+        need(d.get('kind') == 'research-cd-decision' and type(d.get('schema_version')) is int
+             and d['schema_version'] == 1, 'C/D decision schema required')
+        need(d.get('goal_id') == goal_id, 'C/D decision goal mismatch')
+        need(d.get('stage') in {'diagnosis', 'development', 'scaleup'}, 'invalid C/D decision stage')
+        text(d.get('rationale'), 'decision rationale')
+        ids = d.get('selected_task_ids')
+        need(isinstance(ids, list) and len(ids) == len(set(ids)), 'unique selected task IDs required')
+        for item in ids: text(item, 'selected task')
+        evidence = refs(root, d.get('evidence_refs'), 'decision evidence')
+        observed = refs(root, d.get('observed_receipt_refs'), 'observed receipt refs')
+        for key in ('problem_ref', 'mechanism_ref', 'verified_ref', 'previous_ref'):
+            need(key in d, 'decision requires explicit ' + key)
+            if d[key] is not None:
+                refs(root, [d[key]], key)
+                result.append(d[key])
+        if d['stage'] in {'development', 'scaleup'}:
+            need(d['problem_ref'] is not None and d['mechanism_ref'] is not None,
+                 'development requires problem and mechanism records')
+        if d['stage'] == 'scaleup': need(d['verified_ref'] is not None, 'scaleup requires verified evidence')
+        if newest is None:
+            newest = d
+            if previous_ref is not None and reference != previous_ref:
+                need(d['previous_ref'] == previous_ref, 'C/D decision must extend accepted decision')
+            for ref in receipt_refs or []:
+                need(ref in observed, 'C/D decision did not consume actual host receipt')
+        else:
+            for ref in observed:
+                need(ref in newest['observed_receipt_refs'], 'C/D decision erased observed receipts')
+        result.extend([current, *evidence, *observed])
+        current = d['previous_ref']
+        # Adoption can extend one legacy v4 decision without reinterpreting it.
+        if current is not None:
+            prior = document(root, current)
+            if prior.get('kind') == 'research_decision':
+                need(prior.get('schema_version') == 4 and prior.get('goal_id') == goal_id,
+                     'invalid legacy adoption predecessor')
+                result.append(current)
+                break
+    return list({(r['path'], r['sha256']): r for r in result}.values())
+
+
+def check_task(project, task, *, accepted_ref=None, goal_id=None, expand=False):
+    selected = binding(project, task)
+    q = task['parameters']; root = project['root']; reference = q.get('reasoning_ref')
+    need(reference is not None and reference == accepted_ref, 'C/D requires current accepted decision')
+    need(q.get('goal_id') == goal_id, 'C/D task goal mismatch')
+    required = decision_refs(root, reference, goal_id)
+    d = document(root, reference)
+    need(task['task_id'] in d['selected_task_ids'], 'C/D task was not selected')
+    stage = ('diagnosis' if selected['step_id'] in C_STEPS | B_STEPS else
+             'development' if selected['step_id'] in D_STEPS else 'scaleup')
+    investment = task['action'] in {'candidate_code', 'experiment_design', 'native_harness', 'result_verify'}
+    if investment: need(d['stage'] == stage, 'C/D decision differs from adopted stage')
+    if not investment:
+        need(task['action'] in {'source_read', 'math_review', 'writing'}, 'unsupported acquisition action')
+    elif stage == 'scaleup':
+        need(selected.get('verified_ref') is not None and d['verified_ref'] == selected['verified_ref'],
+             'scaleup requires controller-owned verified handoff')
+        handoff = {'flow_profile': PROFILE, 'verified_ref': selected['verified_ref'],
+                   'acceptance_ref': selected.get('scaleup_acceptance_ref')}
+        report = require_scaleup(root, handoff)
+        need(report['goal_id'] == goal_id and report['problem_ref'] == d['problem_ref']
+             and report['mechanism_ref'] == d['mechanism_ref'], 'scaleup decision differs from accepted method')
+        required.extend([handoff['verified_ref'], handoff['acceptance_ref']])
+        if task['action'] == 'native_harness':
+            need(q.get('native_purpose', 'comparison') == 'comparison', 'E must use formal comparison purpose')
+            plan = document(root, q.get('harness_plan_ref'))
+            found_treatment = False
+            for item in plan['tasks']:
+                native = document(root, item['plan_ref'])
+                protocol = document(root, native['protocol_ref'])
+                need(protocol.get('cd_scaleup') == handoff, 'E protocol lacks current accepted scaleup handoff')
+                need(protocol.get('cd_problem_ref') == report['problem_ref'], 'E protocol problem mismatch')
+                need(not protocol.get('cd_development') and native['evidence_mode'] != 'developmental',
+                     'E cannot reuse development evidence as confirmation')
+                treatments = [job for job in native['jobs'] if job['arm_role'] == 'treatment']
+                found_treatment = found_treatment or bool(treatments)
+                need(all(code_identity(root, job['code_refs']) == code_identity(root, report['method_code_refs'])
+                         for job in treatments),
+                     'E treatment code changed; reopen D and obtain a new verified report')
+            need(found_treatment, 'E comparison must execute the verified treatment')
+        # Official E method checks continue in admission.CHECK.
+    elif investment:
+        need(q.get('research_scope') == ('diagnostic' if stage == 'diagnosis' else 'method'),
+             'C/D research scope mismatch')
+        if stage == 'development':
+            need(selected.get('problem_ref') is not None and d['problem_ref'] == selected['problem_ref'],
+                 'D requires controller-owned accepted problem')
+        eref = q.get('cd_evidence_ref'); e = document(root, eref)
+        need(e.get('kind') == 'research-cd-experiment' and type(e.get('schema_version')) is int
+             and e['schema_version'] == 1 and e.get('flow_profile') == PROFILE, 'C/D experiment schema required')
+        need(e.get('stage') == stage and e.get('goal_id') == goal_id
+             and e.get('candidate_id') == q.get('candidate_id'), 'C/D experiment identity mismatch')
+        text(e.get('candidate_id'), 'candidate identity')
+        for key in ('question', 'mathematical_object', 'prediction', 'falsifier', 'code_plan', 'uncertainty_plan'):
+            text(e.get(key), key)
+        need(isinstance(e.get('assumptions'), list) and e['assumptions'], 'explicit assumptions required')
+        for assumption in e['assumptions']: text(assumption, 'assumption')
+        for key in ('problem_ref', 'mechanism_ref'):
+            need(key in e and e[key] == d[key], 'experiment ' + key + ' differs from decision')
+        required.append(eref)
+        for key in ('benchmark_ref', 'model_ref', 'dataset_ref', 'evaluation_ref', 'exposure_log_ref'):
+            required.extend(refs(root, [e.get(key)], key, nonempty=True))
+        required.extend(refs(root, e.get('condition_source_refs'), 'condition sources', nonempty=True))
+        mappings = e.get('code_bindings')
+        need(isinstance(mappings, list), 'code bindings required')
+        if task['action'] != 'candidate_code': need(mappings, 'concrete math-code bindings required')
+        code_refs = []
+        for item in mappings:
+            for key in ('mathematical_object', 'location'): text(item.get(key), 'code binding ' + key)
+            code_refs.extend(refs(root, [item.get('code_ref')], 'mapped code'))
+        required.extend(code_refs)
+        controls = e.get('controls')
+        need(isinstance(controls, list) and controls, 'C/D controls required')
+        for control in controls:
+            text(control.get('name'), 'control name'); text(control.get('rationale'), 'control rationale')
+            required.extend(refs(root, control.get('implementation_refs'), 'control implementation',
+                                 nonempty=task['action'] == 'native_harness'))
+        if task['action'] == 'native_harness':
+            qualification = q.get('native_purpose') == 'qualification'
+            if qualification:
+                need(selected['step_id'] == 'B01' and stage == 'diagnosis', 'qualification exception belongs to B01 diagnosis')
+                aref = q.get('qualification_authorization_ref'); authorization = document(root, aref)
+                need(authorization.get('kind') == 'research-b01-qualification-authorization'
+                     and authorization.get('schema_version') == 1 and authorization.get('step_id') == 'B01'
+                     and authorization.get('native_purpose') == 'qualification'
+                     and authorization.get('project_id') == project.get('project_id')
+                     and authorization.get('goal_id') == goal_id, 'B01 owner authorization identity mismatch')
+                need(type(authorization.get('max_task_seconds')) in (int, float)
+                     and 0 < task['max_seconds'] <= authorization['max_task_seconds'], 'B01 qualification exceeds owner scope')
+                if q.get('native_target_ref') is not None:
+                    need(q['native_target_ref'] == authorization.get('native_target_ref'), 'B01 qualification target mismatch')
+                required.extend(refs(root, [aref, authorization.get('instruction_ref'),
+                                           authorization.get('native_target_ref')], 'B01 owner authorization'))
+            else:
+                need(q.get('native_purpose') == 'development', 'C/D native purpose must be development')
+            import run_harness as H
+            href = q.get('harness_plan_ref'); plan = document(root, href)
+            H.validate_plan(root, plan)
+            required.append(href)
+            need(plan['limits']['max_parallel_tasks'] == 1 and plan['gpus']['max_tasks_per_gpu'] == 1,
+                 'one development experiment at a time required')
+            need(plan['limits']['total_wall_seconds'] <= task['max_seconds'], 'native time exceeds reservation')
+            actual_code = []; actual_roles = set()
+            for item in plan['tasks']:
+                need(item['resources']['allow_gpu_share'] is False, 'GPU sharing not allowed')
+                native = document(root, item['plan_ref']); required.append(item['plan_ref'])
+                need(native['purpose'] == 'scientific' and native['evidence_mode'] == 'developmental',
+                     'C/D runs must retain scientific development identity')
+                need(native['provenance'].get('cd_evidence_ref') == eref, 'native development evidence mismatch')
+                protocol = document(root, native['protocol_ref']); required.append(native['protocol_ref'])
+                need(not protocol.get('method_discovery'), 'development cannot mix legacy discovery contracts')
+                need(protocol.get('cd_development') == {'flow_profile': PROFILE, 'stage': stage, 'cd_evidence_ref': eref},
+                     'protocol development evidence mismatch')
+                for job in native['jobs']:
+                    actual_code.extend(job['code_refs']); actual_roles.add(job['arm_role'])
+            need(all(ref in actual_code for ref in code_refs), 'mapped code is absent from native jobs')
+            need(all(ref in actual_code for control in controls for ref in control['implementation_refs']),
+                 'declared control implementation is absent from native jobs')
+            if qualification:
+                need('baseline' in actual_roles and 'treatment' not in actual_roles,
+                     'B01 qualification permits baseline and controls, never treatment')
+            else:
+                need('baseline' in actual_roles and len(actual_roles) >= 2, 'development requires actual control comparison')
+    inventory = task['inputs'] + task['instructions']
+    for ref in required:
+        if ref not in inventory:
+            need(expand, 'C/D transitive evidence was not pinned at intake')
+            need(not any(r['path'] == ref['path'] for r in inventory), 'C/D conflicting immutable input pin')
+            inventory.append(ref)
+    return inventory
+
