+"""Keep the GPU intake entry points and executable documentation consistent."""
+import json
+from pathlib import Path
+import re
+import unittest
+
+from research_autopilot.gpu_preflight import validate_requirements
+
+ROOT = Path(__file__).resolve().parents[2]
+SKILL = ROOT / 'skills/research-autopilot'
+
+
+class GPUIntakeGuidanceTests(unittest.TestCase):
+    def test_documented_requirements_are_accepted(self):
+        text = (SKILL / 'references/gpu-intake-feasibility.md').read_text()
+        values = [json.loads(value) for value in re.findall(r'```json\n(.*?)\n```', text, re.S)]
+        requirements = [value for value in values if 'stage' in value]
+        self.assertEqual(len(requirements), 1)
+        validate_requirements(requirements[0])
+
+    def test_entry_points_link_gpu_intake(self):
+        for path in ('SKILL.md', 'references/initial-intake.md',
+                     'references/local-execution.md', 'references/gpu-host-runtime.md'):
+            with self.subTest(path=path):
+                self.assertIn('gpu-intake-feasibility.md', (SKILL / path).read_text())
+
+    def test_runtime_guidance_keeps_gpu_intake_with_local_execution(self):
+        text = (SKILL / 'assets/runtime-guidance.json').read_text()
+        self.assertEqual(text.count('references/local-execution.md'),
+                         text.count('references/gpu-intake-feasibility.md'))
+        self.assertGreater(text.count('references/gpu-intake-feasibility.md'), 0)
+
+
+if __name__ == '__main__':
+    unittest.main()
