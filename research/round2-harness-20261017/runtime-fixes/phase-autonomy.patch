+def execution_protocol(controller, claim, run_dir):
+    if (claim['task']['parameters'].get('harness_role') != 'planner'
+            or claim['task']['parameters'].get('phase_autonomy') is not True):
+        return None
+    with controller._transaction() as db:
+        context = {k: claim[k] for k in ('project_id', 'run_id', 'owner', 'fence')}
+        controller._phase_parent(db, context)
+    path = Path(run_dir) / 'phase-context.json'
+    with path.open('x') as stream:
+        stream.write(canonical_json(context) + '\n')
+    path.chmod(0o600)
+    return {'context_path': str(path),
+        'argv': [sys.executable, '-m', 'research_autopilot.program_cli', '--db', controller.db_path,
+                 'phase-native', '--context', str(path), '--request', 'ABSOLUTE_REQUEST_JSON'],
+        'request_schema': {'request_id': 'unique stable local request ID', 'task': 'one native_harness task',
+                           'decision_ref': 'pinned selection decision', 'coverage_ref': 'pinned coverage'},
+        'instructions': 'Prepare and sync pinned inputs to the fixed target, invoke this argv with your request file, read returned receipt_refs. Retry the identical request to observe its original identity; never relaunch an unknown run. Final phase decision must consume all returned native receipts including failures. Parent wall time and native time are conservatively accounted separately; no budget is reset.'}
+
+
+def execute(controller, context, request):
+    from .program_cli import ProgramDispatcher
+    fields(context, {'project_id', 'run_id', 'owner', 'fence'})
+    fields(request, {'request_id', 'task', 'decision_ref', 'coverage_ref'})
+    request_digest = contract_hash(request)
+    with controller._transaction() as db:
+        controller._phase_parent(db, context)
+        existing = db.execute('SELECT * FROM phase_native_requests WHERE parent_run_id=? AND request_id=?',
+                              (context['run_id'], request['request_id'])).fetchone()
+        if existing and existing['request_digest'] != request_digest:
+            raise ContractError('phase request ID reused with changed content')
+    program = ResearchProgram(controller)
+    prior = program.status(context['project_id'])
+    project = controller.get_project(context['project_id'])
+    program._policy(project, prior['contract'])
+    if not enabled(prior['contract']):
+        raise ContractError('phase execution mode was not adopted')
+    dispatch = ProgramDispatcher(controller, program, context['project_id'], context['owner'] + '.phase')
+    if existing:
+        item = controller.get_task(context['project_id'], existing['task_id'])
+    else:
+        task = json_data(request['task'])
+        if task.get('action') != 'native_harness' or task.get('adapter') != 'native':
+            raise ContractError('phase-native accepts only native work, not nested agent tasks')
+        from .skill_sequence import _cursor, _allowed_actions, _qualification_tasks
+        _, step = _cursor(project, prior)
+        if 'native_harness' not in _allowed_actions(program, project, prior['state'], step, prior['contract']):
+            raise ContractError('native work is outside this phase scope')
+        _qualification_tasks(program, project, prior['contract'], step, [task])
+        receipts = program._snapshot(project, controller.status(context['project_id']))
+        proposal = {'kind': 'research-loop-proposal', 'schema_version': 1,
+            'goal_id': prior['state']['goal_id'], 'status': 'continue',
+            'summary': 'Worker-local native request; no scientific acceptance implied',
+            'decision_ref': request['decision_ref'], 'coverage_ref': request['coverage_ref'],
+            'tasks': [task], 'cancel_pending_task_ids': [],
+            'consumed_run_ids': [r['attempt_id'] for r in receipts], 'wait_seconds': 0}
+        tasks, coverage = program._proposal(prior, project, proposal, receipts)
+        item = controller.register_phase_native(context, request['request_id'], request_digest,
+                                                tasks[0], request['decision_ref'], request['coverage_ref'])
+    if item['state'] == 'pending':
+        result = dispatch.native_worker().run_once(context['project_id'], context['owner'] + '.native',
+                                                  adapter='native', task_ids=[item['task_id']])
+        item = result or controller.get_task(context['project_id'], item['task_id'])
+    # Observation/collection of an unknown job uses the normal original-identity
+    # recovery path. This API never launches a second run for the same request.
+    elif item['state'] == 'reconcile_required':
+        dispatch.reconcile_native()
+        item = controller.get_task(context['project_id'], item['task_id'])
+    receipts = program._snapshot(project, controller.status(context['project_id']))
+    return {'status': item['state'], 'task_id': item['task_id'], 'attempt': item['attempt'],
+            'receipt_refs': [r['receipt_ref'] for r in receipts if r['task_id'] == item['task_id']],
+            'outputs': item['outputs'], 'scientific_acceptance': 'pending phase review'}
+
+
+def local_prior(program, prior):
+    """Extend worker-local evidence without turning it into scientific acceptance."""
+    from .models import json_data
+    if not enabled(prior['contract']):
+        return prior
+    with program.controller._transaction() as db:
+        row = latest_record(db, prior['project_id'], prior['state'])
+    if row is None:
+        return prior
+    effective = json_data(prior)
+    effective['state']['accepted_decision_ref'] = json.loads(row['decision_ref'])
+    effective['state']['coverage_ref'] = json.loads(row['coverage_ref'])
+    return effective
+
+
+def latest_record(db, project_id, state):
+    """Worker-local checkpoints survive transport/reviewer retries of this phase."""
+    selected = state.get('sequence', {})
+    keys = ('flow_profile', 'catalog_sha256', 'cycle', 'epoch', 'step_id')
+    rows = db.execute('SELECT n.*,t.contract AS parent_contract FROM phase_native_requests n JOIN runs r ON r.run_id=n.parent_run_id JOIN tasks t ON t.project_id=r.project_id AND t.task_id=r.task_id WHERE n.project_id=? ORDER BY n.rowid DESC', (project_id,)).fetchall()
+    for row in rows:
+        bound = json.loads(row['parent_contract'])['parameters'].get('sequence_binding', {})
+        if all(bound.get(k) == selected.get(k) for k in keys):
+            return row
+    return None
