+"""Metadata compatibility regressions; synthetic fixtures, not scientific scores."""
+import copy,json,unittest
+import test_native_stages as base
+from fixtures import write,C
+import native_stages as NS
+import _native_eval as N
+
+class ExportMetadataTests(unittest.TestCase):
+    setUp=base.NativeStageTests.setUp
+    make=base.NativeStageTests.make
+    native=base.NativeStageTests.native
+    stage_task=base.NativeStageTests.stage_task
+    def setup_pair(self):
+        self.stage_task(export=True)
+        self.old=json.loads((self.f.root/self.native_plan['protocol_ref']['path']).read_text())
+        c=self.old['native_eval_contract'];full=NS.read(self.f.root,c['sample_manifest_ref'])
+        full['denominator_rule']='sample_count'
+        self.full=copy.deepcopy(full)
+        c['sample_manifest_ref']=write(self.f.root,'cd/legacy-samples.json',{k:full[k] for k in ('sample_ids','predictions_per_sample')})
+        c['selection']=None;c['contrasts']['baseline']='legacy-alias'
+        self.old['protocol_digest']=C.protocol_hash(self.old);self.gref=write(self.f.root,'cd/old-export.json',self.old)
+        stage=NS.read(self.f.root,self.native_plan['provenance']['native_stage_ref']);stage['protocol_ref']=self.gref
+        self.sref=write(self.f.root,'cd/old-export-stage.json',stage)
+        self.final=copy.deepcopy(self.old);self.final.update(native_stage_program_ref=self.gref,native_stage_exports=[{'native_stage_ref':self.sref,'execution_bindings':stage['execution_bindings']}])
+        f=self.final['native_eval_contract'];f['sample_manifest_ref']=write(self.f.root,'cd/completed-samples.json',full)
+        f['contrasts']['baseline']=c['arm_requirements']['baseline']['name']
+    def match(self):
+        self.final['protocol_digest']=C.protocol_hash(self.final)
+        ref=write(self.f.root,'cd/final-scored.json',self.final)
+        return NS.matches_scored_protocol(self.f.root,self.gref,ref,self.sref)
+    def test_null_selection_uses_full_manifest(self):
+        self.assertEqual(N.sample_manifest_ref({'selection':None,'sample_manifest_ref':'full'}),'full')
+    def test_missing_metadata_and_stale_contrast_alias_are_compatible(self):
+        self.setup_pair();self.assertTrue(self.match())
+        self.assertEqual(N._samples(self.f.root,self.final['native_eval_contract']),self.full)
+    def test_reordered_or_replaced_ids_and_multiplicity_rejected(self):
+        for key,value in [('sample_ids',['different']),('sample_ids','reverse'),('predictions_per_sample',99),('denominator',999)]:
+            with self.subTest(key=key,value=value):
+                self.setup_pair();m=copy.deepcopy(self.full);m[key]=list(reversed(self.full['sample_ids'])) if value=='reverse' else value
+                self.final['native_eval_contract']['sample_manifest_ref']=write(self.f.root,'cd/changed-samples.json',m)
+                self.assertFalse(self.match())
+    def test_scientific_contract_changes_rejected(self):
+        for key in ('labels_or_tests_ref','sampling','budget','metrics','prediction_format','seed_policy'):
+            with self.subTest(key=key):
+                self.setup_pair()
+                if key=='seed_policy':self.final[key]={'seeds':[999]}
+                else:self.final['native_eval_contract'][key]={'changed':True}
+                self.assertFalse(self.match())
+    def test_arm_implementation_or_name_replacement_rejected(self):
+        for key,value in [('name','replacement'),('revision','other'),('implementation_refs',[])]:
+            with self.subTest(key=key):
+                self.setup_pair();self.final['native_eval_contract']['arm_requirements']['baseline'][key]=value
+                self.assertFalse(self.match())
+    def test_arbitrary_alias_and_selection_rejected(self):
+        self.setup_pair();self.final['native_eval_contract']['contrasts']['baseline']='arbitrary';self.assertFalse(self.match())
+        self.setup_pair();self.final['native_eval_contract']['selection']={'rule':'quality'};self.assertFalse(self.match())
+    def test_existing_conflicting_metadata_cannot_be_overwritten(self):
+        self.setup_pair();c=self.old['native_eval_contract'];m=NS.read(self.f.root,c['sample_manifest_ref']);m['denominator']=99
+        c['sample_manifest_ref']=write(self.f.root,'cd/conflict.json',m);self.old['protocol_digest']=C.protocol_hash(self.old)
+        self.gref=write(self.f.root,'cd/conflicting-export.json',self.old);self.final['native_stage_program_ref']=self.gref
+        stage=NS.read(self.f.root,self.sref);stage['protocol_ref']=self.gref;self.sref=write(self.f.root,'cd/conflicting-stage.json',stage)
+        self.final['native_stage_exports']=[{'native_stage_ref':self.sref,'execution_bindings':stage['execution_bindings']}]
+        self.assertFalse(self.match())
+    def test_missing_export_binding_rejected(self):
+        self.setup_pair();self.final['native_stage_exports']=[];self.assertFalse(self.match())
+
+    def test_missing_denominator_needs_explicit_sample_count_unit(self):
