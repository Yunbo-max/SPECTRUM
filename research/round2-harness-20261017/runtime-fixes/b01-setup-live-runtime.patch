+"""Owner-adopted B01 configuration criteria, never evaluator qualification."""
+from __future__ import annotations
+
+from .artifacts import verify_ref
+from .models import ContractError, fields, text, validate_ref
+
+REQUIREMENTS = [
+    {'id': 'task_endpoint', 'description': 'Fix task input/output, population, evaluation unit, endpoint, aggregation and split; preserve existing scientific limitations.'},
+    {'id': 'evaluation_identity', 'description': 'Verify the pinned upstream dataset and selected evaluator provenance/version, effective configuration, and successful real import/startup receipt on the authorized target. Label community/custom implementations accurately. Configuration readiness does not require historical author predictions, live scorer replay or baseline qualification.'},
+    {'id': 'measurement_fit', 'description': 'Explain which endpoint the configured metric measures and retain proxy limitations, unresolved scoring/qualification gaps and empirical obligations for their actual execution stages.'},
+]
+INSTRUCTIONS = """B01 uses the owner-adopted configuration_only criteria in b01_setup.
+Use b01_setup.requirements for this step's three existing requirement IDs. Read its
+pinned report and startup evidence. Configure the selected upstream evaluator and
+record its actual provenance; official is not a synonym for available or popular.
+A successful import/startup proves configuration readiness only. It is not scorer
+qualification or a scientific score. Preserve all pending scoring/baseline and
+historical evidence gaps for B03 and actual scoring; these are not B01 acceptance
+blockers. Do not repeat historical author-output searches or demand live replay
+for this setup-only step. Native execution and treatment work are not allowed in
+this mode. For tasks=[] retain the exact accepted decision reference; do not create
+an unrelated inquiry decision. Every normal evidence/coverage and independent
+review requirement still applies. Cite b01_setup.report_ref in evaluation_identity
+both in worker findings and independent review. Never auto-accept a failed or
+unobserved startup, missing configuration, changed target or false provenance.
+"""
+
+
+def _refs(root, values):
+    if not isinstance(values, list) or not values:
+        raise ContractError('B01 setup needs nonempty evidence references')
+    for value in values:
+        path = verify_ref(root, validate_ref(value))
+        if not path.stat().st_size:
+            raise ContractError('B01 setup evidence cannot be empty')
+
+
+def validate_policy(project, contract, *, historical=False):
+    config = contract.get('sequence', {})
+    if 'b01_setup_ref' not in config:
+        return None
+    from .program import read_json
+    reference = validate_ref(config['b01_setup_ref'])
+    root = project['root']
+    policy = read_json(root, reference)
+    fields(policy, {'kind', 'schema_version', 'project_id', 'goal_id', 'step_id',
+                    'instruction_ref', 'target_ref', 'report_ref'})
+    if (policy['kind'] != 'research-b01-setup-policy' or type(policy['schema_version']) is not int
+            or policy['schema_version'] != 1 or policy['project_id'] != project['project_id']
+            or policy['goal_id'] != contract['goal_id'] or policy['step_id'] != 'B01'
+            or (not historical and (contract.get('native_target_ref') is None
+                or policy['target_ref'] != contract['native_target_ref']))):
+        raise ContractError('B01 setup policy must bind the current goal and authorized target')
+    _refs(root, [policy['instruction_ref'], policy['target_ref'], policy['report_ref']])
+    report = read_json(root, policy['report_ref'])
+    fields(report, {'kind', 'schema_version', 'project_id', 'goal_id', 'target_ref',
+                    'dataset', 'executor', 'environment', 'startup', 'runtime_gaps', 'scoring_status'})
+    if (report['kind'] != 'research-b01-setup-report' or type(report['schema_version']) is not int
+            or report['schema_version'] != 1 or report['project_id'] != policy['project_id']
+            or report['goal_id'] != policy['goal_id'] or report['target_ref'] != policy['target_ref']
+            or report['scoring_status'] not in ('pending', 'not_requested')):
+        raise ContractError('B01 report must bind setup only, never scored/qualified results')
+    dataset = report['dataset']
+    fields(dataset, {'source', 'revision', 'configuration', 'split', 'evidence_refs'})
+    for key in ('source', 'revision', 'configuration', 'split'):
+        text(dataset[key], 'dataset ' + key)
+    _refs(root, dataset['evidence_refs'])
+    executor = report['executor']
+    fields(executor, {'source', 'version', 'provenance', 'official', 'evidence_refs'}, {'official_source_ref'})
+    for key in ('source', 'version'):
+        text(executor[key], 'executor ' + key)
+    if (executor['provenance'] not in ('benchmark_author', 'upstream_project', 'community', 'project_custom')
+            or type(executor['official']) is not bool):
+        raise ContractError('B01 executor provenance must identify its actual source')
+    _refs(root, executor['evidence_refs'])
+    if executor['official']:
+        if executor['provenance'] != 'benchmark_author' or 'official_source_ref' not in executor:
+            raise ContractError('official evaluator needs benchmark-author provenance and explicit source evidence')
+    if 'official_source_ref' in executor:
+        _refs(root, [executor['official_source_ref']])
+    environment, startup = report['environment'], report['startup']
+    fields(environment, {'interpreter', 'configuration_ref'})
+    fields(startup, {'command', 'exit_code', 'receipt_ref'})
+    text(environment['interpreter'], 'actual project interpreter')
+    text(startup['command'], 'actual startup command')
+    _refs(root, [environment['configuration_ref'], startup['receipt_ref']])
+    receipt = read_json(root, startup['receipt_ref'])
+    if (not isinstance(receipt, dict) or type(startup['exit_code']) is not int or startup['exit_code'] != 0
+            or type(receipt.get('exit_code')) is not int or receipt['exit_code'] != 0
+            or receipt.get('target_ref') != policy['target_ref']
+            or receipt.get('command') != startup['command']
+            or receipt.get('interpreter') != environment['interpreter']):
+        raise ContractError('B01 needs a successful startup receipt bound to this target, command and interpreter')
+    _refs(root, [receipt.get('output_ref')])
+    if not isinstance(report['runtime_gaps'], list):
+        raise ContractError('B01 runtime gaps must be an explicit list')
+    for gap in report['runtime_gaps']:
+        text(gap, 'pending runtime gap')
+    return {'reference': reference, **policy, 'report': report}
+
+
+def context(project, contract, step):
+    if step['id'] != 'B01':
+        return None
+    policy = validate_policy(project, contract)
+    if policy is None:
+        return None
+    return {'mode': 'configuration_only', 'policy_ref': policy['reference'],
+            'instruction_ref': policy['instruction_ref'], 'target_ref': policy['target_ref'],
+            'report_ref': policy['report_ref'], 'requirements': REQUIREMENTS,
+            'instructions': INSTRUCTIONS}
+
+
+def require_report_evidence(project, contract, step, rows):
+    ctx = context(project, contract, step)
+    if ctx is not None:
+        identity = next((row for row in rows if row['requirement_id'] == 'evaluation_identity'), None)
+        if identity is None or ctx['report_ref'] not in identity['evidence_refs']:
+            raise ContractError('B01 configuration identity must cite the actual adopted setup report')
+
+
+def retained_decision(project, prior, proposal, fresh):
+    """Return only already accepted pins; all other proposals use existing rules."""
+    state = prior['state']
+    if (state.get('sequence', {}).get('step_id') != 'B01'
+            or 'b01_setup_ref' not in prior['contract'].get('sequence', {})
+            or proposal.get('tasks') != [] or proposal.get('status') != 'wait'
+            or any(item['action'] == 'native_harness' for item in fresh)):
+        return None
+    validate_policy(project, prior['contract'])
+    accepted = state.get('accepted_decision_ref')
+    if accepted is None or proposal.get('decision_ref') != accepted:
+        return None
+    verify_ref(project['root'], accepted)
+    return [accepted]
