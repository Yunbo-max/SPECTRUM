+            project = observation()
+            project['torch'][field] = value
+            self.assertEqual(self.report(project)[0]['status'], 'needs_measurement')
+
+    def test_unknown_requirements_and_memory_stay_unknown(self):
+        for key in ('precision', 'min_free_vram_mib'):
